+  const float target_opacity = centering_indicator_active ? 1.0f : 0.0f;
+  const float ramp = centering_indicator_active ? CENTERING_INDICATOR_RAMP_UP_S : CENTERING_INDICATOR_RAMP_DOWN_S;
+  if (ramp > 1e-3f && frame_dt > 0.0f) {
