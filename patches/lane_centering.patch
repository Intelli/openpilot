+
+    QString secondary_text;
+    if (capped_shift_cm >= 1.0f) {
+      secondary_text = QStringLiteral("Offset ≈ %1 cm").arg(QString::number(capped_shift_cm, 'f', capped_shift_cm < 10.0f ? 1 : 0));
+    } else {
+      secondary_text = QStringLiteral("Offset < 1 cm");
