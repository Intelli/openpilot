+    elif curvature_delta < -CENTERING_MAX_CURVATURE_DELTA:
+      curvature_delta = -CENTERING_MAX_CURVATURE_DELTA
+
+    if abs(curvature_delta) < CENTERING_MIN_DISPLAY_DELTA:
+      return 0.0
+
+    return curvature_delta
