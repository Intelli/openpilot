@@ -0,0 +1,145 @@
+import math
+from dataclasses import replace
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+from openpilot.selfdrive.controls.lib.ev9_path_planner import PathPlanningDecision
+from openpilot.selfdrive.controls.lib.ev9_trajectory import ExecutionState, TrajectoryPlan
+from openpilot.selfdrive.controls.lib.ev9_trajectory_io import PoseHistory, decode_snapshot, plan_message
+from openpilot.tools.ev9_trajectory.fixtures import PARAMS, VM
+
+
+def state(time=10., **kwargs):
+  return replace(ExecutionState(time, (0., 0., 0.), 2., 0., 0., 0., .3, generation=2), **kwargs)
+
+
+def snapshot(**kwargs):
+  values = dict(sourceMonoTime=10_000_000_000, x=1., y=2., yaw=.1, speed=2., wheelAngleDeg=30.,
+                commandCurvature=.01, delay=.3, generation=2, enabled=True, manual=False, laneChange=False,
+                drive=True, healthy=True, active=False, steerRatio=VM.sR, tireStiffnessFront=VM.cF, tireStiffnessRear=VM.cR,
+                angleOffsetDeg=3., roll=.005)
+  values['curvature'] = VM.calc_curvature(math.radians(27), 2., .005)
+  return SimpleNamespace(**(values | kwargs))
+
+
+def decode(message, **kwargs):
+  return decode_snapshot(message, SimpleNamespace(**PARAMS), **(dict(now=10., message_time=10., valid=True) | kwargs))
+
+
+def test_atomic_vm_and_signed_state_snapshot():
+  result = decode(snapshot())
+  assert result is not None
+  execution, vm, roll, offset = result
+  assert execution.pose == (1., 2., .1) and execution.generation == 2
