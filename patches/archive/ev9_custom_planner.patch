+"""Native fixed-size MPC tests; host generation is confined to pytest's temp dir."""
+import math
+
+import numpy as np
+import pytest
+
+from openpilot.selfdrive.controls.lib.ev9_path_mpc import Ev9PathMpc, N
+from openpilot.tools.ev9_trajectory.fixtures import fixture, VM
+from openpilot.tools.ev9_trajectory.optimizer import body_inside_corridor, DEFAULT_FOOTPRINT
+
+
+@pytest.fixture(scope='module')
+def mpc(tmp_path_factory):
+  from openpilot.selfdrive.controls.lib.ev9_path_mpc_lib.generate import build
+  solver = Ev9PathMpc(build(tmp_path_factory.mktemp('ev9-path-mpc')))
+  yield solver
+  solver.close()
+
+
+def request(case, **kwargs):
+  cap = abs(VM.calc_curvature(math.radians(140), case.speed, 0))
+  sign = np.sign(case.yaw[-1])
+  return dict(reference_xy=case.reference, reference_yaw=case.yaw, initial_pose=case.initial_pose, initial_curvature=0., speeds=case.speed,
+              curvature_limit=cap if sign > 0 else 0., min_curvature=0. if sign > 0 else -cap,
+              curvature_rate_time=abs(VM.calc_curvature(math.radians(100), case.speed, 0)),
+              lateral_lower=-1., lateral_upper=1., heading_deviation=.15) | kwargs
+
+
+@pytest.mark.parametrize('version', [2, 3, 4])
+def test_legacy_library_cannot_supply_incompatible_output(monkeypatch, version):
+  from types import SimpleNamespace
+  import openpilot.selfdrive.controls.lib.ev9_path_mpc as module
+  legacy = SimpleNamespace(ev9_path_abi_version=lambda: version)
+  monkeypatch.setattr(module, 'CDLL', lambda _: legacy)
+  with pytest.raises(RuntimeError, match='ABI mismatch'):
+    module.Ev9PathMpc('legacy-library')
+
+
+@pytest.mark.parametrize('demand', [100, 145, 160])
+@pytest.mark.parametrize('sign', [-1, 1])
+@pytest.mark.parametrize('heading', [-2, 0, 2])
+def test_complete_turn_geometry(mpc, demand, sign, heading):
+  case = fixture(demand, 7., sign, heading)
+  args = request(case)
+  result = mpc.solve(**args)
+  # This bounded search cannot find every wider-turn solution. Preserve
+  # these known search failures instead of accepting countersteering geometry.
