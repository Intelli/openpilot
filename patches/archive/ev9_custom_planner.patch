+import math
+from types import SimpleNamespace
+
+import numpy as np
+
+from opendbc.car.vehicle_model import VehicleModel
+from openpilot.tools.ev9_trajectory.solve import example_problem, solve_problem
+
+
+def test_default_example_uses_full_140_degree_authority():
+  problem = example_problem()
+  assert problem['vehicle_variants'] == []
+  result, angles = solve_problem(problem)
+  assert result.feasible
+  assert 139.9 <= max(abs(angles)) <= 140.001
+  assert abs(math.degrees(result.yaw[-1]) - 90) < 0.1
+
+
+def test_vehicle_uncertainty_constrains_the_path_for_each_model():
+  problem = example_problem(160., 7., 2., ratio_uncertainty=0.1)
+  result, _ = solve_problem(problem)
+  assert result.feasible
+  assert abs(math.degrees(result.yaw[-1]) - 90) < 0.1
+  for parameters in [problem['vehicle'], *problem['vehicle_variants']]:
+    vm = VehicleModel(SimpleNamespace(**parameters))
+    angles = np.degrees([vm.get_steer_from_curvature(k, problem['speed'], 0.) for k in result.curvature])
+    assert max(abs(angles)) <= 140.001
+    assert max(abs(np.diff(angles) / np.diff(result.distance))) * problem['speed'] <= 100.001
+
+
+def test_roll_and_angle_offset_are_applied_to_geometric_bounds():
+  problem = example_problem(145., 7., ratio_uncertainty=0.)
+  problem.update(roll=0.02, angle_offset_deg=2.)
+  result, angles = solve_problem(problem)
+  assert result.feasible
+  assert max(abs(angles)) <= 140.001
+  assert abs(angles[0]) < 1e-5
+  assert abs(result.curvature[-1]) < 1e-6
