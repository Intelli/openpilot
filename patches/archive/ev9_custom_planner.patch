+"""Retained space must come from an unexpired, capture-aligned observation."""
+import numpy as np
+
+from openpilot.selfdrive.controls.lib.ev9_path_history import RearBoundaryHistory
+
+
+def bounds(start=2., end=30., shift=0.):
+  x = np.linspace(start, end, 29)
+  return np.column_stack((x, np.full(len(x), 3.5 + shift))), np.column_stack((x, np.full(len(x), -3.5 + shift)))
+
+
+def extend(history, *, stamp=10., now=None, pose=(0., 0., 0.), generation=1, source='inner_lanes', shift=0., erosion=(.1, .2)):
+  left, right = bounds(shift=shift)
+  return history.extend(left, right, np.array(erosion), pose=pose, stamp=stamp, now=stamp if now is None else now,
+                        generation=generation, source=source)
+
+
+def test_only_observed_rear_points_added_and_never_restamped():
+  history = RearBoundaryHistory()
+  extend(history)
+  left, right, margin = extend(history, stamp=12., pose=(4., 0., 0.), erosion=(.05, .05))
+  for line, current, times in zip((left, right), bounds(), history.point_times, strict=True):
+    np.testing.assert_array_equal(line[line[:, 0] >= 2.], current)
+    assert line[0, 0] == -2. and line[-1, 0] == 30.
+    np.testing.assert_array_equal(times[line[:, 0] < 2.], 10.)
+    np.testing.assert_array_equal(times[line[:, 0] >= 2.], 12.)
+  np.testing.assert_allclose(margin, (.1, .2))
+  # At t18.1 the t10 observation expires, despite its use at t12.
+  left, _, _ = extend(history, stamp=18.1, pose=(6., 0., 0.))
+  assert left[0, 0] == 0.  # Only the t12 raw observation remains.
+  assert np.min(history.point_times[0]) == 12.
+  left, _, _ = extend(history, stamp=27., pose=(8., 0., 0.))
+  assert left[0, 0] == 2.
+
+
+def test_generation_source_time_and_overlap_reset():
+  for override in (dict(generation=2), dict(source='road_edges_geometry_only'), dict(stamp=9.), dict(shift=.3)):
+    history = RearBoundaryHistory()
+    extend(history)
+    left, _, _ = extend(history, **(dict(stamp=12., pose=(4., 0., 0.)) | override))
+    assert left[0, 0] == 2.
+    assert len(history.records) == 1
+
+
+def test_nonmonotonic_transformed_history_rejected():
+  history = RearBoundaryHistory()
+  extend(history)
+  left, _, _ = extend(history, stamp=12., pose=(4., 0., np.pi))
+  assert left[0, 0] == 2.
+  assert len(history.records) == 1
+
+
+def test_pose_transform_rotation_and_offset():
+  points = np.array([[2., 3.], [5., 6.]])
+  source, target = (10., 20., .4), (12., 18., -.3)
+  transformed = RearBoundaryHistory.transform(points, source, target)
+  np.testing.assert_allclose(RearBoundaryHistory.transform(transformed, target, source), points, atol=1e-12)
+
+
+def test_small_join_disagreement_carries_conservative_margin():
+  history = RearBoundaryHistory()
+  extend(history)
+  left, _, margin = extend(history, stamp=12., pose=(4., 0., 0.), shift=.1)
+  assert left[0, 0] < 2.
+  np.testing.assert_allclose(margin, (.2, .3))
+
+
+def test_newest_adequate_observation_preserves_useful_lease():
+  history = RearBoundaryHistory()
+  for stamp, x in ((10., 0.), (14., 8.), (16., 12.)):
+    extend(history, stamp=stamp, pose=(x, 0., 0.))
+  left, right = bounds()
+  history.extend(left, right, np.array([.1, .2]), pose=(16., 0., 0.), stamp=17.99, now=17.99,
+                 generation=1, source='inner_lanes', rear_extent=2.1)
+  # t16 reaches only x=-2, too short; t14 reaches x=-6 and is adequate.
+  # t10 would make the plan expire at18 but must not be selected.
+  assert min(np.min(times) for times in history.point_times) == 14.
+  assert min(np.min(times) + history.max_age for times in history.point_times) > 17.99 + .25
+
+
+def test_curved_history_survives_rotating_camera_without_extending_exit():
+  for sign in (-1, 1):
+    history = RearBoundaryHistory()
+    theta = np.linspace(0., 1.8, 91)
+    center = np.column_stack((12*np.sin(theta), sign*12*(1-np.cos(theta))))
+    normal = np.column_stack((-np.sin(sign*theta), np.cos(sign*theta)))
+    left, right = center+3.5*normal, center-3.5*normal
+    history.extend(left, right, np.array([.1, .1]), pose=(0., 0., 0.), stamp=10., now=10., generation=1, source='inner_lanes')
+    pose = (*center[25], sign*theta[25])
+    current = tuple(history.transform(line[35:], (0., 0., 0.), pose) for line in (left, right))
+    result = history.extend(*current, np.array([.1, .1]), pose=pose, stamp=11., now=11., generation=1, source='inner_lanes')
+    for line, new, original, times in zip(result[:2], current, (left, right), history.point_times, strict=True):
+      assert len(line) > len(new)
+      np.testing.assert_allclose(line[-len(new):], new)
+      np.testing.assert_allclose(line[:-len(new)], history.transform(original[:35], (0., 0., 0.), pose), atol=1e-12)
+      assert np.all(times[:-len(new)] == 10.) and np.all(times[-len(new):] == 11.)
