+import pytest
+
+from openpilot.tools.ev9_trajectory.audit_routes import path_coverage, summarize
+
+
+def test_confident_prefix_stops_at_first_bad_point():
+  assert path_coverage(dict(x=[0, 1, 2, 3], y=[0] * 4, yStd=[0.1, 0.1, 0.4, 0.1])) == (3.0, 1.0)
+  assert path_coverage(dict(x=[0, 1], y=[0, 0], yStd=[0.4, 0.1])) == (1.0, 0.0)
+
+
+@pytest.mark.parametrize('position', [{}, dict(x=[0, 1], y=[0, 0]), dict(x=[0, 1], y=[0, 0], yStd=[0, float('nan')]), dict(x=[0, 0], y=[0, 0], yStd=[0, 0])])
+def test_invalid_path_is_rejected(position):
+  assert path_coverage(position) is None
+
+
+def sample(mono, service, valid=True):
+  values = dict(
+    carState=dict(vEgo=2, steeringAngleDeg=100, steeringPressed=False),
+    carControl=dict(latActive=True),
+    modelV2=dict(position=dict(x=[0, 1], y=[0, 0], yStd=[0.1, 0.1]), laneLineProbs=[0, 0.8, 0.7, 0], roadEdgeStds=[0.2, 0.3]),
+  )
+  return mono, service, valid, values[service]
+
+
+def test_future_state_never_fills_past_model_even_when_input_is_unsorted():
+  result = summarize([sample(200, 'carState'), sample(100, 'modelV2'), sample(50, 'carControl'), sample(300, 'modelV2')])
+  assert result['counts']['missing_preceding_state_or_control'] == 1
+  assert result['counts']['sharp_frames'] == 1
+  assert result['sharp_confident_prefix_arc_m']['median'] == 1
+
+
+@pytest.mark.parametrize('valid,mono', [(False, 10), (True, 300_000_001)])
+def test_invalid_or_stale_state_does_not_qualify(valid, mono):
+  result = summarize([sample(0, 'carState', valid), sample(0, 'carControl'), sample(mono, 'modelV2')])
+  assert result['counts'].get('sharp_frames', 0) == 0
