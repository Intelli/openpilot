index 0000000000000000000000000000000000000000..2c4603a0e1393d518047f1b4ee228a6423ee3b84
--- /dev/null
+++ b/tools/ev9_trajectory/replay_live.py
@@ -0,0 +1,134 @@
+"""Causal recorded-input assessment of corridor geometry, NOT Controls execution replay."""
+
+import argparse
+from collections import Counter
+import hashlib
+import json
+import math
+from pathlib import Path
+
+from openpilot.tools.ev9_trajectory.corridor import model_lane_corridor
+
+SERVICES = ('carState', 'carControl', 'carOutput', 'liveParameters', 'liveDelay')
+MAX_AGE = dict(carState=0.25, carControl=0.25, carOutput=0.25, liveParameters=1.0, liveDelay=1.0)
+
+
+def digest(data):
+  return hashlib.sha256(json.dumps(data, sort_keys=True, default=str).encode()).hexdigest()
+
+
+def summarize(events):
+  latest, counts, reasons, sharp_reasons = {}, Counter(), Counter(), Counter()
+  availability = {s: Counter() for s in SERVICES}
+  metadata = dict(build_revisions=[], car_params_sha256=[], init_params_sha256=[], effective_toggle_sha256=[])
+  for mono, service, valid, data in sorted(events, key=lambda e: e[0]):
+    if service in SERVICES:
+      latest[service] = (mono, valid, data)
+      continue
+    if service == 'initData':
+      revision = str(data.get('gitCommit', ''))
+      if revision and revision not in metadata['build_revisions']:
+        metadata['build_revisions'].append(revision)
+      value = digest(data.get('params', {}))
+      if value not in metadata['init_params_sha256']:
+        metadata['init_params_sha256'].append(value)
+      continue
+    if service in ('carParams', 'starpilotPlan'):
+      value = digest(data if service == 'carParams' else data.get('starpilotToggles', ''))
+      key = 'car_params_sha256' if service == 'carParams' else 'effective_toggle_sha256'
+      if value not in metadata[key]:
+        metadata[key].append(value)
+      continue
+    if service != 'modelV2':
+      continue
+    counts['model_frames'] += 1
+    counts['invalid_model_frames'] += not valid
+    fresh = {}
+    for name in SERVICES:
+      record = latest.get(name)
+      state = 'missing' if record is None else 'invalid' if not record[1] else 'stale' if not 0 <= (mono - record[0]) / 1e9 <= MAX_AGE[name] else 'fresh'
+      availability[name][state] += 1
+      if state == 'fresh':
+        fresh[name] = record[2]
+    result = model_lane_corridor(data, model_time=mono / 1e9, now=mono / 1e9, model_valid=valid)
+    reasons[result.reason] += 1
+    counts['geometry_available'] += result.available
+    counts['execution_authorized'] += result.execution_authorized
+    cs, cc = fresh.get('carState', {}), fresh.get('carControl', {})
+    try:
+      speed, wheel = float(cs['vEgo']), float(cs['steeringAngleDeg'])
+      usable = math.isfinite(speed) and math.isfinite(wheel) and 'carControl' in fresh
+    except (KeyError, TypeError, ValueError):
+      usable = False
+    if usable:
+      counts['causal_state_control_frames'] += 1
+      low = 0.5 <= speed <= 7
+      manual = bool(cs.get('steeringPressed', False))
+      autonomous = bool(cc.get('latActive', False)) and not manual
+      counts['low_speed_frames'] += low
+      counts['low_speed_manual_frames'] += low and manual
+      counts['low_speed_autonomous_frames'] += low and autonomous
+      if low and abs(wheel) >= 90:
+        counts['sharp_frames'] += 1
+        counts['sharp_manual_frames'] += manual
+        counts['sharp_autonomous_frames'] += autonomous
+        sharp_reasons[result.reason] += 1
+    output = fresh.get('carOutput', {}).get('actuatorsOutput', {})
+    counts['fresh_filter_field_present'] += 'filteredSteeringAngleDeg' in output
+    counts['fresh_filter_state_valid'] += bool(output.get('filteredSteeringAngleValid', False))
+    counts['fresh_prior_curvature_present'] += 'curvature' in cc.get('actuators', {})
+    counts['all_execution_services_fresh'] += len(fresh) == len(SERVICES)
+  return dict(
+    counts=dict(counts),
+    geometry_reasons=dict(reasons),
+    sharp_geometry_reasons=dict(sharp_reasons),
+    preceding_input_availability={k: dict(v) for k, v in availability.items()},
+    metadata=metadata,
+  )
+
+
+def read_events(paths):
+  import zstandard
+  from cereal import log
+
+  events, seen = [], set()
+  selected = set(SERVICES) | {'modelV2', 'initData', 'carParams', 'starpilotPlan'}
+  for path in paths:
+    with path.open('rb') as source, zstandard.ZstdDecompressor().stream_reader(source) as stream:
+      raw = stream.read()
+    for event in log.Event.read_multiple_bytes(raw):
+      service = event.which()
+      key = (int(event.logMonoTime), service)
+      if service not in selected or key in seen:
+        continue
+      seen.add(key)
+      events.append((key[0], service, bool(event.valid), getattr(event, service).to_dict()))
+  return events
+
+
+def main():
+  parser = argparse.ArgumentParser(description=__doc__)
+  parser.add_argument(
+    '--route', nargs='+', type=Path, action='append', required=True, help='One monotonic-clock route per occurrence, local full rlog.zst files'
+  )
+  parser.add_argument('--output', type=Path, required=True)
+  args = parser.parse_args()
+  reports = [summarize(read_events(paths)) for paths in args.route]
+  result = dict(
+    scope='Recorded model-time geometry assessment only; no Controls/controller execution, modified commands, or closed-loop simulation.',
+    limitations=[
+      'Only preceding recorded inputs joined; equal timestamps preserve input order',
+      'Freshness evaluated at model publication, not later live-control adoption',
+      'Parameter hashes establish recorded identity only, not decoded effective setting correctness',
+      'Model geometry never authorizes execution; no complete obstacle/traffic occupancy evidence',
+      'No synthetic off/shadow identity claim; these counts assess only the pure corridor adapter',
+    ],
+    max_preceding_age_s=MAX_AGE,
+    routes=reports,
+  )
+  args.output.write_text(json.dumps(result, indent=2) + '\n')
+  print(json.dumps([r['counts'] for r in reports], indent=2))
+
+
+if __name__ == '__main__':
+  main()
diff --git a/tools/ev9_trajectory/solve.py b/tools/ev9_trajectory/solve.py
new file mode 100644
index 0000000000000000000000000000000000000000..514faa11d46cb5f216f70e6b83b0544733405be7
--- /dev/null
+++ b/tools/ev9_trajectory/solve.py
@@ -0,0 +1,134 @@
+"""Solve a complete supplied corridor, or a synthetic EV9 turn, offline."""
+import argparse
+from dataclasses import asdict
+import json
+import math
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+
+from opendbc.car.vehicle_model import VehicleModel
+from openpilot.tools.ev9_trajectory.fixtures import PARAMS, fixture
+from openpilot.tools.ev9_trajectory.optimizer import VehicleFootprint, solve_trajectory
+
+EV9_STEERING_CAPABILITY_DEG = 140.0
+
+
+def example_problem(demand=160., width=7., heading=0., ratio_uncertainty=0.):
+  if not 0 <= ratio_uncertainty < 0.5 or not 0 < demand <= 360 or width <= 0:
+    raise ValueError('invalid synthetic scenario')
+  case = fixture(demand=demand, width=width, initial_heading_deg=heading)
+  return {
+    'reference': case.reference.tolist(), 'left': case.left.tolist(), 'right': case.right.tolist(),
+    'speed': case.speed, 'initial_pose': case.initial_pose.tolist(), 'initial_angle_deg': 0.,
+    'vehicle': PARAMS, 'roll': 0., 'angle_offset_deg': 0., 'max_angle_rate_deg_s': 100.,
+    'vehicle_variants': [{**PARAMS, 'steerRatio': PARAMS['steerRatio'] * factor}
+                         for factor in (1 - ratio_uncertainty, 1 + ratio_uncertainty)] if ratio_uncertainty else [],
+    'footprint': asdict(VehicleFootprint()), 'corridor_source': 'synthetic_complete_obstacle_free_corridor',
+  }
+
+
+def solve_problem(problem):
+  """Convert steering capability to geometric constraints, then solve the path.
+
+  max_angle_rate_deg_s is an explicit assumed achievable physical slew rate,
+  not an actuator setting. Speed is constant; this does not plan braking.
+  """
+  models = [VehicleModel(SimpleNamespace(**parameters)) for parameters in [problem['vehicle'], *problem.get('vehicle_variants', [])]]
+  vm = models[0]
+  speed, roll, offset = problem['speed'], problem.get('roll', 0.), problem.get('angle_offset_deg', 0.)
+  for model in models:
+    values = [speed, roll, offset, problem['initial_angle_deg'], problem['max_angle_rate_deg_s'],
+              model.sR, model.l, model.cF, model.cR, model.m]
+    if not np.isfinite(values).all() or min(speed, model.sR, model.l, model.cF, model.cR, model.m, problem['max_angle_rate_deg_s']) <= 0:
+      raise ValueError('invalid vehicle or planning state')
+  all_bounds = [sorted(model.calc_curvature(math.radians(angle - offset), speed, roll)
+                       for angle in (-EV9_STEERING_CAPABILITY_DEG, EV9_STEERING_CAPABILITY_DEG)) for model in models]
+  # Every supplied model retains 140° of authority. Intersect their feasible path
+  # curvatures; no runtime actuator request or vehicle limit is changed.
+  bounds = [max(bound[0] for bound in all_bounds), min(bound[1] for bound in all_bounds)]
+  initial_curvature = vm.calc_curvature(math.radians(problem['initial_angle_deg'] - offset), speed, roll)
+  max_rate = min(abs(model.curvature_factor(speed) / model.sR * math.radians(problem['max_angle_rate_deg_s'])) for model in models)
+  result = solve_trajectory(problem['reference'], problem['left'], problem['right'], speed, problem['initial_pose'],
+                            initial_curvature, bounds[1], max_rate, min_curvature=bounds[0],
+                            footprint=VehicleFootprint(**problem['footprint']))
+  angles = np.degrees([vm.get_steer_from_curvature(k, speed, roll) for k in result.curvature]) + offset
+  result.diagnostics['vehicle_models'] = len(models)
+  if result.feasible:
+    result.diagnostics['max_angle_across_models_deg'] = max(abs(math.degrees(model.get_steer_from_curvature(k, speed, roll)) + offset)
+                                                            for model in models for k in result.curvature)
+  return result, angles
+
+
+def plot_result(problem, result, angles, destination):
+  import matplotlib
+  matplotlib.use('Agg')
+  import matplotlib.pyplot as plt
+
+  reference, left, right = [np.asarray(problem[key]) for key in ('reference', 'left', 'right')]
+  vm = VehicleModel(SimpleNamespace(**problem['vehicle']))
+  reference_s = np.r_[0., np.cumsum(np.linalg.norm(np.diff(reference, axis=0), axis=1))]
+  reference_yaw = np.unwrap(np.arctan2(np.gradient(reference[:, 1], reference_s), np.gradient(reference[:, 0], reference_s)))
+  reference_k = np.gradient(reference_yaw, reference_s)
+  original_angles = np.degrees([vm.get_steer_from_curvature(k, problem['speed'], problem.get('roll', 0.)) for k in reference_k])
+  original_angles += problem.get('angle_offset_deg', 0.)
+  fig, axes = plt.subplots(1, 2, figsize=(12, 5), layout='constrained')
+  polygon = np.vstack((left, right[::-1]))
+  axes[0].fill(polygon[:, 0], polygon[:, 1], color='#edf1f5', label='Supplied corridor')
+  axes[0].plot(reference[:, 0], reference[:, 1], '--', color='#bd5a25', label='Original path')
+  axes[1].plot(reference_s, original_angles, '--', color='#bd5a25', label='Original path demand')
+  if result.feasible:
+    axes[0].plot(result.xy[:, 0], result.xy[:, 1], color='#147d70', label='Feasible trajectory')
+    axes[1].plot(result.distance, angles, color='#147d70', label='Planned demand (nominal vehicle)')
+    if problem.get('vehicle_variants'):
+      models = [VehicleModel(SimpleNamespace(**parameters)) for parameters in [problem['vehicle'], *problem['vehicle_variants']]]
+      model_angles = np.array([[math.degrees(model.get_steer_from_curvature(k, problem['speed'], problem.get('roll', 0.))) +
+                                problem.get('angle_offset_deg', 0.) for k in result.curvature] for model in models])
+      largest = model_angles[np.argmax(abs(model_angles), axis=0), np.arange(len(angles))]
+      axes[1].plot(result.distance, largest, ':', color='#278ab0', label='Highest demand across supplied models')
+  axes[0].set(aspect='equal', xlabel='Forward distance (m)', ylabel='Left distance (m)', title='Complete turn and exit')
+  axes[1].axhline(140, color='#5b6573', linewidth=1, label='140° planning capability')
+  axes[1].axhline(-140, color='#5b6573', linewidth=1)
+  all_angles = np.r_[original_angles, angles]
+  if min(all_angles) >= -1:
+    axes[1].set_ylim(-10, max(150, max(all_angles) + 15))
+  elif max(all_angles) <= 1:
+    axes[1].set_ylim(min(-150, min(all_angles) - 15), 10)
+  axes[1].set(xlabel='Distance along each path (m)', ylabel='Steering wheel angle (degrees)', title='Required steering along the path')
+  for ax in axes:
+    ax.legend(fontsize=8)
+    ax.grid(alpha=0.2)
+  fig.suptitle('Offline synthetic EV9 trajectory — geometry only, not an on-road result')
+  fig.savefig(destination, dpi=160)
+  plt.close(fig)
+
+
+def main():
+  parser = argparse.ArgumentParser(description=__doc__)
+  parser.add_argument('--input', type=Path, help='JSON problem with complete matched corridor cross-sections; otherwise use a synthetic turn')
+  parser.add_argument('--demand-angle', type=float, default=160., help='Synthetic original path peak steering demand in degrees')
+  parser.add_argument('--corridor-width', type=float, default=7., help='Synthetic corridor width in metres')
+  parser.add_argument('--initial-heading', type=float, default=0., help='Synthetic starting heading error in degrees')
+  parser.add_argument('--ratio-uncertainty', type=float, default=0., help='Optional steering-ratio stress-test variation; default uses full nominal authority')
+  parser.add_argument('--output', type=Path, required=True, help='Result JSON; keep private route data outside the repository')
+  parser.add_argument('--plot', type=Path, help='Optional comparison PNG')
+  args = parser.parse_args()
+  problem = (json.loads(args.input.read_text()) if args.input else
+             example_problem(args.demand_angle, args.corridor_width, args.initial_heading, args.ratio_uncertainty))
+  result, angles = solve_problem(problem)
+  output = asdict(result)
+  for key in ('xy', 'yaw', 'curvature', 'distance'):
+    output[key] = output[key].tolist()
+  output.update(steering_angle_deg=angles.tolist(), problem=problem, mode='offline_geometry_only',
+                steering_capability_deg=EV9_STEERING_CAPABILITY_DEG)
+  args.output.write_text(json.dumps(output, indent=2, allow_nan=False) + '\n')
+  if args.plot:
+    plot_result(problem, result, angles, args.plot)
+  print(json.dumps({'feasible': result.feasible, 'reason': result.reason, 'solve_time_s': round(result.solve_time, 3),
+                    'max_required_angle_deg': float(np.max(np.abs(angles))) if len(angles) else None,
+                    **result.diagnostics}, allow_nan=False))
+
+
+if __name__ == '__main__':
+  main()
