+def test_nonowning_modes_are_identical_to_baseline(monkeypatch, reason, direct):
+  baseline, candidate = make_controls(monkeypatch, direct), make_controls(monkeypatch, direct)
+  candidate.ev9_trajectory = DecisionAdapter(reason=reason)
+  for demand in [0.01] * 20 + [-0.02] * 30 + [0.0] * 20:
+    baseline.sm['modelV2'].action.desiredCurvature = candidate.sm['modelV2'].action.desiredCurvature = demand
+    original, original_log = baseline.state_control()
+    actual, actual_log = candidate.state_control()
+    assert actual.to_dict() == original.to_dict()
+    assert actual_log.to_dict() == original_log.to_dict()
+    assert candidate.turn_hold_curvature == baseline.turn_hold_curvature
+  assert len(candidate.ev9_trajectory.calls) == 70
