+"""Nominal synthetic benefit through real steering controllers; no driving permission.
+
+Both paths face the same 100 Hz body/exit checks and physical response. The
+reference policy is geometric feedback, not openpilot's learned driving policy.
+"""
+from dataclasses import replace
+import math
+
+import numpy as np
+import pytest
+
+from openpilot.selfdrive.controls.lib.ev9_path_mpc import Ev9PathMpc
+from openpilot.selfdrive.controls.lib.ev9_trajectory import ExecutionState, TrajectoryPlan
+from openpilot.tools.ev9_trajectory.execution import PlanningCorridor, validate_execution, validate_reference_execution
+from openpilot.tools.ev9_trajectory.fixtures import VM, fixture
+from openpilot.tools.ev9_trajectory.optimizer import VehicleFootprint, body_inside_corridor
+from openpilot.tools.ev9_trajectory.profile_execution import configuration
+
+
+@pytest.fixture(scope='module')
+def mpc(tmp_path_factory):
+  from openpilot.selfdrive.controls.lib.ev9_path_mpc_lib.generate import build
+  solver = Ev9PathMpc(build(tmp_path_factory.mktemp('ev9-execution-mpc')))
+  yield solver
+  solver.close()
+
+
+@pytest.mark.parametrize('direct', [False, True], ids=['stock', 'direct'])
+@pytest.mark.parametrize('sign', [-1, 1], ids=['right', 'left'])
+def test_native_path_improves_common_body_clearance(mpc, direct, sign):
+  # Longitudinal dimensions plus assumed 1.1 m half-width and 8 cm margin.
+  footprint = VehicleFootprint(3.975, 1.04, 1.1, .08)
+  case = fixture(144., 3.5, sign, 0)
+  limit = abs(VM.calc_curvature(math.radians(140), case.speed, 0))
+  rate = abs(VM.calc_curvature(math.radians(100), case.speed, 0))
+  trajectory = mpc.solve(case.reference, case.yaw, case.initial_pose, 0., case.speed,
+                         limit if sign > 0 else 0., rate, -.15, .15, .15,
+                         min_curvature=0. if sign > 0 else -limit)
+  assert trajectory.feasible, trajectory.reason
+  assert np.min(sign * trajectory.curvature) >= -1e-6
+  assert body_inside_corridor(trajectory.xy, trajectory.yaw, footprint, case.polygon)
+  plan = TrajectoryPlan(1, 0, 10., 10. + (trajectory.distance[-1] + 20) / case.speed,
+                        (0., 0., 0.), case.speed, 0., 0., -limit, limit,
+                        trajectory.distance, trajectory.xy, trajectory.yaw, trajectory.curvature, 1)
+  corridor = PlanningCorridor(1, 10., 10.2, (0., 0., 0.), case.reference, case.left, case.right, footprint, True, True, True)
+  cfg = replace(configuration(direct, .1, footprint), aggregate_delay=.3, physical_rate_deg_s=100.)
+  state = ExecutionState(10., tuple(case.initial_pose), case.speed, 0., 0., 0., cfg.aggregate_delay)
+  baseline = validate_reference_execution(state, corridor, cfg)
+  candidate = validate_execution(plan, state, corridor, cfg)
+  assert candidate.feasible, (candidate.reason, candidate.metrics)
+  assert not baseline.feasible
+  assert candidate.metrics['tracker_completed']
+  assert candidate.metrics['body_clear'] and not baseline.metrics['body_clear']
+  for result in (baseline, candidate):
+    assert result.metrics['completed']
+    assert result.metrics['terminal_position_error_m'] <= .2
+    assert result.metrics['terminal_heading_error_deg'] <= 1.
+    assert result.metrics['max_wheel_angle_deg'] == pytest.approx(140.)
+    assert result.metrics['steering_can_frames'] > 1000
+    assert not result.authorizes_execution
+  # Recheck actual executed poses, not only planned points or bounded requests.
+  assert body_inside_corridor(candidate.poses[:, :2], candidate.poses[:, 2], footprint, case.polygon)
+  assert not body_inside_corridor(baseline.poses[:, :2], baseline.poses[:, 2], footprint, case.polygon)
