new file mode 100644
index 0000000000000000000000000000000000000000..52828ffa549950522f07a8ad185e065daa9a9a6d
--- /dev/null
+++ b/tools/ev9_trajectory/optimizer.py
@@ -0,0 +1,325 @@
+"""Offline spatial trajectory optimization; no actuator or runtime-control writes."""
+from dataclasses import dataclass, field
+import math
+import time
+
+import casadi as ca
+import numpy as np
+
+
+@dataclass(frozen=True)
+class VehicleFootprint:
+  front: float = 4.2
+  rear: float = 0.9
+  half_width: float = 1.1
+  margin: float = 0.08
+
+
+DEFAULT_FOOTPRINT = VehicleFootprint()
+
+
+@dataclass
+class Trajectory:
+  feasible: bool
+  reason: str
+  xy: np.ndarray = field(default_factory=lambda: np.empty((0, 2)))
+  yaw: np.ndarray = field(default_factory=lambda: np.empty(0))
+  curvature: np.ndarray = field(default_factory=lambda: np.empty(0))
+  distance: np.ndarray = field(default_factory=lambda: np.empty(0))
+  solve_time: float = 0.0
+  diagnostics: dict = field(default_factory=dict)
+
+
+def arc_length(xy):
+  return np.r_[0., np.cumsum(np.linalg.norm(np.diff(xy, axis=0), axis=1))]
+
+
+def inside_polygon(points, polygon):
+  """Ray crossing with the original strict edge predicate and bounded batches."""
+  x, y = np.asarray(points).T
+  inside = np.zeros(len(points), dtype=bool)
+  if len(polygon) == 0:
+    return inside
+  a, b = np.asarray(polygon), np.roll(polygon, -1, axis=0)
+  low_y, high_y = np.minimum(a[:, 1], b[:, 1]), np.maximum(a[:, 1], b[:, 1])
+  for start in range(0, len(points), 256):
+    block_y = y[start:start + 256]
+    candidates = a[:, 1] != b[:, 1]
+    if np.isfinite(block_y).all():
+      candidates &= (low_y <= block_y.max()) & (high_y > block_y.min())
+    edge_a, edge_b = a[candidates], b[candidates]
+    point_index, edge_index = np.nonzero((edge_a[:, 1] > block_y[:, None]) != (edge_b[:, 1] > block_y[:, None]))
+    edge_a, edge_b = edge_a[edge_index], edge_b[edge_index]
+    # Keep arithmetic order and strict comparison identical to the scalar-edge
+    # loop. Only actual ray crossings require intersection calculations.
+    crosses = x[start + point_index] < ((edge_b[:, 0] - edge_a[:, 0]) * (block_y[point_index] - edge_a[:, 1]) /
+                                       (edge_b[:, 1] - edge_a[:, 1]) + edge_a[:, 0])
+    inside[start:start + len(block_y)] = np.bincount(point_index[crosses], minlength=len(block_y)) % 2 != 0
+  return inside
+
+
+def polygon_is_simple(polygon):
+  """Reject crossings/touches using the original predicates on box candidates."""
+  starts, ends = np.asarray(polygon), np.roll(polygon, -1, axis=0)
+  delta = ends - starts
+  if np.any(np.linalg.norm(delta, axis=1) < 1e-6):
+    return False
+  low, high = np.minimum(starts, ends), np.maximum(starts, ends)
+
+  def cross(a, b):
+    return a[..., 0] * b[..., 1] - a[..., 1] * b[..., 0]
+
+  for start in range(0, len(polygon) - 2, 64):
+    i = np.arange(start, min(start + 64, len(polygon) - 2))[:, None]
+    j = np.arange(start + 2, len(polygon))[None, :]
+    candidates = (j >= i + 2) & ~((i == 0) & (j == len(polygon) - 1))
+    # Separate coordinate arrays avoid allocating a dense pairs-by-2 tensor.
+    # Min/max and epsilon placement are the same as the original box test.
+    for axis in (0, 1):
+      candidates &= np.maximum(low[i, axis], low[j, axis]) <= np.minimum(high[i, axis], high[j, axis]) + 1e-9
+    row, column = np.nonzero(candidates)
+    first, second = i[row, 0], j[0, column]
+    a, b = starts[second], ends[second]
+    side_a, side_b = cross(delta[first], a - starts[first]), cross(delta[first], b - starts[first])
+    other_a, other_b = cross(b - a, starts[first] - a), cross(b - a, ends[first] - a)
+    if np.any((side_a * side_b <= 1e-12) & (other_a * other_b <= 1e-12)):
+      return False
+  return True
+
+
+def body_inside_corridor(xy, yaw, footprint, polygon):
+  """Check complete rectangle edges at each supplied pose, including margin.
+
+  Corners alone are insufficient in a concave turn. Edge intersections detect
+  boundary intrusions between corners. Continuous motion is still sampled.
+  """
+  front, rear, width = footprint.front + footprint.margin, footprint.rear + footprint.margin, footprint.half_width + footprint.margin
+  local = np.array([[-rear, -width], [front, -width], [front, width], [-rear, width]])
+  c, s = np.cos(yaw)[:, None], np.sin(yaw)[:, None]
+  corners = np.stack((xy[:, 0, None] + c * local[:, 0] - s * local[:, 1],
+                      xy[:, 1, None] + s * local[:, 0] + c * local[:, 1]), axis=-1)
+  if not inside_polygon(corners.reshape(-1, 2), polygon).all():
+    return False
+  p, q = polygon, np.roll(polygon, -1, axis=0)
+  polygon_min, polygon_max = np.minimum(p, q), np.maximum(p, q)
+  def cross(a, b):
+    return a[..., 0] * b[..., 1] - a[..., 1] * b[..., 0]
+  for start in range(0, len(corners), 64):
+    block = corners[start:start + 64]
+    # A block box contains every body edge below. Prune only pairs that cannot
+    # satisfy the original inclusive box predicate, keeping its tolerance.
+    candidates = np.all(np.maximum(block.min(axis=(0, 1)), polygon_min) <=
+                        np.minimum(block.max(axis=(0, 1)), polygon_max) + 1e-9, axis=1)
+    if not candidates.any():
+      continue
+    edge_p, edge_q = p[candidates], q[candidates]
+    edge_min, edge_max = polygon_min[candidates], polygon_max[candidates]
+    for edge in range(4):
+      a, b = block[:, edge, None, :], block[:, (edge + 1) % 4, None, :]
+      boxes = np.all(np.maximum(np.minimum(a, b), edge_min) <= np.minimum(np.maximum(a, b), edge_max) + 1e-9, axis=2)
+      body_index, polygon_index = np.nonzero(boxes)
+      if len(body_index) == 0:
+        continue
+      a, b = a[body_index, 0], b[body_index, 0]
+      candidate_p, candidate_q = edge_p[polygon_index], edge_q[polygon_index]
+      if np.any((cross(b - a, candidate_p - a) * cross(b - a, candidate_q - a) <= 1e-12) &
+                (cross(candidate_q - candidate_p, a - candidate_p) * cross(candidate_q - candidate_p, b - candidate_p) <= 1e-12)):
+        return False
+  return True
+
+
+GAUSS_X, GAUSS_W = np.polynomial.legendre.leggauss(4)
+GAUSS_X, GAUSS_W = (GAUSS_X + 1) / 2, GAUSS_W / 2
+
+
+def dense_trajectory(xy, yaw, curvature, lengths, spacing=0.05):
+  points, headings, curvatures, distances = [xy[0]], [yaw[0]], [curvature[0]], [0.]
+  station = 0.
+  for i, length in enumerate(lengths):
+    for distance in np.linspace(0, length, max(2, math.ceil(length / spacing) + 1))[1:]:
+      u = distance * GAUSS_X
+      psi = yaw[i] + curvature[i] * u + 0.5 * (curvature[i + 1] - curvature[i]) * u**2 / length
+      points.append(xy[i] + distance * np.array([np.dot(GAUSS_W, np.cos(psi)), np.dot(GAUSS_W, np.sin(psi))]))
+      headings.append(yaw[i] + curvature[i] * distance + 0.5 * (curvature[i + 1] - curvature[i]) * distance**2 / length)
+      curvatures.append(curvature[i] + (curvature[i + 1] - curvature[i]) * distance / length)
+      distances.append(station + distance)
+    station += length
+  return np.asarray(points), np.asarray(headings), np.asarray(curvatures), np.asarray(distances)
+
+
+def constrain_opposite_recovery(opti, curvature, lengths, direction, initial_opposite):
+  """Constrain the piecewise-linear curvature in actual travelled metres.
+
+  The envelope has a kink at one metre. Checking only trajectory knots can
+  miss a violation in a segment crossing it, so constrain that point too.
+  """
+  distance = ca.vertcat(0., ca.cumsum(lengths))
+  opti.subject_to(direction * curvature >= initial_opposite * ca.fmax(1. - distance, 0.))
+  within = ca.fmin(ca.fmax(1. - distance[:-1], 0.), lengths)
+  at_boundary = curvature[:-1] + (curvature[1:] - curvature[:-1]) * within / lengths
+  opti.subject_to(direction * at_boundary >= initial_opposite * ca.fmax(1. - distance[:-1] - within, 0.))
+
+
+def recovery_is_valid(distance, curvature, direction, initial_curvature):
+  """Independently check dense output and the exact recovery-envelope kink."""
+  if not direction:
+    return True
+  initial_opposite = min(0., direction * initial_curvature)
+  recovery = initial_opposite * np.maximum(1. - distance, 0.)
+  return bool(np.all(direction * curvature >= recovery - 1e-6) and direction * np.interp(1., distance, curvature) >= -1e-6)
+
+
+def solve_trajectory(reference, left, right, speed, initial_pose, initial_curvature, max_curvature, max_curvature_rate,
+                     footprint=DEFAULT_FOOTPRINT, node_spacing=0.8, max_iterations=350, min_curvature=None):
+  """Solve a complete known corridor from initial pose through a straight exit.
+
+  Coordinates are metres with positive-left geometric curvature. Poses refer to
+  the rear axle. Boundaries must be corresponding samples of a single, verified,
+  obstacle-free corridor and extend beyond both endpoints for body coverage.
+  A failed search is not a mathematical proof of infeasibility.
+  """
+  started = time.perf_counter()
+  def reject(reason, **diagnostics):
+    return Trajectory(False, reason, solve_time=time.perf_counter() - started, diagnostics=diagnostics)
+
+  try:
+    reference, left, right, initial_pose = [np.asarray(a, dtype=float) for a in (reference, left, right, initial_pose)]
+  except (TypeError, ValueError):
+    return reject('invalid_input')
+  min_curvature = -max_curvature if min_curvature is None else min_curvature
+  scalar = [speed, initial_curvature, min_curvature, max_curvature, max_curvature_rate, node_spacing,
+            footprint.front, footprint.rear, footprint.half_width, footprint.margin]
+  if (reference.ndim != 2 or reference.shape[1] != 2 or len(reference) < 5 or left.ndim != 2 or left.shape[1] != 2 or
+      left.shape != right.shape or len(left) < 5 or initial_pose.shape != (3,) or
+      not all(np.isfinite(a).all() for a in (reference, left, right, initial_pose, scalar)) or
+      min(speed, max_curvature, max_curvature_rate, node_spacing, footprint.front, footprint.rear, footprint.half_width) <= 0 or
+      footprint.margin < 0 or min_curvature >= 0 or not min_curvature <= initial_curvature <= max_curvature or
+      not isinstance(max_iterations, int) or max_iterations < 1):
+    return reject('invalid_input')
+  road = (left + right) / 2
+  rs, road_s = arc_length(reference), arc_length(road)
+  if np.any(np.diff(rs) < 1e-5) or np.any(np.diff(road_s) < 1e-5) or rs[-1] < 10:
+    return reject('invalid_geometry')
+  polygon = np.vstack((left, right[::-1]))
+  if not polygon_is_simple(polygon):
+    return reject('invalid_corridor_polygon')
+  road_heading = np.unwrap(np.arctan2(np.gradient(road[:, 1], road_s), np.gradient(road[:, 0], road_s)))
+  road_normal = np.column_stack((-np.sin(road_heading), np.cos(road_heading)))
+  # The corridor format uses matched cross-sections, not arbitrary two polylines.
+  span = left - right
+  if np.any(np.sum(span * road_normal, axis=1) <= 0) or np.any(np.abs(np.sum(span * np.column_stack((road_normal[:, 1],
+                                                                                                 -road_normal[:, 0])), axis=1)) > 0.1):
+    return reject('unmatched_corridor_sections')
+  reference_yaw = np.unwrap(np.arctan2(np.gradient(reference[:, 1], rs), np.gradient(reference[:, 0], rs)))
+  heading_change = reference_yaw[-1] - reference_yaw[0]
+  turn_direction = int(np.sign(heading_change)) if abs(heading_change) > math.radians(5) else 0
+  reference_curvature = np.gradient(reference_yaw, rs)
+  if ((turn_direction and min(turn_direction * reference_curvature) < -0.002) or
+      (not turn_direction and np.ptp(reference_yaw) > math.radians(5))):
+    return reject('unsupported_multiple_turn_directions')
+  # A visible straight continuation is required; no extrapolated or assumed exit.
+  end_mask = rs >= rs[-1] - 5.0
+  if np.ptp(reference_yaw[end_mask]) > math.radians(1):
+    return reject('uncovered_turn_exit')
+  if not body_inside_corridor(np.vstack((initial_pose[:2], reference[-1])),
+                             np.array([initial_pose[2], reference_yaw[-1]]), footprint, polygon):
+    return reject('endpoint_body_outside_corridor')
+  s = np.linspace(0, rs[-1], max(15, math.ceil(rs[-1] / node_spacing) + 1))
+  if len(s) > 180:
+    return reject('horizon_too_large')
+  ref = np.column_stack([np.interp(s, rs, reference[:, i]) for i in (0, 1)])
+  psi_ref = np.interp(s, rs, reference_yaw)
+  normals = np.column_stack((-np.sin(psi_ref), np.cos(psi_ref)))
+  initial_e = float(np.dot(initial_pose[:2] - ref[0], normals[0]))
+  if np.linalg.norm(ref[0] + initial_e * normals[0] - initial_pose[:2]) > 1e-4:
+    return reject('initial_pose_not_on_start_section')
+
+  opti = ca.Opti()
+  n = len(s)
+  e, yaw, k, length = opti.variable(n), opti.variable(n), opti.variable(n), opti.variable(n - 1)
+  x = ca.DM(ref[:, 0]) + e * normals[:, 0]
+  y = ca.DM(ref[:, 1]) + e * normals[:, 1]
+  opti.subject_to(opti.bounded(min_curvature, k, max_curvature))
+  if turn_direction:
+    # Preserve the intended turn. A geometric optimizer otherwise discovers
+    # large opposite-direction entry/exit swings to reduce reference-path error.
+    # Only recovery from an already opposite initial curvature is allowed, over
+    # the first metre; it cannot introduce a new countersteering maneuver.
+    initial_opposite = min(0., turn_direction * initial_curvature)
+    if initial_opposite < 0:
+      constrain_opposite_recovery(opti, k, length, turn_direction, initial_opposite)
+    else:
+      # Keep the zero-initial-curvature problem unchanged.
+      opti.subject_to(turn_direction * k >= np.zeros(n))
+  opti.subject_to(opti.bounded(-math.pi / 3, yaw - psi_ref, math.pi / 3))
+  opti.subject_to(opti.bounded(0.5 * np.diff(s), length, 1.5 * np.diff(s)))
+  opti.subject_to(e[0] == initial_e)
+  opti.subject_to(yaw[0] == initial_pose[2])
+  opti.subject_to(k[0] == initial_curvature)
+  opti.subject_to(e[-1] == 0)
+  opti.subject_to(yaw[-1] == psi_ref[-1])
+  opti.subject_to(k[-1] == 0)
+  dk = k[1:] - k[:-1]
+  opti.subject_to(opti.bounded(-max_curvature_rate / speed, dk / length, max_curvature_rate / speed))
+  for i in range(n - 1):
+    u = length[i] * ca.DM(GAUSS_X)
+    angle = yaw[i] + k[i] * u + 0.5 * dk[i] * u**2 / length[i]
+    opti.subject_to(x[i + 1] - x[i] == length[i] * ca.dot(ca.DM(GAUSS_W), ca.cos(angle)))
+    opti.subject_to(y[i + 1] - y[i] == length[i] * ca.dot(ca.DM(GAUSS_W), ca.sin(angle)))
+    opti.subject_to(yaw[i + 1] - yaw[i] == (k[i] + k[i + 1]) * length[i] / 2)
+
+  # Each footprint point has its own road station. This handles front/rear
+  # overhang through a curved corridor instead of testing only the axle point.
+  grid = [road_s]
+  cx = ca.interpolant('cx', 'bspline', grid, road[:, 0])
+  cy = ca.interpolant('cy', 'bspline', grid, road[:, 1])
+  half_width = ca.interpolant('half_width', 'linear', grid, np.linalg.norm(left - right, axis=1) / 2)
+  station_symbol = ca.MX.sym('station')
+  center = ca.vertcat(cx(station_symbol), cy(station_symbol))
+  derivative = ca.jacobian(center, station_symbol)
+  frame = ca.Function('road_frame', [station_symbol], [center, derivative / ca.norm_2(derivative)])
+  road_station = road_s[np.argmin(np.sum((ref[:, None, :] - road[None, :, :])**2, axis=2), axis=1)]
+  for along in (-footprint.rear, 0., footprint.front / 2, footprint.front):
+    for across in (-footprint.half_width, footprint.half_width):
+      stations = opti.variable(n)
+      opti.subject_to(opti.bounded(0, stations, road_s[-1]))
+      station_window = footprint.front + footprint.rear + 2 * footprint.half_width + 2
+      opti.subject_to(opti.bounded(road_station - station_window, stations, road_station + station_window))
+      for i in range(n):
+        point = ca.vertcat(x[i] + along * ca.cos(yaw[i]) - across * ca.sin(yaw[i]),
+                          y[i] + along * ca.sin(yaw[i]) + across * ca.cos(yaw[i]))
+        road_center, tangent = frame(stations[i])
+        separation = point - road_center
+        opti.subject_to(ca.dot(separation, tangent) == 0)
+        lateral = ca.dot(separation, ca.vertcat(-tangent[1], tangent[0]))
+        usable_width = half_width(stations[i]) - footprint.margin
+        opti.subject_to(opti.bounded(-usable_width, lateral, usable_width))
+      opti.set_initial(stations, np.clip(road_station + along, 0, road_s[-1]))
+
+  opti.minimize(ca.sumsqr(e) + 2 * ca.sumsqr(yaw - psi_ref) +
+                0.015 * ca.sumsqr(k / max_curvature) + 0.08 * ca.sumsqr(dk / max_curvature))
+  opti.set_initial(e, 0)
+  opti.set_initial(yaw, psi_ref)
+  opti.set_initial(k, np.clip(np.gradient(psi_ref, s), min_curvature, max_curvature))
+  opti.set_initial(length, np.diff(s))
+  opti.solver('ipopt', {'expand': False, 'print_time': False},
+              {'print_level': 0, 'sb': 'yes', 'max_iter': max_iterations, 'tol': 1e-7, 'acceptable_tol': 1e-6, 'max_cpu_time': 30.})
+  try:
+    solved = opti.solve()
+  except RuntimeError:
+    return reject('no_feasible_solution_found', solver_status=opti.stats().get('return_status'))
+  sparse_xy = np.column_stack((solved.value(x), solved.value(y)))
+  sparse_yaw, sparse_k, lengths = solved.value(yaw), solved.value(k), solved.value(length)
+  xy, headings, curvatures, distance = dense_trajectory(sparse_xy, sparse_yaw, sparse_k, lengths)
+  if not np.isfinite(np.r_[xy.ravel(), headings, curvatures, distance]).all():
+    return reject('invalid_solution')
+  if not recovery_is_valid(distance, curvatures, turn_direction, initial_curvature):
+    return reject('opposite_recovery_verification_failed')
+  if not body_inside_corridor(xy, headings, footprint, polygon):
+    return reject('sampled_body_clearance_failed')
+  if (max(curvatures) > max_curvature + 1e-6 or min(curvatures) < min_curvature - 1e-6 or
+      max(abs(np.diff(sparse_k) / lengths)) * speed > max_curvature_rate + 1e-6 or
+      np.linalg.norm(xy[-1] - reference[-1]) > 1e-4 or abs(headings[-1] - psi_ref[-1]) > 1e-4):
+    return reject('solution_verification_failed')
+  return Trajectory(True, 'feasible', xy, headings, curvatures, distance, time.perf_counter() - started,
+                    {'max_offset_m': float(max(abs(solved.value(e)))), 'nodes': n, 'iterations': solved.stats()['iter_count']})
