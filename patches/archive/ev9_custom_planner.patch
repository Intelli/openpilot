+def real_adapter_controls(monkeypatch, mode):
+  from openpilot.selfdrive.controls.lib.ev9_trajectory_control import EV9TrajectoryControl
+
+  monkeypatch.setenv('REPLAY', '1')
+  c = make_controls(monkeypatch)
+  c.sm['carState'].vEgo = c.sm['carState'].vEgoRaw = 2.0
+  c.sm['carState'].gearShifter = 'drive'
+  c.sm['liveParameters'].valid = True
+  c.sm['carOutput'].actuatorsOutput.ev9AngleStateValid = True
+  c.sm['carOutput'].actuatorsOutput.ev9AngleStateMonoTime = 10_000_000_000
+  c.sm['ev9TrajectoryPlan'] = messaging.new_message('ev9TrajectoryPlan').ev9TrajectoryPlan
+  c.ev9_trajectory = EV9TrajectoryControl(c.CP, SimpleNamespace(get=lambda key: str(mode).encode()))
+  return c
+
+
+def advance(c, now):
+  c.sm['carOutput'].actuatorsOutput.ev9AngleStateMonoTime = int(now * 1e9)
+  for service in c.sm:
+    c.sm.logMonoTime[service] = int(now * 1e9)
+
+
+def install_valid_plan(c, now=10.01):
+  # Initialization deliberately has no lease: a later, fresh plan must be required.
+  c.state_control()
+  advance(c, now)
+  m = c.sm['ev9TrajectoryPlan']
+  m.feasible = m.executionValidated = True
+  m.planId = 1
+  m.generation = c.ev9_trajectory.motion.generation
+  m.sourceMonoTime = int(now * 1e9)
+  m.validUntilMonoTime = int((now + 12) * 1e9)
+  m.corridorValidUntilMonoTime = int((now + 0.2) * 1e9)
+  m.corridorRevision = 1
+  m.frame = 'rear_axle_x_forward_y_left'
+  m.originX = (now - 10.0) * 2.0
+  m.speed = 2.0
+  m.minCurvature, m.maxCurvature = -0.05, 0.05
+  m.distance = [float(i) / 5 for i in range(101)]
+  m.x = list(m.distance)
+  m.y = m.yaw = m.curvature = [0.0] * 101
+  return m
+
