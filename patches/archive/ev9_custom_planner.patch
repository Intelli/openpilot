+"""Synthetic full-turn road scenarios using nominal EV9 vehicle-model parameters."""
+
+from dataclasses import dataclass
+from types import SimpleNamespace
+import math
+import numpy as np
+from opendbc.car.vehicle_model import VehicleModel
+
+# Nominal EV9 model scalars; no route identity or measured trajectory is embedded.
+PARAMS = dict(
+  mass=2800.0,
+  rotationalInertia=6311.7021484375,
+  wheelbase=3.1,
+  centerToFront=1.24,
+  steerRatioRear=0.0,
+  tireStiffnessFront=368002.71875,
+  tireStiffnessRear=387824.90625,
+  steerRatio=16.0,
+)
+VM = VehicleModel(SimpleNamespace(**PARAMS))
+# Deliberately explicit planning footprint; not inferred physical dimensions from CP.
+HALF_WIDTH = 1.10
+FRONT = 4.2
+REAR = 0.9
+
+
+@dataclass
+class Case:
+  name: str
+  reference: np.ndarray
+  yaw: np.ndarray
+  arc: np.ndarray
+  left: np.ndarray
+  right: np.ndarray
+  polygon: np.ndarray
+  speed: float
+  initial_pose: np.ndarray
+  expected: str
+
+
+def integrate(arc, curvature):
+  ds = np.diff(arc)
+  yaw = np.r_[0, np.cumsum((curvature[1:] + curvature[:-1]) * 0.5 * ds)]
+  xy = np.vstack(([0.0, 0.0], np.cumsum(np.column_stack((np.cos((yaw[1:] + yaw[:-1]) / 2), np.sin((yaw[1:] + yaw[:-1]) / 2))) * ds[:, None], axis=0)))
+  return xy, yaw
+
+
+def fixture(demand=100.0, width=5.0, sign=1, initial_heading_deg=0.0, speed=2.0, uncovered=False):
+  k = abs(VM.calc_curvature(math.radians(demand), speed, 0))
+  # Half-cosine ramps, each 20% of turn length; integral is .8*k*turn_length.
+  turn_length = (math.pi / 2) / (0.8 * k)
+  approach = 12.0
+  exit_length = 10.0
+  arc = np.linspace(0, approach + turn_length + exit_length, int((approach + turn_length + exit_length) / 0.1) + 1)
+  u = (arc - approach) / turn_length
+  profile = np.where((u >= 0) & (u <= 1), 1.0, 0.0)
+  ramp = (u >= 0) & (u < 0.2)
+  profile[ramp] = 0.5 * (1 - np.cos(np.pi * u[ramp] / 0.2))
+  ramp = (u > 0.8) & (u <= 1)
+  profile[ramp] = 0.5 * (1 - np.cos(np.pi * (1 - u[ramp]) / 0.2))
+  xy, yaw = integrate(arc, sign * k * profile)
+  normal = np.column_stack((-np.sin(yaw), np.cos(yaw)))
+  # Boundary continues behind start and beyond exit for full-body coverage.
+  end = len(arc) - 1 if not uncovered else int(np.searchsorted(arc, arc[-1] - 5.0))
+  center = np.vstack(([-6.0, 0.0], xy[: end + 1], xy[end] + 6 * np.array([math.cos(yaw[end]), math.sin(yaw[end])]) if not uncovered else xy[end]))
+  norms = np.vstack(([0.0, 1.0], normal[: end + 1], normal[end]))
+  left = center + width / 2 * norms
+  right = center - width / 2 * norms
+  polygon = np.vstack((left, right[::-1]))
+  expected = (
+    'reject_uncovered_exit'
+    if uncovered
+    else 'narrow_or_tight_rejection'
+    if width <= 2.3 or demand >= 200
+    else 'feasible_reference'
+    if demand <= 120
+    else 'search_wide_corridor'
+  )
+  return Case(
+    f'demand{demand:g}_w{width:g}_s{sign}_h{initial_heading_deg:g}' + ('_uncovered' if uncovered else ''),
+    xy,
+    yaw,
+    arc,
+    left,
+    right,
+    polygon,
+    speed,
+    np.array([0.0, 0.0, math.radians(initial_heading_deg)]),
+    expected,
+  )
+
+
+def cases():
+  return [
+    fixture(demand, width, sign, heading, uncovered=uncovered)
+    for demand, width, uncovered in [
+      (100, 5, False),
+      (135, 5, False),
+      (145, 7, False),
+      (160, 7, False),
+      (180, 3, False),
+      (220, 3, False),
+      (100, 2.2, False),
+      (100, 5, True),
+    ]
+    for sign in [-1, 1]
+    for heading in [-2.0, 0.0, 2.0]
+  ]
