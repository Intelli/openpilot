+
+@pytest.mark.parametrize('sign', [-1, 1])
+@pytest.mark.parametrize('spacing', [.8, 3.])
+@pytest.mark.parametrize('opposite', [False, True])
+def test_recovery_uses_actual_distance_and_preserves_zero_initial(sign, spacing, opposite):
+  case = fixture(145., 7., sign)
+  initial = -sign * .01 if opposite else 0.
+  result = solve_trajectory(case.reference, case.left, case.right, case.speed, case.initial_pose, initial,
+                 abs(VM.calc_curvature(math.radians(140), case.speed, 0.)),
+                 abs(VM.calc_curvature(math.radians(100), case.speed, 0.)), node_spacing=spacing)
+  assert result.feasible, result.reason
+  # Evaluate from output distances, independently of reference station knots.
+  envelope = min(0., sign * initial) * np.maximum(1. - result.distance, 0.)
+  assert np.min(sign * result.curvature - envelope) >= -1e-6
+  assert sign * np.interp(1., result.distance, result.curvature) >= -1e-6
+  assert np.min(sign * result.curvature[result.distance > 1.]) >= -1e-6
+  checked = evaluate(case, result.xy, result.yaw)
+  assert checked['accepted'], checked
+  assert checked['max_angle_rate_deg_s'] <= 100.1
+
+
+@pytest.mark.parametrize('sign', [-1, 1])
+def test_dense_check_rejects_violation_between_reference_knots(sign):
+  # Each supplied knot satisfies the envelope, but interpolation remains
+  # opposite at 1m; a coarse mesh cannot postpone the recovery breakpoint.
+  distance = np.array([0., .8, 1.2, 2.])
+  curvature = sign * np.array([-.01, -.002, 0., 0.])
+  assert not recovery_is_valid(distance, curvature, sign, -sign * .01)
+  curvature = sign * np.array([-.01, -.001, .001, 0.])
+  assert recovery_is_valid(distance, curvature, sign, -sign * .01)
+
