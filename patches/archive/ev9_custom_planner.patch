+def recapture(model, index, count=None):
+  """Re-express the same world intent/space at a later rear-axle capture pose."""
+  from openpilot.selfdrive.controls.lib.ev9_path_input import build_path_input
+  geometry = build_path_input(model, MODEL_GEOMETRY, source_time=10., now=10., model_valid=True)
+  origin = np.r_[geometry.xy[index], geometry.yaw[index]]
+  c, s = np.cos(origin[2]), np.sin(origin[2])
+  rotation = np.array([[c, -s], [s, c]])
+  xy = (geometry.xy[index:] - origin[:2]) @ rotation
+  yaw = geometry.yaw[index:] - origin[2]
+  if count is not None:
+    indices = np.unique(np.linspace(0, len(xy) - 1, count).astype(int))
+    xy, yaw = xy[indices], yaw[indices]
+  mount = MODEL_GEOMETRY.mount.vector()
+  camera = xy + np.column_stack((2 * np.cos(yaw), 2 * np.sin(yaw))) - mount
+  t = np.r_[0., np.cumsum(np.linalg.norm(np.diff(xy, axis=0), axis=1))] / 2
+
+  def boundary(points):
+    local = (points - origin[:2]) @ rotation
+    local = local[local[:, 0] >= mount[0]] - mount
+    return dict(x=local[:, 0], y=-local[:, 1])
+
+  left, right = boundary(geometry.left), boundary(geometry.right)
+  out = dict(model, position=dict(x=camera[:, 0], y=-camera[:, 1], t=t), orientation=dict(z=-yaw, t=t),
+             laneLines=[left, left, right, right], roadEdges=[left, right])
+  curvature = np.gradient(geometry.yaw, geometry.distance)[index]
+  return out, origin, curvature
+
