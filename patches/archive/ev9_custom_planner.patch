+"""Verify simulation signs and the measured full-turn ownership behavior."""
+import math
+
+import numpy as np
+import pytest
+
+from openpilot.tools.ev9_trajectory.benchmark import Plant, track
+from openpilot.tools.ev9_trajectory.fixtures import VM, fixture
+from openpilot.tools.ev9_trajectory.live_benchmark import execution_state, make_plan, mirror_xy, plant_case, track_live
+from openpilot.tools.ev9_trajectory.optimizer import solve_trajectory
+
+
+@pytest.mark.parametrize('sign', [-1, 1])
+def test_plant_geometry_reflection_and_actual_curvature_sign(sign):
+  case = fixture(145., 7., sign, 2.)
+  reflected = plant_case(case)
+  assert np.array_equal(reflected.reference, mirror_xy(case.reference))
+  assert reflected.initial_pose[2] == -case.initial_pose[2]
+  plant = Plant(dict(delay=.05, initial_heading_deg=-2.), case.speed)
+  target = -VM.calc_curvature(math.radians(sign * 50), case.speed, 0.)
+  for _ in range(100):
+    plant.step(target)
+  state = execution_state(plant, 1., .325)
+  assert state.pose == pytest.approx((plant.pose[0], -plant.pose[1], -plant.pose[2]))
+  assert sign * state.curvature > 0
+  assert sign * state.command_curvature > 0
+  assert state.delay == .325
+
+
+@pytest.mark.parametrize('demand', [145., 160.])
+def test_full_turn_completes_with_feedback_above_planning_authority(demand):
+  case = fixture(demand, 7., 1)
+  limit = abs(VM.calc_curvature(math.radians(140), case.speed, 0.))
+  rate = abs(VM.calc_curvature(math.radians(100), case.speed, 0.))
+  trajectory = solve_trajectory(case.reference, case.left, case.right, case.speed, case.initial_pose, 0., limit, rate)
+  assert trajectory.feasible
+  plan = make_plan(case, trajectory)
+  assert plan.max_curvature == limit
+  assert plan.min_curvature == -limit
+  result = track_live(case, trajectory, .05)
+  assert result['adoptions'] == 1
+  assert result['releases'] == 1
+  assert sum(result['reason_counts'].values()) == result['total_steps']
+  assert 0 < result['active_fraction'] < 1
+  release = next(t for t in result['transitions'] if t['event'] == 'release')
+  # Full-140 geometry remains available. Feedback may exceed it while the
+  # existing simulated physical authority stays at 140 degrees.
+  assert release['reason'] == 'complete'
+  assert release['selected_curvature'] == release['baseline_curvature']
+  assert result['tracker_completed'] and result['success']
+  assert result['sampled_body_violation_poses'] == 0
+  assert result['max_active_requested_angle_deg'] > 140.
+  assert result['max_wheel_angle_deg'] <= 140.
+
+  if demand == 160.:
+    reflected = plant_case(case)
+    baseline = track(reflected, reflected.reference, reflected.yaw, reflected.arc, np.gradient(reflected.yaw, reflected.arc), 1., .05)
+    assert not baseline['success']
