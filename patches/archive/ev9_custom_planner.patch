+"""Offline full-turn execution experiment using production EV9 steering controllers.
+
+This is a synthetic constant-speed plant, not an on-road execution permission
+provider. Calibration, controller snapshot and queued physical targets must be
+explicit inputs. No defaults reconstruct unknown historical actuator state.
+"""
+from collections import Counter, deque
+from dataclasses import dataclass, field, replace
+import math
+from types import SimpleNamespace
+
+import numpy as np
+
+from openpilot.selfdrive.controls.lib.ev9_trajectory import TrackingDecision, TrajectoryMode, TrajectoryTracker
+from openpilot.tools.ev9_trajectory.optimizer import body_inside_corridor
+
+DT = .01
+
+
+@dataclass(frozen=True)
+class PlanningCorridor:
+  revision: int
+  source_time: float
+  valid_until: float
+  origin: tuple[float, float, float]
+  reference: np.ndarray
+  left: np.ndarray
+  right: np.ndarray
+  footprint: object
+  permitted_space_validated: bool = False
+  occupancy_validated: bool = False
+  frame_validated: bool = False
+
+
+@dataclass(frozen=True)
+class SensorMapping:
+  """Explicit synthetic affine sensor map, in steering-wheel degrees.
+
+  SAS = physical wheel + sas_offset. MDPS1/2 = scale * SAS + offset.
+  Command interpretation uses the inverse map for the selected transport.
+  This relation is an assumption, not something inferred from CAN validity.
+  """
+  sas_offset_deg: float
+  mdps1_scale: float
+  mdps1_offset_deg: float
+  mdps2_scale: float
+  mdps2_offset_deg: float
+
+
+@dataclass(frozen=True)
+class ControllerSnapshot:
+  physical_wheel_deg: float
+  filter_angle_deg: float
+  final_command_deg: float
+  torque_gain: float
+  base_torque_gain: float
+  frame: int
+  transport_initialized: bool
+  manual_latched: bool
+  # Oldest target first, one per 10 ms until a newly transmitted target arrives.
+  in_flight_physical_targets_deg: tuple[float, ...]
+
+
+@dataclass(frozen=True)
+class ExecutionConfiguration:
+  car_params: bytes
+  physical_car_params: bytes
+  steer_ratio: float
+  stiffness_factor: float
+  angle_offset_deg: float
+  roll: float
+  sensors: SensorMapping
+  snapshot: ControllerSnapshot
+  direct: bool
+  hardware_delay: float
+  physical_rate_deg_s: float
+  aggregate_delay: float
+  footprint: object
+  shared_autonomy_mode: int
+  controller_limit_speed_kph: float
+  provenance: str  # Only 'synthetic_explicit' is currently supported.
+
+
+@dataclass
+class ExecutionResult:
+  feasible: bool
+  reason: str
+  poses: np.ndarray = field(default_factory=lambda: np.empty((0, 3)))
+  metrics: dict = field(default_factory=dict)
+
+  @property
+  def authorizes_execution(self):
+    # No calibrated hardware-response or safety/occupancy evidence provider exists here.
+    return False
+
+  def __bool__(self):
+    raise TypeError('ExecutionResult is evidence, not an execution-permission boolean')
+
+
+def validate_execution(plan, state, corridor, configuration):
+  """Evaluate a complete candidate and its exit; call only outside controlsd.
+
+  Both production transports generate and decode real CAN payloads, but this
+  does not run Panda safety hooks or emulate EPS torque/ECU fault responses.
+  The supplied aggregate delay drives tracker preview; hardware_delay alone
+  queues CAN targets because the actual controller already applies its filter.
+  """
+  if plan is None:
+    return ExecutionResult(False, 'missing_candidate_plan')
+  return _validate(plan, state, corridor, configuration)
+
+
+def validate_reference_execution(state, corridor, configuration):
+  """Research reference feedback through the same chain; no planned-path gate.
+
+  This is geometric feedback at 100 Hz, not the learned openpilot policy. It uses
+  common exit/body criteria without claiming TrajectoryTracker completion or
+  authorizing vehicle execution. No feasible candidate plan is required.
+  """
+  return _validate(None, state, corridor, configuration)
+
+
+def _validate(plan, state, corridor, configuration):
+  if not isinstance(configuration, ExecutionConfiguration):
+    return ExecutionResult(False, 'missing_execution_configuration')
+  cfg, snap = configuration, configuration.snapshot
+  if not isinstance(snap, ControllerSnapshot) or not isinstance(cfg.sensors, SensorMapping):
+    return ExecutionResult(False, 'missing_execution_configuration')
+  if cfg.provenance != 'synthetic_explicit':
+    return ExecutionResult(False, 'onroad_execution_model_not_validated')
+  if state.rejection(state.time) or state.manual or snap.manual_latched:
+    return ExecutionResult(False, 'unsupported_initial_ownership')
+  values = [cfg.steer_ratio, cfg.stiffness_factor, cfg.angle_offset_deg, cfg.roll, cfg.hardware_delay,
+            cfg.physical_rate_deg_s, cfg.aggregate_delay, cfg.controller_limit_speed_kph,
+            *vars(cfg.sensors).values(), snap.physical_wheel_deg, snap.filter_angle_deg, snap.final_command_deg,
+            snap.torque_gain, snap.base_torque_gain, *snap.in_flight_physical_targets_deg]
+  if (not np.isfinite(values).all() or min(cfg.steer_ratio, cfg.stiffness_factor, cfg.physical_rate_deg_s,
+                                         cfg.sensors.mdps1_scale, cfg.sensors.mdps2_scale) <= 0 or
+      not 0 <= cfg.hardware_delay <= 1 or not 0 <= cfg.aggregate_delay <= 1 or
+      abs(cfg.hardware_delay / DT - round(cfg.hardware_delay / DT)) > 1e-6 or
+      len(snap.in_flight_physical_targets_deg) != round(cfg.hardware_delay / DT) or
+      not isinstance(snap.frame, int) or snap.frame < 0 or not snap.transport_initialized or
+      any(abs(value) > 140 for value in snap.in_flight_physical_targets_deg) or
+      cfg.shared_autonomy_mode not in (0, 1, 2) or not 0 <= snap.torque_gain <= 1 or not 0 <= snap.base_torque_gain <= 1):
+    return ExecutionResult(False, 'invalid_execution_configuration')
+  if not (corridor.frame_validated and corridor.permitted_space_validated and corridor.occupancy_validated):
+    return ExecutionResult(False, 'unvalidated_synthetic_corridor')
+  if cfg.footprint != corridor.footprint:
+    return ExecutionResult(False, 'footprint_mismatch')
+  if abs(state.wheel_angle_deg - (snap.physical_wheel_deg + cfg.sensors.sas_offset_deg)) > 1e-4:
+    return ExecutionResult(False, 'initial_sensor_state_mismatch')
+  if state.angle_state_valid:
+    scale = cfg.sensors.mdps2_scale if cfg.direct else cfg.sensors.mdps1_scale
+    offset = cfg.sensors.mdps2_offset_deg if cfg.direct else cfg.sensors.mdps1_offset_deg
+    if (abs(state.angle_filter_state_deg - snap.filter_angle_deg) > 1e-4 or
+        abs(state.selected_mdps_angle_deg - (scale * state.wheel_angle_deg + offset)) > 1e-4 or
+        state.direct_angle_control != cfg.direct or not 0 <= state.time - state.angle_state_mono_time / 1e9 <= .05):
+      return ExecutionResult(False, 'initial_controller_snapshot_mismatch')
+  try:
+    from opendbc.car import structs
+    with structs.CarParams.from_bytes(cfg.car_params) as cp, structs.CarParams.from_bytes(cfg.physical_car_params) as physical_cp:
+      return _simulate(plan, state, corridor, cfg, cp, physical_cp)
+  except (ValueError, TypeError, RuntimeError, AttributeError, IndexError, OverflowError) as error:
+    return ExecutionResult(False, 'execution_error', metrics={'error': type(error).__name__})
+
+
+def _simulate(plan, initial, corridor, cfg, cp, physical_cp):
+  from opendbc.can import CANParser
+  from opendbc.car import Bus, gen_empty_fingerprint, structs
+  from opendbc.car.hyundai.carcontroller import CarController
+  from opendbc.car.hyundai.carstate import CarState
+  from opendbc.car.hyundai.interface import CarInterface
+  from opendbc.car.hyundai.values import CAR, DBC, HyundaiFlags
+  from opendbc.car.vehicle_model import VehicleModel
+  from openpilot.selfdrive.controls.lib.drive_helpers import clip_curvature
+  from openpilot.selfdrive.controls.lib.latcontrol_angle import LatControlAngle
+
+  if cp.carFingerprint != CAR.KIA_EV9 or not cp.flags & HyundaiFlags.CANFD_ANGLE_STEERING or cp.openpilotLongitudinalControl != cfg.direct:
+    return ExecutionResult(False, 'unsupported_controller_configuration')
+  vm, physical_vm = VehicleModel(cp), VehicleModel(physical_cp)
+  vm.update_params(cfg.stiffness_factor, cfg.steer_ratio)
+  toggles = SimpleNamespace(always_on_lateral_lkas=False, force_torque_controller=False, nnff=False, nnff_lite=False,
+                            hkg_shared_autonomy_mode=cfg.shared_autonomy_mode,
+                            hkg_tuning_angle_custom_limit_max_speed_kph=cfg.controller_limit_speed_kph)
+  scp = CarInterface.get_starpilot_params(CAR.KIA_EV9, gen_empty_fingerprint(), [], cp, toggles)
+  cs = CarState(cp, scp)
+  cs.out = structs.CarState.new_message(canValid=True, vEgo=initial.speed, vEgoRaw=initial.speed, gearShifter='drive')
+  cs.stock_lkas_msg = {'ADAS_StrAnglReqVal': cfg.snapshot.final_command_deg, 'ADAS_ACIAnglTqRedcGainVal': cfg.snapshot.torque_gain}
+  cs.lfa_block_msg = {f'BYTE{i}': 0 for i in range(3, 32) if i != 7}
+  cs.lfa_block_msg['COUNTER'] = 0
+  cc = structs.CarControl.new_message(enabled=True, latActive=True, longActive=cfg.direct)
+  controller = CarController(DBC[CAR.KIA_EV9], cp)
+  controller.long_active_ecu, controller._ecu_disable_checked = cfg.direct, True
+  controller.frame = cfg.snapshot.frame
+  controller.apply_angle_last = cfg.snapshot.final_command_deg
+  controller.angle_filter.x = cfg.snapshot.filter_angle_deg
+  controller.apply_torque_last, controller.apply_torque_base_last = cfg.snapshot.torque_gain, cfg.snapshot.base_torque_gain
+  controller._ev9_initialized_angle_transports.add(0xCB if cfg.direct else 0x110)
+  lac = LatControlAngle(cp, None, DT)
+  lp = SimpleNamespace(angleOffsetDeg=cfg.angle_offset_deg, roll=cfg.roll)
+  parser = None
+  message_name = 'ADAS_CMD_35_10ms' if cfg.direct else 'LKAS_ALT'
+  active_field = 'ADAS_ActvACILvl2Sta' if cfg.direct else 'LKAS_ANGLE_ACTIVE'
+  address = 0xCB if cfg.direct else 0x110
+  # Explicit oracle evidence for this simulation only; never returned as on-road authorization.
+  candidate = replace(plan, execution_validated=True) if plan is not None else None
+  tracker = TrajectoryTracker()
+  wheel = cfg.snapshot.physical_wheel_deg
+  queue = deque(cfg.snapshot.in_flight_physical_targets_deg)
+  command = -initial.command_curvature
+  pose = np.array(initial.pose, dtype=float)
+  reference = np.asarray(corridor.reference)
+  origin = np.asarray(corridor.origin)
+  rotation = np.array([[math.cos(origin[2]), -math.sin(origin[2])], [math.sin(origin[2]), math.cos(origin[2])]])
+  rs = np.r_[0., np.cumsum(np.linalg.norm(np.diff(reference, axis=0), axis=1))]
+  yaw = np.unwrap(np.arctan2(np.gradient(reference[:, 1], rs), np.gradient(reference[:, 0], rs)))
+  curvature = np.gradient(yaw, rs)
+  target, nearest = 0., 0
+  reasons = Counter()
+  poses, trace = [pose.copy()], []
+  completed = False
+  for tick in range(min(12000, math.ceil((max(rs[-1], plan.distance[-1] if plan is not None else 0.) + 20) / initial.speed / DT))):
+    now = initial.time + tick * DT
+    local_xy = rotation.T @ (pose[:2] - origin[:2])
+    local_yaw = pose[2] - origin[2]
+    lo, hi = max(0, nearest - 8), min(len(reference), nearest + 120)
+    nearest = lo + int(np.argmin(np.sum((reference[lo:hi] - local_xy)**2, axis=1)))
+    lateral = (local_xy - reference[nearest]) @ np.array([-math.sin(yaw[nearest]), math.cos(yaw[nearest])])
+    heading = math.atan2(math.sin(local_yaw - yaw[nearest]), math.cos(local_yaw - yaw[nearest]))
+    target = -(float(np.interp(rs[nearest] + initial.speed * cfg.aggregate_delay, rs, curvature)) - .08 * lateral - .5 * heading)
+    sas = wheel + cfg.sensors.sas_offset_deg
+    cs.out.steeringAngleDeg = sas
+    cs.mdps_steering_angle = cfg.sensors.mdps1_scale * sas + cfg.sensors.mdps1_offset_deg
+    cs.angle_steering_angle = cfg.sensors.mdps2_scale * sas + cfg.sensors.mdps2_offset_deg
+    measured_curvature = vm.calc_curvature(math.radians(sas - cfg.angle_offset_deg), initial.speed, cfg.roll)
+    state = replace(initial, time=now, pose=tuple(pose), wheel_angle_deg=sas, curvature=measured_curvature,
+                    command_curvature=-command, delay=cfg.aggregate_delay)
+    if candidate is None:
+      decision = TrackingDecision(target, True, 'reference_feedback')
+    else:
+      decision = tracker.update(state, target, mode=TrajectoryMode.ACTIVE, proposal=candidate if tick == 0 else None,
+                                corridor_revision=corridor.revision, corridor_valid_until=now + .2)
+    reasons[decision.reason] += 1
+    if not decision.active and decision.reason != 'complete' and not reasons['complete']:
+      return ExecutionResult(False, 'tracker_' + decision.reason, np.asarray(poses), {'reason_counts': dict(reasons)})
+    command, limited = clip_curvature(initial.speed, command, decision.curvature, cfg.roll,
+                                     ev9_angle_limit_speed_mps=cfg.controller_limit_speed_kph / 3.6)
+    _, requested, _ = lac.update(True, cs.out, vm, lp, False, command, limited, cfg.aggregate_delay, None, None, toggles,
+                                 now_nanos=int(now * 1e9))
+    cc.actuators.curvature, cc.actuators.steeringAngleDeg = command, requested
+    output, can = controller.update(cc.as_reader(), cs, int(now * 1e9), toggles)
+    selected = [message for message in can if message[0] == address]
+    if len(selected) != 1:
+      return ExecutionResult(False, 'missing_or_ambiguous_steering_can', np.asarray(poses))
+    if parser is None:
+      parser = CANParser(DBC[CAR.KIA_EV9][Bus.pt], [(message_name, 0)], selected[0][2])
+    parser.update([(int(now * 1e9), selected)])
+    decoded = parser.vl[message_name]
+    if decoded[active_field] != 2 or output.manualSteeringOverride:
+      return ExecutionResult(False, 'controller_relinquished_steering', np.asarray(poses))
+    sent = decoded['ADAS_StrAnglReqVal']
+    scale = cfg.sensors.mdps2_scale if cfg.direct else cfg.sensors.mdps1_scale
+    offset = cfg.sensors.mdps2_offset_deg if cfg.direct else cfg.sensors.mdps1_offset_deg
+    physical_target = float(np.clip((sent - offset) / scale - cfg.sensors.sas_offset_deg, -140., 140.))
+    queue.append(physical_target)
+    delayed = queue.popleft()
+    wheel += float(np.clip(delayed - wheel, -cfg.physical_rate_deg_s * DT, cfg.physical_rate_deg_s * DT))
+    delta_yaw = physical_vm.calc_curvature(math.radians(wheel), initial.speed, cfg.roll) * initial.speed * DT
+    pose[:2] += initial.speed * DT * np.array([math.cos(pose[2] + delta_yaw / 2), math.sin(pose[2] + delta_yaw / 2)])
+    pose[2] += delta_yaw
+    poses.append(pose.copy())
+    trace.append((requested, sent, wheel, controller.angle_filter.x))
+    if (rotation.T @ (pose[:2] - origin[:2]) - reference[-1]) @ np.array([math.cos(yaw[-1]), math.sin(yaw[-1])]) >= 0 and nearest > len(reference) * .8:
+      completed = True
+      break
+  poses, trace = np.asarray(poses), np.asarray(trace)
+  local = (poses[:, :2] - origin[:2]) @ rotation
+  polygon = np.vstack((corridor.left, corridor.right[::-1]))
+  clear = body_inside_corridor(local, poses[:, 2] - origin[2], cfg.footprint, polygon)
+  terminal = float(np.linalg.norm(local[-1] - reference[-1]))
+  heading_error = abs(math.degrees(math.atan2(math.sin(poses[-1, 2] - origin[2] - yaw[-1]), math.cos(poses[-1, 2] - origin[2] - yaw[-1]))))
+  tracker_completed = reasons['complete'] > 0
+  success = bool(completed and (candidate is None or tracker_completed) and clear and terminal <= .2 and heading_error <= 1.)
+  success_reason = 'synthetic_reference_feasible' if candidate is None else 'synthetic_feasible'
+  return ExecutionResult(success, success_reason if success else 'execution_or_exit_failed', poses,
+                         dict(policy='reference_feedback' if candidate is None else 'trajectory_tracker', tracker_completed=tracker_completed,
+                              completed=completed, body_clear=clear, terminal_position_error_m=terminal,
+                              terminal_heading_error_deg=heading_error, reason_counts=dict(reasons), ticks=len(trace),
+                              max_requested_angle_deg=float(np.max(abs(trace[:, 0]))), max_can_angle_deg=float(np.max(abs(trace[:, 1]))),
+                              max_wheel_angle_deg=float(np.max(abs(trace[:, 2]))), max_filter_angle_deg=float(np.max(abs(trace[:, 3]))),
+                              direct=cfg.direct, steering_can_frames=len(trace),
+                              limitations=['Synthetic affine sensor mapping and constant-speed wheel plant; no real calibration evidence.',
+                                           'Production steering chain and decoded CAN, but no Panda safety or ECU-response validation.',
+                                           'Oracle renewed corridor; baseline after plan completion is geometric feedback, not learned model.',
+                                           'Inflated rectangle at 100 Hz poses, not continuous swept-volume proof.']))
