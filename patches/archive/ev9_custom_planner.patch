+def test_full_capability_feedforward_not_reduced_or_output_clipped():
+  p = plan(curvature=np.full(401, .05), initial_curvature=.05)
+  current = state(curvature=.05, command_curvature=.05)
+  decision = tick(TrajectoryTracker(), current, replace(p, initial_command_curvature=.05))
+  assert decision.active and decision.curvature == -.05
+  # The geometry limit is not another output cap. The existing command chain
+  # handles feedback correction; execution/clearance validation must model it.
+  tracker = TrajectoryTracker()
+  current = state(curvature=.05, pose=(0., -.1, 0.))
+  decision = tick(tracker, current, p)
+  assert decision.active and decision.curvature == pytest.approx(-.058)
