+import copy
+
+import numpy as np
+import pytest
+
+from openpilot.tools.ev9_trajectory.corridor import model_lane_corridor
+
+
+def model():
+  x = np.linspace(0, 40, 33).tolist()
+
+  def line(y):
+    return dict(x=list(x), y=[y] * len(x))
+
+  return dict(
+    position={**line(0), 'yStd': [0.1] * 33},
+    laneLines=[line(-5), line(-2), line(2), line(5)],
+    laneLineProbs=[0.9] * 4,
+    laneLineStds=[0.1] * 4,
+    roadEdges=[line(-3), line(3)],
+    roadEdgeStds=[0.1] * 2,
+  )
+
+
+def adapt(m, **kwargs):
+  return model_lane_corridor(m, model_time=1.0, now=1.1, model_valid=True, **kwargs)
+
+
+def test_geometry_uses_lane_permission_not_entire_road_and_flips_frame():
+  result = adapt(model())
+  assert result.available
+  assert not result.execution_authorized
+  assert np.all(result.left[:, 1] == 2)
+  assert np.all(result.right[:, 1] == -2)
+  assert result.left[0, 0] == 0  # No invented rear-overhang extension.
+
+
+def test_road_can_narrow_but_never_expand_lane():
+  m = model()
+  m['roadEdges'][0]['y'] = [-1.5] * 33
+  assert np.all(adapt(m).left[:, 1] == 1.5)
+
+
+@pytest.mark.parametrize('mutation', ['confidence', 'far_uncertainty', 'crossed', 'nonfinite', 'missing', 'turnback', 'coverage'])
+def test_reject_unsupported_or_uncertain_inputs(mutation):
+  m = copy.deepcopy(model())
+  if mutation == 'confidence':
+    m['laneLineProbs'][1] = 0.2
+  if mutation == 'far_uncertainty':
+    m['position']['yStd'][-1] = 1.0
+  if mutation == 'crossed':
+    m['laneLines'][1]['y'][-1] = 3.0
+  if mutation == 'nonfinite':
+    m['roadEdges'][0]['y'][10] = float('nan')
+  if mutation == 'missing':
+    del m['roadEdgeStds']
+  if mutation == 'turnback':
+    m['position']['x'][-1] = 0.0
+  if mutation == 'coverage':
+    m['position']['x'][-1] = 41.0
+  assert not adapt(m).available
+
+
+@pytest.mark.parametrize('now,valid', [(1.3, True), (0.9, True), (1.1, False), (float('nan'), True)])
+def test_stale_future_invalid(now, valid):
+  assert not model_lane_corridor(model(), model_time=1.0, now=now, model_valid=valid).available
+
+
+def test_diagnostics_exposes_all_failures_without_authorizing():
+  from openpilot.tools.ev9_trajectory.corridor import corridor_diagnostics
+
+  m = model()
+  m['roadEdgeStds'] = [0.9, 0.9]
+  m['position']['yStd'][-1] = 2.0
+  result = corridor_diagnostics(m)
+  assert result['gates']['lane_evidence']
+  assert not result['gates']['roadEdgeStds']
+  assert not result['gates']['pathStd']
+  assert result['gates']['geometry']
+  assert not result['execution_authorized']
+  assert not adapt(m).available
+
+
+def test_diagnostics_marks_zero_probabilities_not_missing_schema():
+  from openpilot.tools.ev9_trajectory.corridor import corridor_diagnostics
+
+  m = model()
+  m['laneLineProbs'] = [0.0] * 4
+  result = corridor_diagnostics(m)
+  assert result['schema']['laneLineProbs']['all_zero']
+  assert not result['gates']['laneLineProbs']
+
+
+def test_lane_only_probe_does_not_substitute_uncertain_road_boundaries():
+  from openpilot.tools.ev9_trajectory.corridor import corridor_diagnostics
+
+  m = model()
+  m['roadEdges'][0]['y'] = [5.0] * 33
+  result = corridor_diagnostics(m)
+  assert result['gates']['lane_geometry']
+  assert not result['gates']['geometry']
+  assert not result['execution_authorized']
+  assert not adapt(m).available
