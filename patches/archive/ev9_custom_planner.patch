+"""Partial-bend crawl/stop/restart lifecycle; full-turn accuracy is tested separately."""
+from dataclasses import replace
+
+import numpy as np
+import pytest
+
+from openpilot.selfdrive.controls.lib.ev9_path_input import build_path_input
+from openpilot.selfdrive.controls.lib.ev9_path_mpc import Ev9PathMpc
+from openpilot.selfdrive.controls.lib.ev9_path_planner import MODEL_GEOMETRY, ModelPathPlanner
+from openpilot.selfdrive.controls.lib.ev9_trajectory import TrajectoryTracker, path_turn_direction
+from openpilot.tools.ev9_trajectory.benchmark import Plant
+from openpilot.tools.ev9_trajectory.fixtures import Case, VM
+from openpilot.tools.ev9_trajectory.live_benchmark import ReferenceBaseline, execution_state, plant_case
+from openpilot.tools.ev9_trajectory.tests.test_model_path_planner import visible_turn
+from openpilot.tools.ev9_trajectory.tests.test_rolling_model_path import distances, recapture
+from openpilot.tools.ev9_trajectory.tests.test_rolling_model_path import library  # noqa: F401 (shared pytest fixture)
+
+
+@pytest.mark.parametrize('sign', [-1, 1])
+def test_finite_forecast_crawl_stop_restart(library, sign):  # noqa: F811
+  geometry = build_path_input(visible_turn(45, 160, sign), MODEL_GEOMETRY, source_time=0., now=0., model_valid=True)
+  case = Case('crawl-lifecycle', geometry.xy, geometry.yaw, geometry.distance, geometry.left, geometry.right,
+              np.vstack((geometry.left, geometry.right[::-1])), .4, np.zeros(3), 'synthetic')
+  plant = Plant(dict(delay=.1), .4)
+  plant.pose[0] = 12.  # Begin at the straight-to-bend transition, not an oracle future pose.
+  baseline, tracker = ReferenceBaseline(plant_case(case), .1), TrajectoryTracker()
+  planner = ModelPathPlanner(solver=Ev9PathMpc(library), clock=lambda: 0.)
+  active, pending, lease, direction = False, None, None, 0
+  adoptions, last_id, stop_start = [], 0, None
+  stopped_ticks, maximum_deviation = 0, 0.
+  try:
+    for step in range(1200):
+      now = step * .01
+      if active and stop_start is None and now > 3.:
+        stop_start = now
+      stopped = stop_start is not None and stop_start <= now < stop_start + 2.
+      plant.speed = 0. if stopped else .4
+      state = replace(execution_state(plant, now, .375), tracking_active=active, standstill=stopped)
+      command = baseline.update(plant.pose, step)
+      proposal, revoke = None, False
+      if pending is not None and now >= pending[0]:
+        decision, pending = pending[1], None
+        proposal = lease = decision.plan
+        revoke = decision.reason == 'tracking_complete'
+      if step % 5 == 0:
+        # Ten-second,33-point forecast varies its finite spatial extent. At a
+        # stop it represents predicted restart motion, not actual current speed.
+        model, reference, yaw = recapture(case, np.asarray(state.pose), .3 + .1 * np.cos(now * .1))
+        model['action'] = dict(desiredCurvature=command)
+        direction = path_turn_direction(yaw)
+        decision = planner.update(model, state, VM, model_time=now, model_pose=state.pose, now=now,
+                                  mode=2, model_valid=True, roll=0., angle_offset_deg=0.)
+        pending = (now + .02, decision)
+        if decision.plan is not None:
+          maximum_deviation = max(maximum_deviation, float(distances(decision.plan.xy, reference).max()))
+          assert np.isfinite(decision.plan.curvature).all()
+      selected = tracker.update(state, command, mode=2, proposal=proposal, revoke=revoke, model_turn_direction=direction,
+                                corridor_revision=lease.corridor_revision if lease else 0,
+                                corridor_valid_until=lease.valid_until if lease else 0.)
+      active = selected.active
+      if active and selected.plan_id != last_id:
+        adoptions.append((now, tracker.plan.source_time))
+        last_id = selected.plan_id
+      if stopped:
+        stopped_ticks += 1
+        assert not active and selected.curvature == command
+        assert tracker.plan is None
+        # Existing standstill engagement path holds the wheel; this test checks
+        # that the trajectory layer does not add a stopped steering command.
+      else:
+        plant.step(selected.curvature)
+  finally:
+    planner.close()
+  assert stop_start is not None and stopped_ticks >= 199
+  assert any(t < stop_start for t, _ in adoptions)
+  restarted = [(t, source) for t, source in adoptions if t >= stop_start + 2.]
+  assert restarted and all(source >= stop_start + 2. for _, source in restarted)
+  assert plant.maxangle <= 140.00001 and np.isfinite(plant.pose).all()
+  assert maximum_deviation <= 1.00001
