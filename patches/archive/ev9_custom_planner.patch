@@ -0,0 +1,121 @@
+"""Full production steering-chain execution with explicitly synthetic plant inputs."""
+from dataclasses import replace
+import math
+
+import pytest
+
+from opendbc.car import gen_empty_fingerprint
+from opendbc.car.hyundai.interface import CarInterface
+from opendbc.car.hyundai.values import CAR, HyundaiFlags
+from openpilot.selfdrive.controls.lib.ev9_trajectory import ExecutionState, TrajectoryPlan
+from openpilot.tools.ev9_trajectory.execution import PlanningCorridor
+from openpilot.tools.ev9_trajectory.execution import (
+  ControllerSnapshot, ExecutionConfiguration, ExecutionResult, SensorMapping, validate_execution,
+)
+from openpilot.tools.ev9_trajectory.fixtures import VM, fixture
+from openpilot.tools.ev9_trajectory.optimizer import DEFAULT_FOOTPRINT, solve_trajectory
+
+
+@pytest.fixture(scope='module')
+def scenario():
+  case = fixture(145., 7.)
+  limit = abs(VM.calc_curvature(math.radians(140), case.speed, 0.))
+  rate = abs(VM.calc_curvature(math.radians(100), case.speed, 0.))
+  trajectory = solve_trajectory(case.reference, case.left, case.right, case.speed, case.initial_pose, 0., limit, rate)
+  assert trajectory.feasible
+  state = ExecutionState(10., (0., 0., 0.), case.speed, 0., 0., 0., .325)
+  plan = TrajectoryPlan(1, 0, 10., 10. + (trajectory.distance[-1] + 20) / case.speed,
+                        (0., 0., 0.), case.speed, 0., 0., -limit, limit,
+                        trajectory.distance, trajectory.xy, trajectory.yaw, trajectory.curvature, 1)
+  corridor = PlanningCorridor(1, 10., 10.2, (0., 0., 0.), case.reference, case.left, case.right, DEFAULT_FOOTPRINT, True, True, True)
+  return plan, state, corridor
+
+
+def configuration(direct):
+  cp = CarInterface.get_params(CAR.KIA_EV9, gen_empty_fingerprint(), [], direct, False, False, None)
+  cp.flags = int(cp.flags | HyundaiFlags.CANFD_LKA_STEERING | HyundaiFlags.CANFD_LKA_STEERING_ALT)
+  cp.openpilotLongitudinalControl = direct
+  cp_bytes = cp.to_bytes()
+  return ExecutionConfiguration(cp_bytes, cp_bytes, cp.steerRatio, 1., 0., 0., SensorMapping(0., 1., 0., 1., 0.),
+                                ControllerSnapshot(0., 0., 0., 1., 1., 100, True, False, (0.,) * 5),
+                                direct, .05, 500., .325, DEFAULT_FOOTPRINT, 0, 40., 'synthetic_explicit')
+
+
+@pytest.mark.parametrize('direct', [False, True])
+def test_actual_controller_full_turn_both_transports(scenario, direct):
+  result = validate_execution(*scenario, configuration(direct))
+  assert result.feasible, (result.reason, result.metrics)
+  assert not result.authorizes_execution
+  assert result.metrics['body_clear']
+  assert result.metrics['reason_counts']['complete'] > 0
+  assert result.metrics['steering_can_frames'] > 1000
+  assert result.metrics['max_wheel_angle_deg'] <= 140
+  if direct:
+    assert result.metrics['max_filter_angle_deg'] <= 140.001
+
+
+@pytest.mark.parametrize('fault', ['missing', 'onroad', 'history', 'manual', 'snapshot_manual', 'mapping', 'filter', 'sensor_state', 'uninitialized'])
+def test_missing_or_unvalidated_assumptions_do_not_authorize(scenario, fault):
+  plan, state, corridor = scenario
+  cfg = configuration(False)
+  if fault == 'missing':
+    cfg = None
+  elif fault == 'onroad':
+    cfg = replace(cfg, provenance='onroad')
+  elif fault == 'history':
+    cfg = replace(cfg, snapshot=replace(cfg.snapshot, in_flight_physical_targets_deg=()))
+  elif fault == 'manual':
+    state = replace(state, manual=True)
+  elif fault == 'snapshot_manual':
+    cfg = replace(cfg, snapshot=replace(cfg.snapshot, manual_latched=True))
+  elif fault == 'filter':
+    cfg = replace(cfg, snapshot=replace(cfg.snapshot, filter_angle_deg=math.nan))
+  elif fault == 'sensor_state':
+    state = replace(state, wheel_angle_deg=10.)
+  elif fault == 'mapping':
+    cfg = replace(cfg, sensors=replace(cfg.sensors, mdps1_scale=0))
+  else:
+    cfg = replace(cfg, snapshot=replace(cfg.snapshot, transport_initialized=False))
+  result = validate_execution(plan, state, corridor, cfg)
+  assert not result.feasible and not result.authorizes_execution
+  assert len(result.poses) == 0
+
+
+def test_result_cannot_accidentally_be_a_permission_boolean():
+  with pytest.raises(TypeError, match='permission'):
+    bool(ExecutionResult(True, 'synthetic_feasible'))
+
+
+
+def test_insufficient_physical_slew_fails_despite_geometric_feasibility(scenario):
+  result = validate_execution(*scenario, replace(configuration(False), physical_rate_deg_s=1.))
+  assert not result.feasible
+  assert result.reason == 'tracker_tracking_error'
+  assert len(result.poses) > 100
+
+
+def test_claimed_fresh_controller_snapshot_must_match_explicit_initial_state(scenario):
+  plan, state, corridor = scenario
+  state = replace(state, angle_state_valid=True, angle_state_mono_time=10_000_000_000, angle_filter_state_deg=50.)
+  result = validate_execution(plan, state, corridor, configuration(False))
+  assert not result.feasible and result.reason == 'initial_controller_snapshot_mismatch'
+
+
+def test_reference_execution_has_distinct_completion_and_no_permission(scenario):
+  from openpilot.tools.ev9_trajectory.execution import validate_reference_execution
+
+  _, state, corridor = scenario
+  result = validate_reference_execution(state, corridor, configuration(False))
+  assert result.feasible and result.reason == 'synthetic_reference_feasible'
+  assert result.metrics['policy'] == 'reference_feedback'
+  assert result.metrics['completed'] and not result.metrics['tracker_completed']
+  assert not result.authorizes_execution
+  with pytest.raises(TypeError, match='permission'):
+    bool(result)
+
+
+
+def test_missing_candidate_does_not_silently_select_reference_policy(scenario):
+  _, state, corridor = scenario
+  result = validate_execution(None, state, corridor, configuration(False))
+  assert not result.feasible and result.reason == 'missing_candidate_plan'
