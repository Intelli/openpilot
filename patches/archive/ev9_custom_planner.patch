+"""Whole-turn acceptance, rather than checking optimizer-internal residuals."""
+
+import math
+
+import numpy as np
+import pytest
+
+from openpilot.tools.ev9_trajectory.fixtures import VM, fixture
+from openpilot.tools.ev9_trajectory.optimizer import VehicleFootprint, body_inside_corridor, solve_trajectory
+from openpilot.tools.ev9_trajectory.tests.validation import evaluate, inside_polygon
+
+
+def solve(case):
+  max_curvature = abs(VM.calc_curvature(math.radians(140), case.speed, 0.0))
+  max_rate = abs(VM.calc_curvature(math.radians(100), case.speed, 0.0))
+  return solve_trajectory(case.reference, case.left, case.right, case.speed, case.initial_pose, 0.0, max_curvature, max_rate)
+
+
+@pytest.mark.parametrize('sign', [-1, 1])
+@pytest.mark.parametrize('heading', [-2.0, 2.0])
+@pytest.mark.parametrize('demand', [145.0, 160.0])
+def test_complete_wide_turn_reaches_exit_with_body_clearance(sign, heading, demand):
+  case = fixture(demand=demand, width=7.0, sign=sign, initial_heading_deg=heading)
+  before = evaluate(case, case.reference, case.yaw)
+  assert before['max_angle_deg'] > 140.1
+  result = solve(case)
+  assert result.feasible, result.reason
+  checked = evaluate(case, result.xy, result.yaw)
+  assert checked['accepted'], checked
+  assert checked['max_angle_rate_deg_s'] <= 100.1
+  assert abs(math.degrees(result.yaw[-1]) - sign * 90.0) < 0.1
+  # The complete exit is essential: a locally plausible short arc is insufficient.
+  assert checked['terminal_position_error_m'] <= 0.2
+  assert checked['body_violation_station_count'] == 0
+  # A wider same-direction turn must not be manufactured by an opposite entry/exit swing.
+  outside_initial_recovery = result.distance > 1.0
+  assert np.min(sign * result.curvature[outside_initial_recovery]) >= -1e-6
+
+
+@pytest.mark.parametrize('sign', [-1, 1])
+def test_initially_feasible_reference_remains_feasible(sign):
+  case = fixture(demand=100.0, width=5.0, sign=sign)
+  assert evaluate(case, case.reference, case.yaw)['accepted']
+  result = solve(case)
+  assert result.feasible
+  assert evaluate(case, result.xy, result.yaw)['accepted']
+
+
+@pytest.mark.parametrize('demand,width,uncovered', [(180.0, 3.0, False), (220.0, 3.0, False), (100.0, 2.2, False), (100.0, 5.0, True)])
+def test_no_trajectory_claim_for_insufficient_road(demand, width, uncovered):
+  case = fixture(demand=demand, width=width, uncovered=uncovered)
+  result = solve(case)
+  assert not result.feasible
+  assert result.reason
+
+
+@pytest.mark.parametrize('invalid', [float('nan'), float('inf')])
+def test_invalid_geometry_fails_closed(invalid):
+  case = fixture()
+  case.reference[10, 1] = invalid
+  result = solve(case)
+  assert not result.feasible
+
+
+def test_independent_check_rejects_truncated_exit_and_forged_heading():
+  case = fixture()
+  assert not evaluate(case, case.reference[:-60], case.yaw[:-60])['accepted']
+  assert not evaluate(case, case.reference, np.zeros_like(case.yaw))['accepted']
+
+
+def test_crossing_boundary_polygon_is_rejected():
+  case = fixture()
+  # Fold a boundary across itself, despite otherwise valid reference geometry.
+  case.left[10:30] = case.left[10:30][::-1]
+  result = solve(case)
+  assert not result.feasible
+
+
+def test_concave_notch_between_vehicle_corners_rejects_body():
+  polygon = np.array([[-3.0, -3.0], [3.0, -3.0], [3.0, 3.0], [0.2, 3.0], [0.2, 0.0], [-0.2, 0.0], [-0.2, 3.0], [-3.0, 3.0]])
+  footprint = VehicleFootprint(front=1.0, rear=1.0, half_width=1.0, margin=0.08)
+  corners = np.array([[-1.08, -1.08], [1.08, -1.08], [1.08, 1.08], [-1.08, 1.08]])
+  assert inside_polygon(corners, polygon).all()
+  # The top edge crosses the narrow notch even though every corner is inside.
+  assert not body_inside_corridor(np.array([[0.0, 0.0]]), np.array([0.0]), footprint, polygon)
+  assert body_inside_corridor(np.array([[0.0, -1.5]]), np.array([0.0]), footprint, polygon)
+
+
+def test_s_reference_is_rejected_when_only_same_direction_turns_are_supported():
+  # A genuine sign reversal, not a small heading-estimation perturbation.
+  arc = np.linspace(0.0, 50.0, 251)
+  curvature = 0.045 * np.sin(2 * np.pi * arc / arc[-1])
+  from openpilot.tools.ev9_trajectory.fixtures import integrate
+
+  reference, yaw = integrate(arc, curvature)
+  normals = np.column_stack((-np.sin(yaw), np.cos(yaw)))
+  center = np.vstack(([-6.0, 0.0], reference, reference[-1] + [6.0, 0.0]))
+  normals = np.vstack(([0.0, 1.0], normals, [0.0, 1.0]))
+  limit = abs(VM.calc_curvature(math.radians(140), 2.0, 0.0))
+  rate = abs(VM.calc_curvature(math.radians(100), 2.0, 0.0))
+  result = solve_trajectory(reference, center + 3.5 * normals, center - 3.5 * normals, 2.0, np.array([0.0, 0.0, 0.0]), 0.0, limit, rate)
+  assert not result.feasible
+  assert result.reason == "unsupported_multiple_turn_directions"
