@@ -0,0 +1,73 @@
+"""Exercise publication cadence and capture-time alignment with real messaging."""
+from types import SimpleNamespace
+
+import pytest
+
+from openpilot.selfdrive.controls.ev9_trajectoryd import run
+from openpilot.selfdrive.controls.lib.ev9_path_planner import PathPlanningDecision
+from openpilot.tools.ev9_trajectory.fixtures import PARAMS
+
+
+@pytest.mark.parametrize('mode', [0, 1, 2])
+@pytest.mark.parametrize('capture_source', ['history', 'atomic', 'mismatch'])
+def test_capture_pose_and_no_plan_renewal_between_models(mode, capture_source):
+  cp = SimpleNamespace(**PARAMS)
+  msg = SimpleNamespace(sourceMonoTime=0, steerRatio=cp.steerRatio, tireStiffnessFront=cp.tireStiffnessFront,
+                        tireStiffnessRear=cp.tireStiffnessRear, angleOffsetDeg=0., roll=0.,
+                        x=0., y=0., yaw=0., speed=2., wheelAngleDeg=0., curvature=0., commandCurvature=0.,
+                        delay=.3, generation=7, enabled=True, manual=False, laneChange=False, drive=True, healthy=True, active=False)
+  if capture_source != 'history':
+    msg.modelCapturePoseValid = True
+    msg.modelCaptureMonoTime = 1_005_000_000 if capture_source == 'atomic' else 1_006_000_000
+    msg.modelCaptureX, msg.modelCaptureY, msg.modelCaptureYaw = .123, 0., 0.
+  calls, sent = [], []
+
+  class Planner:
+    closed = False
+    resets = 0
+
+    def reset(self):
+      self.resets += 1
+
+    def update(self, model, state, vm, **kwargs):
+      calls.append((state.time, kwargs))
+      return PathPlanningDecision('reference_within_capability')
+
+    def close(self):
+      self.closed = True
+
+  class Messages(dict):
+    def __init__(self):
+      super().__init__(modelV2=SimpleNamespace(timestampEof=1_005_000_000), ev9TrajectoryState=msg)
+      self.tick, self.now = 0, 1.
+
+    def update(self, timeout):
+      if self.tick == 6:
+        raise StopIteration
+      self.now = 1. + .01 * self.tick
+      msg.sourceMonoTime = int(self.now * 1e9)
+      msg.x = (self.now - 1.) * 2
+      msg.manual = self.tick < 2 or self.tick >= 4
+      self.updated = dict(modelV2=self.tick == 2, ev9TrajectoryState=True)
+      self.logMonoTime = dict(modelV2=1_020_000_000, ev9TrajectoryState=msg.sourceMonoTime)
+      self.tick += 1
+
+    def all_checks(self, services):
+      return True
+
+  sm, planner = Messages(), Planner()
+  pm = SimpleNamespace(send=lambda _, value: sent.append((sm.now, value.ev9TrajectoryPlan.to_dict())))
+  with pytest.raises(StopIteration):
+    run(cp, SimpleNamespace(get=lambda _: str(mode)), sm, pm, planner=planner, clock=lambda: sm.now)
+  assert planner.closed
+  if mode == 0:
+    assert not sent and not calls
+    assert planner.resets == 6
+  else:
+    assert planner.resets == 4
+    assert len(calls) == 1
+    assert calls[0][1]['model_time'] == 1.005
+    assert calls[0][1]['model_pose'] == pytest.approx((.123 if capture_source == 'atomic' else .01, 0., 0.))
+    assert [time for time, _ in sent] == [1.0, 1.02, 1.04]
+    assert sent[-1][1]['reason'] == 'invalid_execution_state'
+    assert all(x['corridorValidUntilMonoTime'] == 0 for _, x in sent)
