+      if np.any(middle <= 1e-9):
+        return False
+      p, q = np.vstack((p, midpoint)), np.vstack((midpoint, q))
+      h, k = np.r_[h, heading], np.r_[heading, h+angle]
+      ca, cb = np.r_[ca, middle], np.r_[middle, cb]
