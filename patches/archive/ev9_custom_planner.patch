+def test_valid_replacement_atomically_adopts_its_own_lease():
+  tracker = TrajectoryTracker()
+  assert tick(tracker, proposal=plan(valid_until=1.2)).active
+  replacement = plan(1.1, plan_id=2, corridor_revision=2, valid_until=1.35)
