+"""Descriptive corridor coverage from local full logs; never a clearance certificate."""
+
+import argparse
+from collections import Counter
+import json
+import math
+from pathlib import Path
+
+import numpy as np
+
+
+def path_coverage(position):
+  """Return full arc and contiguous confident arc; missing/invalid input is rejected."""
+  try:
+    x, y, std = (np.asarray(position[name], dtype=float) for name in ('x', 'y', 'yStd'))
+  except (KeyError, TypeError, ValueError):
+    return None
+  if x.ndim != 1 or len(x) < 2 or x.shape != y.shape or x.shape != std.shape:
+    return None
+  if not np.isfinite(np.r_[x, y, std]).all() or np.any(std < 0):
+    return None
+  steps = np.hypot(np.diff(x), np.diff(y))
+  if np.any(steps <= 0):
+    return None
+  arc = np.r_[0.0, np.cumsum(steps)]
+  bad = np.flatnonzero(std > 0.3)
+  end = int(bad[0]) if len(bad) else len(x)
+  return float(arc[-1]), float(arc[end - 1]) if end else 0.0
+
+
+def confidence_pair(values, indexes, probability=False):
+  try:
+    selected = [float(values[i]) for i in indexes]
+  except (IndexError, KeyError, TypeError, ValueError):
+    return None
+  if not all(math.isfinite(v) and v >= 0 and (not probability or v <= 1) for v in selected):
+    return None
+  return min(selected) if probability else max(selected)
+
+
+def summarize(events):
+  """Events: (monotonic nanoseconds, service, valid, dictionary). Sort before causal joining.
+
+  Call separately for each route: monotonic clocks from unrelated boots cannot be joined.
+  Equal timestamps preserve recording order; only already-seen samples are used.
+  """
+  events = sorted(events, key=lambda event: event[0])
+  latest, counts = {}, Counter()
+  arcs, prefixes, lanes, edges = [], [], [], []
+  for mono, service, valid, data in events:
+    if service in ('carState', 'carControl'):
+      latest[service] = (mono, valid, data)
+      continue
+    if service != 'modelV2':
+      continue
+    counts['model_frames'] += 1
+    if not valid:
+      counts['invalid_model_frames'] += 1
+      continue
+    if any(k not in latest for k in ('carState', 'carControl')):
+      counts['missing_preceding_state_or_control'] += 1
+      continue
+    if any(not latest[k][1] or not 0 <= (mono - latest[k][0]) / 1e9 <= 0.25 for k in latest):
+      counts['invalid_or_stale_preceding_state_or_control'] += 1
+      continue
+    cs, cc = latest['carState'][2], latest['carControl'][2]
+    try:
+      speed, angle = float(cs['vEgo']), float(cs['steeringAngleDeg'])
+    except (KeyError, TypeError, ValueError):
+      counts['invalid_state_values'] += 1
+      continue
+    if not math.isfinite(speed) or not math.isfinite(angle):
+      counts['invalid_state_values'] += 1
+      continue
+    counts['causal_valid_frames'] += 1
+    if not (0.5 <= speed <= 7 and abs(angle) >= 90):
+      continue
+    counts['sharp_frames'] += 1
+    counts['sharp_lat_active_frames'] += bool(cc.get('latActive', False))
+    counts['sharp_steering_pressed_frames'] += bool(cs.get('steeringPressed', False))
+    coverage = path_coverage(data.get('position', {}))
+    if coverage is None:
+      counts['sharp_invalid_path_frames'] += 1
+    else:
+      arcs.append(coverage[0])
+      prefixes.append(coverage[1])
+    lane = confidence_pair(data.get('laneLineProbs', []), (1, 2), probability=True)
+    edge = confidence_pair(data.get('roadEdgeStds', []), (0, 1))
+    if lane is not None:
+      lanes.append(lane)
+      counts['sharp_both_inner_lane_prob_ge_0_5'] += lane >= 0.5
+    else:
+      counts['sharp_invalid_lane_confidence_frames'] += 1
+    if edge is not None:
+      edges.append(edge)
+      counts['sharp_both_edge_std_le_0_5'] += edge <= 0.5
+    else:
+      counts['sharp_invalid_edge_confidence_frames'] += 1
+    counts['sharp_both_descriptive_thresholds'] += lane is not None and edge is not None and lane >= 0.5 and edge <= 0.5
+
+  def stats(values):
+    return dict(count=len(values), median=float(np.median(values)), minimum=min(values), maximum=max(values)) if values else dict(count=0)
+
+  return dict(
+    counts=dict(counts),
+    sharp_path_arc_m=stats(arcs),
+    sharp_confident_prefix_arc_m=stats(prefixes),
+    sharp_weaker_inner_lane_probability=stats(lanes),
+    sharp_worse_edge_std=stats(edges),
+  )
+
+
+def read_events(paths):
+  # Import only during log reading; pure helpers need no native messaging/Params.
+  import zstandard
+  from cereal import log
+
+  events = []
+  seen = set()
+  for path in paths:
+    with path.open('rb') as source, zstandard.ZstdDecompressor().stream_reader(source) as stream:
+      data = stream.read()
+    for event in log.Event.read_multiple_bytes(data):
+      service = event.which()
+      if service not in ('modelV2', 'carState', 'carControl'):
+        continue
+      key = (int(event.logMonoTime), service)
+      if key in seen:
+        continue  # Repeated segment initialization/overlap is counted once.
+      seen.add(key)
+      value = getattr(event, service)
+      if service == 'modelV2':
+        payload = dict(position=value.position.to_dict(), laneLineProbs=list(value.laneLineProbs), roadEdgeStds=list(value.roadEdgeStds))
+      elif service == 'carState':
+        payload = dict(vEgo=value.vEgo, steeringAngleDeg=value.steeringAngleDeg, steeringPressed=value.steeringPressed)
+      else:
+        payload = dict(latActive=value.latActive)
+      events.append((int(event.logMonoTime), service, bool(event.valid), payload))
+  return events
+
+
+def main():
+  parser = argparse.ArgumentParser(description=__doc__)
+  parser.add_argument(
+    '--route', nargs='+', type=Path, action='append', required=True, help='Files belonging to ONE route/monotonic clock. Repeat --route for separate routes.'
+  )
+  parser.add_argument('--output', type=Path, help='Optional aggregate JSON output; raw identities/paths are omitted.')
+  args = parser.parse_args()
+  reports = [summarize(read_events(paths)) for paths in args.route]
+  result = dict(
+    scope='Descriptive confidence/path coverage only; not road clearance, feasibility, or safe-driving qualification. '
+    + 'Sharp frames include manual steering. Each route is sorted/joined separately with preceding valid samples <=250ms old.',
+    routes=reports,
+  )
+  text = json.dumps(result, indent=2, allow_nan=False) + '\n'
+  if args.output:
+    args.output.write_text(text)
+  print(text, end='')
+
+
+if __name__ == '__main__':
+  main()
