@@ -0,0 +1,203 @@
+"""Offline paired full-turn tracking benchmark; no production control callers.
+
+Run: python -m openpilot.tools.ev9_trajectory.benchmark --output result.json
+This deterministic geometric tracker is not the learned model or a real vehicle.
+"""
+
+import argparse
+from collections import deque
+from concurrent.futures import ProcessPoolExecutor
+import inspect
+import hashlib
+import json
+import math
+from pathlib import Path
+import time
+from types import SimpleNamespace
+
+import numpy as np
+from opendbc.car.vehicle_model import VehicleModel
+from opendbc.car.lateral import AngleSteeringLimits, apply_steer_angle_limits_vm, get_max_angle_delta_vm, get_max_angle_vm
+from openpilot.common.filter_simple import FirstOrderFilter
+from openpilot.selfdrive.controls.lib.drive_helpers import clip_curvature
+from openpilot.tools.ev9_trajectory.fixtures import PARAMS, VM, FRONT, REAR, HALF_WIDTH, fixture
+from openpilot.tools.ev9_trajectory.optimizer import solve_trajectory, inside_polygon
+
+
+def parameters(ratio=None):
+  return SimpleNamespace(**{**PARAMS, 'steerRatio': PARAMS['steerRatio'] if ratio is None else ratio})
+
+
+class Plant:
+  """Independent chain uses actual production curvature/angle/filter helpers."""
+
+  def __init__(self, case, speed):
+    self.speed = speed
+    self.limit_speed_mps = case.get('limit_speed_mps', 9.0)
+    self.vm = VehicleModel(parameters(PARAMS['steerRatio'] * case.get('actual_ratio_scale', 1)))
+    self.learned = VehicleModel(parameters())
+    self.nominal = VehicleModel(parameters())
+    self.curvature = 0.0
+    self.angle = self.last = case.get('initial_angle', 0.0)
+    self.filter = FirstOrderFilter(self.angle, 0.2, 0.01)
+    self.params = SimpleNamespace(STEER_STEP=1, ANGLE_LIMITS=AngleSteeringLimits(360.0, ([], []), ([], []), 4.2, 4.2, 5.0))
+    self.queue = deque([self.angle] * int(math.ceil(case['delay'] / 0.01)))
+    self.pose = np.array([0.0, case.get('initial_y', 0.0), math.radians(case.get('initial_heading_deg', 0.0))])
+    self.maxangle = abs(self.angle)
+
+  def step(self, target):
+    speed = self.speed
+    self.curvature, _ = clip_curvature(speed, self.curvature, target, 0.0, ev9_angle_limit_speed_mps=self.limit_speed_mps)
+    desired = np.clip(math.degrees(self.learned.get_steer_from_curvature(-self.curvature, speed, 0.0)), -360, 360)
+    self.filter.update_alpha(float(np.interp(speed, [5, 10, 20], [0.2, 0.1, 0])))
+    filtered = self.filter.update(desired)
+    applied = apply_steer_angle_limits_vm(filtered, self.last, speed, self.angle, True, self.params, self.nominal)
+    sv = max(speed - 1, 1)
+    delta = min(5.0, get_max_angle_delta_vm(sv, self.nominal, self.params))
+    absolute = get_max_angle_vm(sv, self.nominal, self.params)
+    self.last = float(np.clip(applied, max(-absolute, self.last - delta), min(absolute, self.last + delta)))
+    # The experimental plant has only 140-degree autonomous wheel authority;
+    # Initial measured angles may exceed it and recover at the physical slew limit.
+    physical_target = float(np.clip(self.last, -140, 140))
+    self.queue.append(physical_target)
+    delayed = self.queue.popleft()
+    self.angle += float(np.clip(delayed - self.angle, -5.0, 5.0))
+    self.maxangle = max(self.maxangle, abs(self.angle))
+    yaw = -self.vm.calc_curvature(math.radians(self.angle), speed, 0.0) * speed * 0.01
+    self.pose[:2] += speed * 0.01 * np.array([math.cos(self.pose[2] + yaw / 2), math.sin(self.pose[2] + yaw / 2)])
+    self.pose[2] += yaw
+
+
+def track(case, xy, yaw, arc, curvature, ratio, delay):
+  plant = Plant(dict(actual_ratio_scale=ratio, delay=delay, initial_heading_deg=math.degrees(case.initial_pose[2])), case.speed)
+  nearest = 0
+  poses = []
+  errors = []
+  commands = []
+  completed = False
+  # Fixed gains across every arm and case; preview compensates nominal hardware
+  # delay and first-order filter. This is a reference feedback controller, not
+  # the learned model's action policy. Feedback is not artificially angle capped.
+  preview = case.speed * (delay + 0.2 + 0.075)
+  tangent_end = np.array([math.cos(yaw[-1]), math.sin(yaw[-1])])
+  for step in range(int((arc[-1] + 20) / case.speed / 0.01)):
+    if step % 5 == 0:
+      lo = max(0, nearest - 8)
+      hi = min(len(xy), nearest + 120)
+      nearest = lo + int(np.argmin(np.sum((xy[lo:hi] - plant.pose[:2]) ** 2, axis=1)))
+      h = yaw[nearest]
+      normal = np.array([-math.sin(h), math.cos(h)])
+      lateral = float((plant.pose[:2] - xy[nearest]) @ normal)
+      heading = math.atan2(math.sin(plant.pose[2] - h), math.cos(plant.pose[2] - h))
+      target = float(np.interp(arc[nearest] + preview, arc, curvature)) - 0.08 * lateral - 0.5 * heading
+      commands.append(target)
+    plant.step(target)
+    if step % 10 == 0:
+      poses.append(plant.pose.copy())
+      errors.append(float(np.linalg.norm(plant.pose[:2] - xy[nearest])))
+    if (plant.pose[:2] - xy[-1]) @ tangent_end >= 0 and nearest > len(xy) * 0.8:
+      completed = True
+      break
+  poses = np.array(poses)
+  local = np.array([(a, b) for a in np.linspace(-REAR, FRONT, 12) for b in np.linspace(-HALF_WIDTH, HALF_WIDTH, 7)])
+  c = np.cos(poses[:, 2, None])
+  s = np.sin(poses[:, 2, None])
+  body = np.stack((poses[:, 0, None] + c * local[:, 0] - s * local[:, 1], poses[:, 1, None] + s * local[:, 0] + c * local[:, 1]), axis=-1)
+  inside = inside_polygon(body.reshape(-1, 2), case.polygon).reshape(len(poses), -1)
+  terminal = float(np.linalg.norm(plant.pose[:2] - case.reference[-1]))
+  heading = abs(math.degrees(plant.pose[2] - case.yaw[-1]))
+  return dict(
+    completed=completed,
+    terminal_position_error_m=terminal,
+    terminal_heading_error_deg=heading,
+    sampled_body_violation_poses=int(np.count_nonzero(~inside.all(axis=1))),
+    sampled_poses=len(poses),
+    max_tracking_error_m=max(errors),
+    max_wheel_angle_deg=plant.maxangle,
+    max_requested_angle_deg=max(abs(math.degrees(plant.learned.get_steer_from_curvature(-k, case.speed, 0))) for k in commands),
+    success=bool(completed and terminal <= 0.2 and heading <= 1 and inside.all()),
+  )
+
+
+def run_case(args):
+  case, uncertainty = args
+  scale = 1.0 + uncertainty
+  max_curvature = abs(VM.calc_curvature(math.radians(140), case.speed, 0)) / scale
+  max_rate = abs(VM.calc_curvature(math.radians(100), case.speed, 0)) / scale
+  plan = solve_trajectory(case.reference, case.left, case.right, case.speed, case.initial_pose, 0.0, max_curvature, max_rate)
+  row = dict(case=case.name, feasible=plan.feasible, reason=plan.reason, solve_time=plan.solve_time, diagnostics=plan.diagnostics, pairs=[])
+  for ratio in [0.9, 1.0, 1.1]:
+    for delay in [0.05, 0.3]:
+      original = track(case, case.reference, case.yaw, case.arc, np.gradient(case.yaw, case.arc), ratio, delay)
+      candidate = track(case, plan.xy, plan.yaw, plan.distance, plan.curvature, ratio, delay) if plan.feasible else None
+      row['pairs'].append(dict(actual_ratio_scale=ratio, hardware_delay_s=delay, original=original, candidate=candidate))
+  return row
+
+
+def benchmark(uncertainty=0.1, workers=2):
+  if not math.isfinite(uncertainty) or not 0 <= uncertainty < 1 or workers < 1:
+    raise ValueError('uncertainty must be in [0,1); workers must be positive')
+  start = time.perf_counter()
+  cases = [
+    fixture(demand, width, sign, heading) for demand, width in [(100, 5), (135, 5), (145, 7), (160, 7)] for sign in [-1, 1] for heading in [-2.0, 0.0, 2.0]
+  ]
+  with ProcessPoolExecutor(max_workers=workers) as pool:
+    rows = list(pool.map(run_case, [(case, uncertainty) for case in cases]))
+  pairs = [p for row in rows for p in row['pairs']]
+  available = [p for p in pairs if p['candidate'] is not None]
+  summary = dict(
+    geometry_cases=len(rows),
+    geometry_feasible=sum(r['feasible'] for r in rows),
+    geometry_rejected=sum(not r['feasible'] for r in rows),
+    pairs=len(pairs),
+    candidate_pairs=len(available),
+    original_success=sum(p['original']['success'] for p in pairs),
+    candidate_success=sum(p['candidate']['success'] for p in available),
+    new_success=sum(p['candidate']['success'] and not p['original']['success'] for p in available),
+    lost_success=sum(p['original']['success'] and not p['candidate']['success'] for p in available),
+    original_body_violations=sum(p['original']['sampled_body_violation_poses'] > 0 for p in pairs),
+    candidate_body_violations=sum(p['candidate']['sampled_body_violation_poses'] > 0 for p in available),
+    wall_s=time.perf_counter() - start,
+  )
+  provenance = dict(
+    parameters=PARAMS,
+    planning_ratio_uncertainty=uncertainty,
+    execution_ratio_scales=[0.9, 1.0, 1.1],
+    hardware_delays_s=[0.05, 0.3],
+    speed_mps=2.0,
+    physical_authority_deg=140.0,
+    target_angle_limit_deg=360.0,
+    planning_angle_rate_deg_s=100.0,
+    tracker_lateral_gain=0.08,
+    tracker_heading_gain=0.5,
+    tracker_preview='speed*(known hardware delay + .2 filter RC + .075)',
+    clip_curvature_sha256=hashlib.sha256(inspect.getsource(clip_curvature).encode()).hexdigest(),
+    assumptions=[
+      'Synthetic full90deg turn,12m approach,10m exit; obstacle-free corridor supplied by fixture',
+      'Single-turn planning preserves turn direction; these fixtures start at zero curvature, so no opposite-turn recovery is needed',
+      'Planning ratio uncertainty is an assumed test envelope, not a measured calibration guarantee',
+      'Known initial heading and hardware delay; nominal ratio estimate16; only actual ratio perturbed',
+      'Assumed rear-axle footprint front4.2/rear.9/halfwidth1.1; not verified physical dimensions',
+      'Fixed geometric tracker, actual software filter/jerk/rate helpers, experimental physical140degree authority',
+      'Success: complete goal crossing, endpoint<=.2m, heading<=1degree, sampled fullbody inside corridor',
+      'Body grid12x7 checked every.1s; not continuous swept-volume proof',
+      'No tire dynamics, perception uncertainty, learned-policy replication or on-road validation',
+      'Rejected plans remain absent, not counted as successful fallback; lost_success counts only available candidates',
+    ],
+  )
+  return dict(summary=summary, provenance=provenance, cases=rows)
+
+
+def main():
+  parser = argparse.ArgumentParser(description=__doc__)
+  parser.add_argument('--output', type=Path, required=True)
+  parser.add_argument('--ratio-uncertainty', type=float, default=0.1)
+  parser.add_argument('--workers', type=int, default=2)
+  args = parser.parse_args()
+  result = benchmark(args.ratio_uncertainty, args.workers)
+  args.output.write_text(json.dumps(result, indent=2) + '\n')
+  print(json.dumps(result['summary'], indent=2))
+
+
+if __name__ == '__main__':
+  main()
