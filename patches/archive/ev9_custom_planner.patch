+  assert tick(tracker, proposal=plan()).active
+  decision = tracker.update(state(1.01), .023, mode=2, corridor_revision=1, corridor_valid_until=1.0)
+  assert decision.reason == 'corridor_unavailable' and decision.curvature == .023
