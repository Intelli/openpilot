+def turning_plan(direction=1, **kwargs):
+  original = plan(**kwargs)
+  # Smooth curve starts with zero curvature and ends with clear spatial intent.
+  curvature = direction * .02 * np.minimum(original.distance / 5., 1.)
+  yaw = np.r_[0., np.cumsum((curvature[1:] + curvature[:-1]) * .025)]
+  xy = np.column_stack((np.r_[0., np.cumsum(np.cos(yaw[:-1]) * .05)],
+                        np.r_[0., np.cumsum(np.sin(yaw[:-1]) * .05)]))
+  return replace(original, xy=xy, yaw=yaw, curvature=curvature)
+
