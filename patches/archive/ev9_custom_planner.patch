+"""Keep the experiment's physical authority separate from command clipping."""
+
+import math
+
+import pytest
+
+from openpilot.tools.ev9_trajectory.benchmark import Plant, benchmark
+
+
+@pytest.mark.parametrize('sign', [-1.0, 1.0])
+def test_command_above_authority_is_not_capped_before_filter(sign):
+  plant = Plant({'delay': 0.05}, 2.0)
+  requested = -plant.learned.calc_curvature(math.radians(sign * 200.0), 2.0, 0.0)
+  for _ in range(200):
+    plant.step(requested)
+  assert abs(plant.filter.x) > 190.0
+  assert abs(plant.last) > 190.0
+  assert abs(plant.angle) == pytest.approx(140.0)
+  assert plant.maxangle <= 140.0
+
+
+@pytest.mark.parametrize('uncertainty,workers', [(-0.1, 2), (1.0, 2), (float('nan'), 2), (0.1, 0)])
+def test_invalid_benchmark_configuration(uncertainty, workers):
+  with pytest.raises(ValueError):
+    benchmark(uncertainty, workers)
