+  assert np.max(result.curvature) <= args['curvature_limit'] + 1e-6
+  assert np.min(sign * result.curvature) >= -1e-6
+  assert np.max(np.abs(np.diff(result.curvature)/np.diff(result.distance))) <= args['curvature_rate_time']/case.speed + 1e-6
+  assert np.max(np.abs(result.xy[-1]-case.reference[-1])) <= .10001
+  # A visible exit still aligns closely; exact endpoint heading is a preference
+  # and cannot override the physical steering bound.
+  assert abs(result.yaw[-1]-case.yaw[-1]) <= math.radians(2)
+  assert body_inside_corridor(result.xy, result.yaw, DEFAULT_FOOTPRINT, case.polygon)
+  if demand > 140:
