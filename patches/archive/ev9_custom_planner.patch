+import math
+
+import numpy as np
+import pytest
+
+from openpilot.tools.ev9_trajectory.frames import (
+  CameraMount, match_normal_cross_sections, model_path_to_rear_axle, static_model_points_to_rear_axle,
+)
+
+
+@pytest.mark.parametrize('direction', [-1, 1])
+@pytest.mark.parametrize('offset', [(2.4, 0.), (2.4, .2), (0., 0.)])
+def test_rigid_camera_motion_recovers_rear_axle_circle(direction, offset):
+  yaw = direction * np.linspace(0, math.pi / 2, 51)
+  radius = direction * 12.
+  rear = radius * np.column_stack((np.sin(yaw), 1 - np.cos(yaw)))
+  mount = CameraMount(*offset)
+  d = mount.vector()
+  rotated = np.column_stack((np.cos(yaw) * d[0] - np.sin(yaw) * d[1], np.sin(yaw) * d[0] + np.cos(yaw) * d[1]))
+  camera_model = (rear + rotated - d) * [1, -1]
+  actual, heading = model_path_to_rear_axle(camera_model, -yaw, mount)
+  np.testing.assert_allclose(actual, rear, atol=1e-12)
+  np.testing.assert_allclose(heading, yaw, atol=1e-12)
+  if offset != (0., 0.):
+    assert np.linalg.norm(static_model_points_to_rear_axle(camera_model, mount)[-1] - rear[-1]) > 2.
+
+
+def test_static_boundaries_shift_but_straight_motion_does_not():
+  points = np.array([[.1, .2], [10., .2]])
+  mount = CameraMount(2.4, .1)
+  np.testing.assert_allclose(static_model_points_to_rear_axle(points, mount), [[2.5, -.1], [12.4, -.1]])
+  path, _ = model_path_to_rear_axle(points, [0., 0.], mount)
+  np.testing.assert_allclose(path, points * [1, -1])  # No silent recentering at first prediction.
+
+
+@pytest.mark.parametrize('points,yaw,mount', [
+  ([[0., 0.], [1., float('nan')]], [0., 0.], CameraMount(2., 0.)),
+  ([[0., 0.], [1., 0.]], [0.], CameraMount(2., 0.)),
+  ([[0., 0.], [1., 0.]], [0., float('inf')], CameraMount(2., 0.)),
+  ([[0., 0.], [1., 0.]], [0., 0.], CameraMount(float('nan'), 0.)),
+])
+def test_reject_unknown_mount_or_unmatched_yaw(points, yaw, mount):
+  with pytest.raises(ValueError):
+    model_path_to_rear_axle(points, yaw, mount)
+
+
+def test_fixed_x_widths_are_converted_to_true_normal_sections():
+  x = np.linspace(-10, 30, 41)
+  reference = np.column_stack((np.linspace(0, 20, 21), np.linspace(0, 10, 21)))
+  left = np.column_stack((x, .5 * x + 2))
+  right = np.column_stack((x, .5 * x - 2))
+  l, r = match_normal_cross_sections(reference, left, right)
+  tangent = np.array([1., .5]) / math.sqrt(1.25)
+  np.testing.assert_allclose((l - reference) @ tangent, 0, atol=1e-12)
+  np.testing.assert_allclose(np.linalg.norm(l - r, axis=1), 4 / math.sqrt(1.25), atol=1e-12)
+  assert not np.allclose(l[:, 0], reference[:, 0])
+
+
+def test_shared_boundary_vertices_are_unique_intersections():
+  ref = np.column_stack((np.arange(5.), np.zeros(5)))
+  l, r = match_normal_cross_sections(ref, ref + [0., 2.], ref - [0., 2.])
+  np.testing.assert_allclose(l - r, np.tile([0., 4.], (5, 1)))
+
+
+def test_road_section_reference_preserves_observed_overhang_coverage():
+  from openpilot.tools.ev9_trajectory.optimizer import DEFAULT_FOOTPRINT, body_inside_corridor
+
+  road_reference = np.column_stack((np.linspace(-6, 16, 23), np.zeros(23)))
+  left, right = match_normal_cross_sections(road_reference, road_reference + [0, 2], road_reference - [0, 2])
+  # The desired rear-axle path is shorter than the independently observed road.
+  path_endpoints = np.array([[0., 0.], [10., 0.]])
+  assert body_inside_corridor(path_endpoints, np.zeros(2), DEFAULT_FOOTPRINT, np.vstack((left, right[::-1])))
+  truncated_left, truncated_right = match_normal_cross_sections(path_endpoints, left, right)
+  assert not body_inside_corridor(path_endpoints, np.zeros(2), DEFAULT_FOOTPRINT, np.vstack((truncated_left, truncated_right[::-1])))
+
+
+@pytest.mark.parametrize('case', ['missing_rear', 'missing_exit', 'multiple', 'overlap', 'reversed', 'wrong_side', 'duplicate'])
+def test_reject_incomplete_or_ambiguous_observations(case):
+  ref = np.column_stack((np.arange(5.), np.zeros(5)))
+  left, right = ref + [0., 2.], ref - [0., 2.]
+  if case == 'missing_rear':
+    left = left[1:]
+  elif case == 'missing_exit':
+    right = right[:-1]
+  elif case == 'multiple':
+    left = np.array([[-1., 2.], [5., 2.], [5., 3.], [-1., 3.]])
+  elif case == 'overlap':
+    left = np.array([[0., 1.], [0., 2.], [4., 2.]])
+  elif case == 'reversed':
+    left = left[::-1]
+  elif case == 'wrong_side':
+    left = right.copy()
+  elif case == 'duplicate':
+    ref[1] = ref[0]
+  with pytest.raises(ValueError):
+    match_normal_cross_sections(ref, left, right)
