index 0000000000000000000000000000000000000000..1e22bafa5509c98b90d6157b56cd34770b726bd7
--- /dev/null
+++ b/tools/ev9_trajectory/profile_execution.py
@@ -0,0 +1,103 @@
+"""Offline paired production steering-chain experiment; never driving permission.
+
+Both policies use 100 Hz feedback and identical production angle/curvature/CAN
+controllers and synthetic physical response. Reference feedback is geometric,
+not the learned model. Footprint choice is required and never changes defaults.
+"""
+import argparse
+from dataclasses import asdict
+import json
+import math
+from pathlib import Path
+import platform
+import time
+
+from opendbc.car import gen_empty_fingerprint
+from opendbc.car.hyundai.interface import CarInterface
+from opendbc.car.hyundai.values import CAR, HyundaiFlags
+from openpilot.selfdrive.controls.lib.ev9_trajectory import ExecutionState, TrajectoryPlan
+from openpilot.tools.ev9_trajectory.execution import (
+  ControllerSnapshot, ExecutionConfiguration, PlanningCorridor, SensorMapping, validate_execution, validate_reference_execution,
+)
+from openpilot.tools.ev9_trajectory.fixtures import VM, fixture
+from openpilot.tools.ev9_trajectory.optimizer import VehicleFootprint, solve_trajectory
+
+FOOTPRINTS = {'historical': VehicleFootprint(4.2, .9, 1.1, .08),
+              'ev9-longitudinal': VehicleFootprint(3.975, 1.04, 1.1, .08)}
+
+
+def configuration(direct, delay, footprint):
+  """Explicit nominal synthetic state, not an inferred recorded controller state."""
+  cp = CarInterface.get_params(CAR.KIA_EV9, gen_empty_fingerprint(), [], direct, False, False, None)
+  cp.flags = int(cp.flags | HyundaiFlags.CANFD_LKA_STEERING | HyundaiFlags.CANFD_LKA_STEERING_ALT)
+  cp.openpilotLongitudinalControl = direct
+  cp_bytes = cp.to_bytes()
+  return ExecutionConfiguration(cp_bytes, cp_bytes, cp.steerRatio, 1., 0., 0., SensorMapping(0., 1., 0., 1., 0.),
+                                ControllerSnapshot(0., 0., 0., 1., 1., 100, True, False, (0.,) * round(delay / .01)),
+                                direct, delay, 500., delay + .275, footprint, 0, 40., 'synthetic_explicit')
+
+
+def profile(footprint_name):
+  footprint = FOOTPRINTS[footprint_name]
+  started = time.perf_counter()
+  rows = []
+  for demand in (145., 160.):
+    for sign in (-1, 1):
+      case = fixture(demand, 7., sign)
+      limit = abs(VM.calc_curvature(math.radians(140), case.speed, 0.))
+      rate = abs(VM.calc_curvature(math.radians(100), case.speed, 0.))
+      trajectory = solve_trajectory(case.reference, case.left, case.right, case.speed, case.initial_pose, 0., limit, rate,
+                                    footprint=footprint)
+      corridor = PlanningCorridor(1, 10., 10.2, (0., 0., 0.), case.reference, case.left, case.right, footprint, True, True, True)
+      plan = None
+      if trajectory.feasible:
+        plan = TrajectoryPlan(1, 0, 10., 10. + (trajectory.distance[-1] + 20) / case.speed,
+                              (0., 0., 0.), case.speed, 0., 0., -limit, limit,
+                              trajectory.distance, trajectory.xy, trajectory.yaw, trajectory.curvature, 1)
+      for direct in (False, True):
+        for delay in (.05, .3):
+          cfg = configuration(direct, delay, footprint)
+          state = ExecutionState(10., (0., 0., 0.), case.speed, 0., 0., 0., cfg.aggregate_delay)
+          baseline = validate_reference_execution(state, corridor, cfg)
+          candidate = validate_execution(plan, state, corridor, cfg) if plan is not None else None
+          rows.append(dict(demand_deg=demand, sign=sign, direct=direct, hardware_delay_s=delay,
+                           geometry_feasible=trajectory.feasible, geometry_reason=trajectory.reason,
+                           baseline=dict(feasible=baseline.feasible, reason=baseline.reason, metrics=baseline.metrics,
+                                         authorizes_execution=baseline.authorizes_execution),
+                           candidate=None if candidate is None else dict(feasible=candidate.feasible, reason=candidate.reason,
+                                                                         metrics=candidate.metrics,
+                                                                         authorizes_execution=candidate.authorizes_execution)))
+  def candidate_success(row):
+    return row['candidate'] is not None and row['candidate']['feasible']
+  summary = dict(pairs=len(rows), candidate_success=sum(candidate_success(r) for r in rows),
+                 baseline_success=sum(r['baseline']['feasible'] for r in rows),
+                 new_success=sum(candidate_success(r) and not r['baseline']['feasible'] for r in rows),
+                 lost_success=sum(not candidate_success(r) and r['baseline']['feasible'] for r in rows),
+                 wall_s=time.perf_counter() - started)
+  return dict(summary=summary, footprint_name=footprint_name, footprint=asdict(footprint), platform=platform.platform(),
+              assumptions=[
+                'Nominal 2 m/s, initial heading 0, synthetic full 90-degree turns and 7 m obstacle-free oracle corridors.',
+                'Both policies run at 100 Hz, same gains/preview and production clip_curvature/LatControlAngle/EV9CarController with decoded CAN.',
+                'Baseline is original-reference geometric feedback without candidate feasibility gate, not learned openpilot policy.',
+                'Common exit <= .2 m / 1 degree plus inflated rectangle clearance at every 100 Hz pose; candidate also requires tracker completion.',
+                'Identity SAS/MDPS mapping, explicit zero initial filter/command/delay history, physical rate 500 deg/s are synthetic assumptions.',
+                'Planning rate 100 deg/s is provisional; full 140-degree physical authority, unchanged production stock/direct request behavior.',
+                'Aggregate preview delay=hardware+.275; actual controller handles its filter, queue only adds hardware delay.',
+                'EV9-longitudinal uses Kia GT-line 3100+875 mm front and 1040 mm rear; half width 1.1 m remains assumed, not verified mirror envelope.',
+                'Historical footprint remains 4.2/.9/1.1/.08; no repository default is changed.',
+                'No Panda/EPS torque-response or installed calibration validation; neither policy authorizes driving.',
+              ], cases=rows)
+
+
+def main():
+  parser = argparse.ArgumentParser(description=__doc__)
+  parser.add_argument('--output', type=Path, required=True)
+  parser.add_argument('--footprint', choices=FOOTPRINTS, required=True)
+  args = parser.parse_args()
+  result = profile(args.footprint)
+  args.output.write_text(json.dumps(result, indent=2) + '\n')
+  print(json.dumps(result['summary'], indent=2))
+
+
+if __name__ == '__main__':
+  main()
