+@pytest.mark.parametrize("direct", [False, True])
+@pytest.mark.parametrize("state", ["filtered", "manual", "inactive", "initializing"])
+def test_ev9_execution_snapshot_tracks_final_internal_state(direct, state):
+  c, cs, cc, toggles = setup_controller(direct, initialized=state != "initializing")
+  cs.out.canValid = True
+  cs.out.vEgoRaw = cs.out.vEgo = 2
+  cs.out.steeringAngleDeg = -73  # Public SAS must not replace the selected MDPS signal.
+  cs.mdps_steering_angle = 100
+  cs.angle_steering_angle = 110
+  measured = 110 if direct else 100
+  c.apply_angle_last = c.angle_filter.x = measured
+  cc.actuators.steeringAngleDeg = 130
+  cc.longActive = not direct  # ECU ownership, not requested long activity, selects the transport.
+  if state == "filtered":
+    c.angle_filter.x = 250  # Previous filter target can exceed the rate-limited output.
+  if state == "manual":
+    toggles.hkg_shared_autonomy_mode = 1
+    cs.out.steeringPressed = True
+    cs.out.steeringTorque = 200
+  if state == "inactive":
+    cc.latActive = False
+  for frame in range(2):  # Include both parity frames, irrespective of CAN transmission cadence.
+    now = 1_000_000_000 + frame * 10_000_000
+    if state == "manual":
+      cs.hands_on_steering_grip = 3
+      cs.hands_on_steering_ts_nanos = now
+    output, _ = c.update(cc.as_reader(), cs, now, toggles)
+    assert output.ev9AngleStateValid
+    assert output.ev9AngleStateMonoTime == now
+    assert output.ev9DirectAngleControl == direct
+    assert output.ev9MeasuredAngleDeg == measured
+    assert output.ev9AngleFilterStateDeg == pytest.approx(c.angle_filter.x)
+    if state in ("manual", "inactive") or (state == "initializing" and frame == 0):
+      assert output.ev9AngleFilterStateDeg == measured
+    if state == "filtered":
+      assert abs(output.ev9AngleFilterStateDeg - output.steeringAngleDeg) > 0.01
+
