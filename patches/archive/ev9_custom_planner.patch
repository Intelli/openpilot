+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+from openpilot.selfdrive.controls.lib.ev9_path_geometry import body_inside_observed
+
+KW = dict(front=1.0, rear=1.0, half_width=1.0, left_margin=0.0, right_margin=0.0)
+
+
+def test_concave_intrusion_between_corners():
+  left = np.array([[-4.0, 3.0], [-0.2, 3.0], [0.0, 0.5], [0.2, 3.0], [4.0, 3.0]])
+  right = np.array([[-4.0, -3.0], [4.0, -3.0]])
+  assert not body_inside_observed([[0.0, 0.0]], [0.0], left, right, **KW)
+  assert body_inside_observed([[0.0, -1.0]], [0.0], left, right, **KW)
+
+
+@pytest.mark.parametrize('x,y', [(0.0, 2.0), (-3.0, 0.0), (3.0, 0.0)])
+def test_touch_and_unobserved_body_rejected(x, y):
+  assert not body_inside_observed([[x, y]], [0.0], [[-4, 3], [4, 3]], [[-4, -3], [4, -3]], **KW)
+
+
+def test_invalid_and_crossed_boundaries():
+  for left in [[[0, 2], [0, 3]], [[0, 2], [4, float('nan')]], [[0, 2], [4, -4]]]:
+    assert not body_inside_observed([[2, 0]], [0], left, [[0, -3], [4, -3]], **KW)
+  assert not body_inside_observed([], [], [[0, 3], [4, 3]], [[0, -3], [4, -3]], **KW)
+
+
+def test_differential_random_polylines_against_existing_exact_checker():
+  from openpilot.tools.ev9_trajectory.optimizer import body_inside_corridor
+
+  rng = np.random.default_rng(803)
+  outcomes = set()
+  for _ in range(160):
+    x = np.linspace(-8, 8, 17)
+    left = np.column_stack((x, rng.uniform(.3, 4, len(x))))
+    right = np.column_stack((x, -rng.uniform(.3, 4, len(x))))
+    polygon = np.vstack((left, right[::-1]))
+    xy = rng.uniform(-2, 2, (1, 2))
+    yaw = rng.uniform(-1, 1, 1)
+    expected = body_inside_corridor(xy, yaw, SimpleNamespace(front=1., rear=1., half_width=1., margin=0.), polygon)
+    actual = body_inside_observed(xy, yaw, left, right, **KW)
+    assert actual == expected
+    outcomes.add(actual)
+  assert outcomes == {True, False}
+
+
+def test_rotated_body_and_asymmetric_margin():
+  left = np.array([[-5, 2], [5, 2]])
+  right = np.array([[-5, -2], [5, -2]])
+  assert body_inside_observed([[0, 0]], [0.4], left, right, **KW)
+  assert not body_inside_observed([[0, 0]], [0.4], left, right, **{**KW, 'left_margin': 1.0})
+
+
+def test_all_48_geometry_fixtures_independent_exact_body_check():
+  from openpilot.tools.ev9_trajectory.fixtures import cases
+  from openpilot.tools.ev9_trajectory.optimizer import body_inside_corridor
+
+  admitted_curved = 0
+  for case in cases():
+    kw = dict(front=4.2, rear=.9, half_width=1.1, left_margin=.08, right_margin=.08)
+    actual = body_inside_observed(case.reference, case.yaw, case.left, case.right, **kw)
+    # Independent polygon checker: stronger normal margins and swept checking
+    # may reject extra cases, but must never accept a body outside raw evidence.
+    if actual:
+      assert body_inside_corridor(case.reference, case.yaw, SimpleNamespace(front=4.2, rear=.9, half_width=1.1, margin=0.), case.polygon)
+      admitted_curved += any(np.any(np.diff(b[:, 0]) <= 1e-8) for b in [case.left, case.right])
+  assert admitted_curved > 0
+
+
+@pytest.mark.parametrize('sign', [-1, 1])
+def test_observed_ninety_degree_corridor_and_rotated_coordinates(sign):
+  theta = np.linspace(-.4, 1.95, 100)
+  center = np.column_stack((12*np.sin(theta), 12*(1-np.cos(theta))))
+  normal = np.column_stack((-np.sin(theta), np.cos(theta)))
+  left, right = center+3.5*normal, center-3.5*normal
+  t = np.linspace(0., np.pi/2, 35)
+  xy = np.column_stack((12*np.sin(t), 12*(1-np.cos(t))))
+  if sign < 0:
+    xy[:, 1] *= -1
+    left, right = right*[1, -1], left*[1, -1]
+  yaw = sign*t
+  kw = dict(front=3.9, rear=1.1, half_width=1.1, left_margin=.15, right_margin=.15)
+  assert body_inside_observed(xy, yaw, left, right, **kw)
+  rotation = np.array([[np.cos(.8), -np.sin(.8)], [np.sin(.8), np.cos(.8)]])
+  assert body_inside_observed(xy@rotation.T+[3, 4], yaw+.8, left@rotation.T+[3, 4], right@rotation.T+[3, 4], **kw)
+  assert not body_inside_observed(xy, yaw, left[:60], right[:60], **kw)
+  assert not body_inside_observed(xy, yaw, right, left, **kw)
+
+
+def test_swept_translation_and_rotation_are_checked_between_clear_endpoints():
+  left = np.array([[-5, 3], [-.2, 3], [0, .5], [.2, 3], [5, 3]])
+  right = np.array([[-5, -3], [5, -3]])
+  assert body_inside_observed([[-2, 0]], [0], left, right, **KW)
+  assert body_inside_observed([[2, 0]], [0], left, right, **KW)
+  assert not body_inside_observed([[-2, 0], [2, 0]], [0, 0], left, right, **KW)
+  left, right = np.array([[-5, 1.1], [5, 1.1]]), np.array([[-5, -1.1], [5, -1.1]])
+  kw = dict(KW, front=2., rear=2., half_width=.5)
+  assert not body_inside_observed([[0, 0], [0, 0]], [0, np.pi], left, right, **kw)
+
+
+@pytest.mark.parametrize('side', [-1, 1])
+def test_optional_reliable_curb_checks_conflict_sweep_and_finite_end(side):
+  from openpilot.selfdrive.controls.lib.ev9_path_geometry import ObservedBoundary, body_respects_observed
+  points = np.array([[-5., 3.], [-.2, 3.], [0., .5], [.2, 3.], [5., 3.]])*[1., side]
+  boundary = ObservedBoundary(points, side, 0., 'test_observed', 0., 1., np.ones(2, dtype=bool))
+  geometry = SimpleNamespace(reliable_boundaries=(boundary,))
+  def check(xy, ref=None):
+    geometry.xy = np.asarray(xy if ref is None else ref, dtype=float)
+    geometry.distance = np.arange(len(xy), dtype=float)
+    return body_respects_observed(xy, np.zeros(len(xy)), geometry, reference_distance=geometry.distance,
+                                  front=1., rear=1., half_width=1.)
+  assert check([[-2, 0]]) and check([[2, 0]])
+  assert not check([[-2, 0], [2, 0]])  # Endpoint-only checks would miss the curb.
+  assert not check([[0, 5*side]])  # Already on the wrong side must still reject.
+  assert not check([[0, 0]], [[20, 0]])  # No association cannot waive a physical collision.
+  assert check([[10, 5*side]])  # No wall extrapolated beyond the observed endpoint.
