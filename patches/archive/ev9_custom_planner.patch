+    step = length / N / subdivisions * scale
+    for _ in range(subdivisions):
+      x, y, yaw, curvature = scalar[-1]
+      middle = yaw + curvature * step / 2 + rate * step**2 / 8
+      end = yaw + curvature * step + rate * step**2 / 2
+      scalar.append([x + step / 6 * (math.cos(yaw) + 4*math.cos(middle) + math.cos(end)),
+                     y + step / 6 * (math.sin(yaw) + 4*math.sin(middle) + math.sin(end)), end, curvature + rate * step])
+      stations.append(stations[-1] + step)
+  np.testing.assert_allclose(dense, scalar, rtol=0., atol=1e-10)
+  np.testing.assert_allclose(distance, stations, rtol=0., atol=1e-10)
+  assert np.max(np.diff(distance)) <= .050001
