new file mode 100644
index 0000000000000000000000000000000000000000..44cd911c01fe81facaf0693a9d0bfa96ff2e99e3
--- /dev/null
+++ b/tools/ev9_trajectory/audit_corridor_gates.py
@@ -0,0 +1,78 @@
+"""Independent gate distributions; confidence bypass probes never grant eligibility."""
+
+import argparse
+from collections import Counter, defaultdict
+import json
+import math
+from pathlib import Path
+
+import numpy as np
+
+from openpilot.tools.ev9_trajectory.corridor import corridor_diagnostics
+from openpilot.tools.ev9_trajectory.replay_live import read_events
+
+
+def summarize_gates(events):
+  latest, groups = {}, {}
+  for mono, service, valid, data in sorted(events, key=lambda e: e[0]):
+    if service in ('carState', 'carControl'):
+      latest[service] = (mono, valid, data)
+      continue
+    if service != 'modelV2':
+      continue
+    labels = ['all']
+    if all(s in latest and latest[s][1] and 0 <= (mono - latest[s][0]) / 1e9 <= 0.25 for s in ('carState', 'carControl')):
+      cs, cc = latest['carState'][2], latest['carControl'][2]
+      speed, angle = cs.get('vEgo', float('nan')), cs.get('steeringAngleDeg', float('nan'))
+      if math.isfinite(speed) and math.isfinite(angle) and 0.5 <= speed <= 7:
+        labels.append('low_speed')
+        autonomous = cc.get('latActive', False) and not cs.get('steeringPressed', False)
+        if autonomous:
+          labels.append('low_speed_autonomous')
+        if abs(angle) >= 90:
+          labels.append('sharp')
+          if autonomous:
+            labels.append('sharp_autonomous')
+    diagnostic = corridor_diagnostics(data)
+    for label in labels:
+      g = groups.setdefault(label, dict(counts=Counter(), metrics=defaultdict(list), schema=Counter(), geometry=Counter(), overlaps=Counter()))
+      g['counts']['frames'] += 1
+      g['counts']['invalid_model'] += not valid
+      for key, passed in diagnostic['gates'].items():
+        g['counts'][key + '_pass'] += passed
+      for key, value in diagnostic['metrics'].items():
+        g['metrics'][key].append(value)
+      for key, values in diagnostic['schema'].items():
+        for field, value in values.items():
+          g['schema'][f'{key}.{field}={value}'] += 1
+      g['geometry'][diagnostic['geometry_reason']] += 1
+      g['overlaps'][''.join('1' if diagnostic['gates'][k] else '0' for k in ['laneLineProbs', 'laneLineStds', 'roadEdgeStds', 'pathStd', 'geometry'])] += 1
+  output = {}
+  for label, g in groups.items():
+    output[label] = dict(
+      counts=dict(g['counts']),
+      geometry_reasons=dict(g['geometry']),
+      schema=dict(g['schema']),
+      overlaps=dict(g['overlaps']),
+      distributions={
+        k: dict(zip(['min', 'p10', 'p50', 'p90', 'max'], map(float, np.percentile(v, [0, 10, 50, 90, 100])), strict=True)) for k, v in g['metrics'].items()
+      },
+    )
+  return output
+
+
+def main():
+  parser = argparse.ArgumentParser(description=__doc__)
+  parser.add_argument('--route', nargs='+', type=Path, action='append', required=True)
+  parser.add_argument('--output', type=Path, required=True)
+  args = parser.parse_args()
+  report = dict(
+    scope='Diagnostic independent gate evaluation, not a changed corridor acceptance policy.',
+    overlap_bit_order=['lane probability >=.8', 'lane std <=.3', 'edge std <=.3', 'whole-path yStd <=.3', 'geometry-only probe'],
+    routes=[summarize_gates(read_events(paths)) for paths in args.route],
+  )
+  args.output.write_text(json.dumps(report, indent=2) + '\n')
+
+
+if __name__ == '__main__':
+  main()
