+"""Model-led path refinement with optional, explicit observed constraints."""
+import math
+import os
+from dataclasses import replace
+
+import numpy as np
+import pytest
+
+from openpilot.selfdrive.controls.lib.ev9_path_mpc import Ev9PathMpc
+from openpilot.selfdrive.controls.lib.ev9_path_planner import ModelPathPlanner, MODEL_GEOMETRY
+from openpilot.selfdrive.controls.lib.ev9_trajectory import ExecutionState
+from openpilot.tools.ev9_trajectory.fixtures import VM, integrate
+
+
+def visible_turn(degrees=30, demand=144, sign=1, lane=True):
+  k = abs(VM.calc_curvature(math.radians(demand), 2., 0.))
+  length = math.radians(degrees) / (.8 * k)
+  arc = np.linspace(0, 12 + length + 10, 401)
+  u = (arc - 12) / length
+  profile = np.where((u >= 0) & (u <= 1), 1., 0.)
+  mask = (u >= 0) & (u < .2)
+  profile[mask] = .5 * (1 - np.cos(np.pi * u[mask] / .2))
+  mask = (u > .8) & (u <= 1)
+  profile[mask] = .5 * (1 - np.cos(np.pi * (1 - u[mask]) / .2))
+  xy, yaw = integrate(arc, sign * k * profile)
+  mount = MODEL_GEOMETRY.mount.vector()
+  c, s = np.cos(yaw), np.sin(yaw)
+  rotated = np.column_stack((c * mount[0] - s * mount[1], s * mount[0] + c * mount[1]))
+  camera = xy + rotated - mount
+  normal = np.column_stack((-s, c))
+  center = np.vstack(([2., 0.], xy[arc > 2], xy[-1] + 10 * np.array([c[-1], s[-1]])))
+  normals = np.vstack(([0., 1.], normal[arc > 2], normal[-1]))
+
+  def line(offset):
+    points = center + offset * normals - mount
+    return dict(x=points[:, 0], y=-points[:, 1])
+
+  t = arc / 2
+  return dict(position=dict(x=camera[:, 0], y=-camera[:, 1], t=t), orientation=dict(z=-yaw, t=t),
+              laneLines=[line(6), line(3.5), line(-3.5), line(-6)], laneLineProbs=[.9 if lane else .1] * 4,
+              laneLineStds=[.01] * 4, roadEdges=[line(3.5), line(-3.5)], roadEdgeStds=[.01] * 2)
+
