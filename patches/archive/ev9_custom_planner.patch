+@pytest.mark.parametrize("direct", [False, True])
+def test_ev9_execution_snapshot_invalid_can_and_input_telemetry_cannot_affect_commands(direct):
+  clean, cs, cc, toggles = setup_controller(direct)
+  copied, _, _, _ = setup_controller(direct)
+  cc.actuators.steeringAngleDeg = 50
+  expected, expected_can = clean.update(cc.as_reader(), cs, 1_000_000_000, toggles)
+  cc.actuators.ev9AngleStateValid = True
+  cc.actuators.ev9AngleStateMonoTime = 123
+  cc.actuators.ev9AngleFilterStateDeg = 999
+  cc.actuators.ev9MeasuredAngleDeg = 999
+  cc.actuators.ev9DirectAngleControl = not direct
+  actual, actual_can = copied.update(cc.as_reader(), cs, 1_000_000_000, toggles)
+  assert not actual.ev9AngleStateValid  # Fixture CAN is invalid until explicitly marked valid.
+  assert actual.to_dict() == expected.to_dict()
+  assert actual_can == expected_can
