@@ -0,0 +1,178 @@
+"""Conservative model boundary geometry adapter, not a free-space detector.
+
+modelV2 lane/road curves use fixed forward x, not the temporal path's stations.
+Scalar boundary standard deviations describe only their first predicted point.
+Selected lead predictions cannot establish absence of other obstacles. Therefore
+an available geometry proposal NEVER authorizes execution without independent
+permitted-space, full-body, and traversal-time obstacle validation.
+"""
+
+from dataclasses import dataclass, field
+import math
+
+import numpy as np
+
+
+@dataclass
+class CorridorGeometry:
+  available: bool
+  reason: str
+  reference: np.ndarray = field(default_factory=lambda: np.empty((0, 2)))
+  left: np.ndarray = field(default_factory=lambda: np.empty((0, 2)))
+  right: np.ndarray = field(default_factory=lambda: np.empty((0, 2)))
+  source_time: float = 0.0
+  # Output is ego-origin x-forward/y-left; this does not establish a rear-axle transform.
+  frame: str = 'model_ego_x_forward_y_left'
+  execution_authorized: bool = field(default=False, init=False)
+
+
+def _get(value, name):
+  return value[name] if isinstance(value, dict) else getattr(value, name)
+
+
+def _line(value):
+  x, y = np.asarray(_get(value, 'x'), dtype=float), np.asarray(_get(value, 'y'), dtype=float)
+  if x.ndim != 1 or y.shape != x.shape or len(x) < 3 or not np.isfinite(np.r_[x, y]).all() or np.any(np.diff(x) <= 1e-5):
+    raise ValueError('invalid line')
+  return np.column_stack((x, -y))
+
+
+def model_lane_corridor(model, *, model_time, now, model_valid, min_lane_probability=0.8, max_boundary_std=0.3, max_path_std=0.3):
+  """Return lane/road intersection geometry with no extrapolation or permission claim.
+
+  Thresholds are rejection heuristics, not calibrated confidence guarantees.
+  Full temporal path coverage is required; no clipping to a convenient prefix.
+  Fixed-x boundaries cannot represent a turning-back path or a >=60deg branch.
+  Runtime callers must additionally validate coordinates/footprint, corridor
+  permission, dynamic conflicts, adoption state and expiry; do not use available
+  as an active-control gate.
+  """
+
+  def reject(reason):
+    return CorridorGeometry(False, reason)
+
+  scalars = (model_time, now, min_lane_probability, max_boundary_std, max_path_std)
+  if not all(math.isfinite(v) for v in scalars) or not 0 <= min_lane_probability <= 1 or min(max_boundary_std, max_path_std) <= 0:
+    return reject('invalid_configuration')
+  if not model_valid or not 0 <= now - model_time <= 0.25:
+    return reject('invalid_or_stale_model')
+  try:
+    lanes, roads = _get(model, 'laneLines'), _get(model, 'roadEdges')
+    probs = np.asarray(_get(model, 'laneLineProbs'), dtype=float)
+    lane_std = np.asarray(_get(model, 'laneLineStds'), dtype=float)
+    edge_std = np.asarray(_get(model, 'roadEdgeStds'), dtype=float)
+    if probs.shape != (4,) or lane_std.shape != (4,) or edge_std.shape != (2,):
+      return reject('missing_boundary_confidence')
+    confidence = np.r_[probs, lane_std, edge_std]
+    if not np.isfinite(confidence).all() or np.any(probs < 0) or np.any(probs > 1) or np.any(lane_std < 0) or np.any(edge_std < 0):
+      return reject('invalid_boundary_confidence')
+    if min(probs[1:3]) < min_lane_probability or max(np.r_[lane_std[1:3], edge_std]) > max_boundary_std:
+      return reject('uncertain_boundaries')
+    position = _get(model, 'position')
+    reference = _line(position)
+    path_std = np.asarray(_get(position, 'yStd'), dtype=float)
+    if path_std.shape != (len(reference),) or not np.isfinite(path_std).all() or np.any(path_std < 0) or max(path_std) > max_path_std:
+      return reject('uncertain_full_path')
+    boundaries = [_line(lanes[1]), _line(lanes[2]), _line(roads[0]), _line(roads[1])]
+  except (KeyError, AttributeError, IndexError, TypeError, ValueError):
+    return reject('invalid_or_missing_geometry')
+  tangent = np.arctan2(np.diff(reference[:, 1]), np.diff(reference[:, 0]))
+  if max(abs(tangent)) >= math.radians(60):
+    return reject('unsupported_turn_geometry')
+  lo, hi = max(b[0, 0] for b in boundaries), min(b[-1, 0] for b in boundaries)
+  if reference[0, 0] < lo or reference[-1, 0] > hi or hi - lo < 10:
+    return reject('uncovered_full_path')
+  # Retain all observed knots to avoid bridging over a narrower sampled section.
+  x = np.unique(np.r_[lo, hi, *[b[(b[:, 0] >= lo) & (b[:, 0] <= hi), 0] for b in boundaries]])
+  lane_left, lane_right, road_left, road_right = [np.interp(x, b[:, 0], b[:, 1]) for b in boundaries]
+  if np.any(lane_left <= lane_right) or np.any(road_left <= road_right):
+    return reject('crossed_boundaries')
+  left_y, right_y = np.minimum(lane_left, road_left), np.maximum(lane_right, road_right)
+  if np.any(left_y <= right_y):
+    return reject('empty_lane_road_intersection')
+  if np.any(reference[:, 1] >= np.interp(reference[:, 0], x, left_y)) or np.any(reference[:, 1] <= np.interp(reference[:, 0], x, right_y)):
+    return reject('reference_outside_corridor')
+  return CorridorGeometry(
+    True, 'geometry_only_requires_space_and_time_validation', reference, np.column_stack((x, left_y)), np.column_stack((x, right_y)), model_time
+  )
+
+
+def _lane_geometry_probe(model):
+  """Structural lane-only probe. No road-edge substitution or permission claim."""
+  try:
+    reference = _line(_get(model, 'position'))
+    lanes = _get(model, 'laneLines')
+    left, right = _line(lanes[1]), _line(lanes[2])
+  except (KeyError, AttributeError, IndexError, TypeError, ValueError):
+    return 'invalid_or_missing_geometry'
+  if max(abs(np.arctan2(np.diff(reference[:, 1]), np.diff(reference[:, 0])))) >= math.radians(60):
+    return 'unsupported_turn_geometry'
+  lo, hi = max(left[0, 0], right[0, 0]), min(left[-1, 0], right[-1, 0])
+  if reference[0, 0] < lo or reference[-1, 0] > hi or hi - lo < 10:
+    return 'uncovered_full_path'
+  x = np.unique(np.r_[lo, hi, left[(left[:, 0] >= lo) & (left[:, 0] <= hi), 0], right[(right[:, 0] >= lo) & (right[:, 0] <= hi), 0]])
+  ly, ry = np.interp(x, left[:, 0], left[:, 1]), np.interp(x, right[:, 0], right[:, 1])
+  if np.any(ly <= ry):
+    return 'crossed_boundaries'
+  if np.any(reference[:, 1] >= np.interp(reference[:, 0], x, ly)) or np.any(reference[:, 1] <= np.interp(reference[:, 0], x, ry)):
+    return 'reference_outside_corridor'
+  return 'lane_geometry_only'
+
+
+def corridor_diagnostics(model):
+  """Independent gate evidence, not relaxed eligibility or execution permission.
+
+  Unlike the adapter's first-rejection reason this evaluates every available
+  confidence channel. The geometry-only probe bypasses statistical thresholds
+  solely to distinguish missing geometry from rejected confidence.
+  """
+  metrics, gates, schema = {}, {}, {}
+  for name, indexes, reduction, threshold, lower in (
+    ('laneLineProbs', (1, 2), min, 0.8, True),
+    ('laneLineStds', (1, 2), max, 0.3, False),
+    ('roadEdgeStds', (0, 1), max, 0.3, False),
+  ):
+    try:
+      values = np.asarray(_get(model, name), dtype=float)
+      schema[name] = dict(length=len(values), all_zero=bool(np.all(values == 0)))
+      chosen = values[list(indexes)]
+      valid = values.ndim == 1 and np.isfinite(chosen).all() and np.all(chosen >= 0)
+      if name == 'laneLineProbs':
+        valid = valid and np.all(chosen <= 1)
+      if valid:
+        value = float(reduction(chosen))
+        metrics[name] = value
+        gates[name] = bool(value >= threshold if lower else value <= threshold)
+      else:
+        gates[name] = False
+    except (KeyError, AttributeError, IndexError, TypeError, ValueError):
+      gates[name] = False
+      schema[name] = dict(missing_or_invalid=True)
+  try:
+    position = _get(model, 'position')
+    std = np.asarray(_get(position, 'yStd'), dtype=float)
+    x = np.asarray(_get(position, 'x'), dtype=float)
+    y = np.asarray(_get(position, 'y'), dtype=float)
+    valid = std.ndim == 1 and std.shape == x.shape == y.shape and len(std) >= 3 and np.isfinite(np.r_[std, x, y]).all() and np.all(std >= 0)
+    gates['pathStd'] = bool(valid and max(std) <= 0.3)
+    if valid:
+      metrics['pathStd'] = float(max(std))
+      schema['path'] = dict(
+        length=len(x),
+        all_zero=bool(np.all(x == 0) and np.all(y == 0)),
+        starts_before_boundary_origin=bool(x[0] < 0),
+        nonmonotone_x=bool(np.any(np.diff(x) <= 1e-5)),
+      )
+  except (KeyError, AttributeError, TypeError, ValueError):
+    gates['pathStd'] = False
+    schema['path'] = dict(missing_or_invalid=True)
+  geometry = model_lane_corridor(model, model_time=0.0, now=0.0, model_valid=True, min_lane_probability=0.0, max_boundary_std=1e30, max_path_std=1e30)
+  gates['geometry'] = geometry.available
+  lane_geometry_reason = _lane_geometry_probe(model)
+  gates['lane_geometry'] = lane_geometry_reason == 'lane_geometry_only'
+  gates['lane_evidence'] = gates['laneLineProbs'] and gates['laneLineStds']
+  gates['lane_and_edge_evidence'] = gates['lane_evidence'] and gates['roadEdgeStds']
+  gates['all_confidence'] = gates['lane_and_edge_evidence'] and gates['pathStd']
+  return dict(
+    metrics=metrics, gates=gates, schema=schema, geometry_reason=geometry.reason, lane_geometry_reason=lane_geometry_reason, execution_authorized=False
+  )
