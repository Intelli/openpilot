+++ b/tools/ev9_trajectory/frames.py
@@ -0,0 +1,74 @@
+"""Offline boundary matching with shared runtime camera/rear-axle transforms."""
+import numpy as np
+
+from openpilot.selfdrive.controls.lib.ev9_path_frames import (
+  CameraMount as CameraMount,
+  _points,
+  model_path_to_rear_axle as model_path_to_rear_axle,
+  static_model_points_to_rear_axle as static_model_points_to_rear_axle,
+)
+
+
+def _cross(a, b):
+  return a[..., 0] * b[..., 1] - a[..., 1] * b[..., 0]
+
+
+def _normal_intersections(reference, normals, boundary, side):
+  delta = np.diff(boundary, axis=0)
+  lengths = np.linalg.norm(delta, axis=1)
+  if np.any(lengths <= 1e-8):
+    raise ValueError('duplicate_boundary_points')
+  stations = np.r_[0., np.cumsum(lengths)]
+  result, matched_stations = [], []
+  for point, normal in zip(reference, normals, strict=True):
+    relative = boundary[:-1] - point
+    determinant = _cross(normal, delta)
+    parallel = abs(determinant) <= 1e-10
+    # A boundary overlapping a cross-section has no unique intersection.
+    if np.any(parallel & (abs(_cross(relative, normal)) <= 1e-8)):
+      raise ValueError('ambiguous_normal_intersection')
+    usable = ~parallel
+    t = np.full(len(delta), np.nan)
+    u = t.copy()
+    t[usable] = _cross(relative[usable], delta[usable]) / determinant[usable]
+    u[usable] = _cross(relative[usable], normal) / determinant[usable]
+    indexes = np.flatnonzero(usable & (u >= -1e-8) & (u <= 1 + 1e-8))
+    # Adjacent segments can share one vertex; deduplicate that same station.
+    candidates = [(float(stations[i] + np.clip(u[i], 0., 1.) * lengths[i]), float(t[i])) for i in indexes]
+    unique = []
+    for station, width in candidates:
+      if not unique or abs(station - unique[-1][0]) > 1e-7:
+        unique.append((station, width))
+    if len(unique) != 1 or side * unique[0][1] <= 1e-6:
+      raise ValueError('missing_or_ambiguous_normal_intersection')
+    station, width = unique[0]
+    result.append(point + width * normal)
+    matched_stations.append(station)
+  if np.any(np.diff(matched_stations) <= 1e-8):
+    raise ValueError('folded_boundary_correspondence')
+  return np.asarray(result)
+
+
+def match_normal_cross_sections(reference, left_boundary, right_boundary):
+  """Intersect observed polylines with reference normals for solver input.
+
+  Inputs must already share the rear-axle frame. Require full correspondence,
+  unique signed intersections and forward boundary order. No nearest-point
+  substitution, extrapolation, prefix clipping or invented rear coverage.
+  Output covers reference stations only. For solver input, this section reference
+  must span the observed road including start/exit body coverage, separately from
+  the desired vehicle path. Supplying only path stations would truncate the road
+  polygon and lose overhang coverage; this helper never invents that extension.
+  """
+  reference, left, right = map(_points, (reference, left_boundary, right_boundary))
+  lengths = np.linalg.norm(np.diff(reference, axis=0), axis=1)
+  if np.any(lengths <= 1e-8):
+    raise ValueError('duplicate_reference_points')
+  station = np.r_[0., np.cumsum(lengths)]
+  tangent = np.gradient(reference, station, axis=0)
+  norm = np.linalg.norm(tangent, axis=1)
+  if np.any(norm <= 1e-8):
+    raise ValueError('folded_reference')
+  normals = np.column_stack((-tangent[:, 1], tangent[:, 0])) / norm[:, None]
+  return (_normal_intersections(reference, normals, left, 1),
+          _normal_intersections(reference, normals, right, -1))
diff --git a/tools/ev9_trajectory/live_benchmark.py b/tools/ev9_trajectory/live_benchmark.py
new file mode 100644
index 0000000000000000000000000000000000000000..1da7bf597d32800d0e616ee412e773d0e8baab0a
--- /dev/null
+++ b/tools/ev9_trajectory/live_benchmark.py
@@ -0,0 +1,188 @@
+"""Synthetic full-turn evaluation of the actual TrajectoryTracker ownership loop.
+
+Geometry is positive-left; Plant pose and control curvature are positive-right.
+This harness supplies ideal, continuously renewed corridor/execution evidence.
+It does not establish that such evidence exists on a vehicle.
+"""
+import argparse
+from collections import Counter
+from dataclasses import replace
+import json
+import math
+from pathlib import Path
+import time
+
+import numpy as np
+
+from openpilot.selfdrive.controls.lib.ev9_trajectory import ExecutionState, TrajectoryMode, TrajectoryPlan, TrajectoryTracker
+from openpilot.tools.ev9_trajectory.benchmark import Plant, track
+from openpilot.tools.ev9_trajectory.fixtures import FRONT, HALF_WIDTH, REAR, VM, fixture
+from openpilot.tools.ev9_trajectory.optimizer import inside_polygon, solve_trajectory
+
+
+DT = 0.01
+
+
+def mirror_xy(xy):
+  return np.asarray(xy) * np.array([1., -1.])
+
+
+def plant_case(case):
+  """Reflect every relevant geometric quantity for the positive-right Plant."""
+  return replace(case, reference=mirror_xy(case.reference), yaw=-case.yaw, left=mirror_xy(case.right), right=mirror_xy(case.left),
+                 polygon=mirror_xy(case.polygon), initial_pose=case.initial_pose * np.array([1., -1., -1.]))
+
+
+def make_plan(case, trajectory):
+  limit = abs(VM.calc_curvature(math.radians(140), case.speed, 0.))
+  return TrajectoryPlan(plan_id=1, generation=0, source_time=0., valid_until=float((trajectory.distance[-1] + 20) / case.speed),
+                        origin=(0., 0., 0.), speed=case.speed, initial_curvature=0., initial_command_curvature=0.,
+                        min_curvature=-limit, max_curvature=limit, distance=trajectory.distance, xy=trajectory.xy,
+                        yaw=trajectory.yaw, curvature=trajectory.curvature, corridor_revision=1, execution_validated=True)
+
+
+def execution_state(plant, now, aggregate_delay):
+  x, y, yaw = plant.pose
+  return ExecutionState(time=now, pose=(float(x), float(-y), float(-yaw)), speed=plant.speed, wheel_angle_deg=plant.angle,
+                        curvature=float(plant.vm.calc_curvature(math.radians(plant.angle), plant.speed, 0.)),
+                        command_curvature=-plant.curvature, delay=aggregate_delay)
+
+
+class ReferenceBaseline:
+  """The existing benchmark's 20 Hz geometric reference feedback, unchanged."""
+  def __init__(self, case, delay):
+    self.case = case
+    self.nearest = 0
+    self.target = 0.
+    self.curvature = np.gradient(case.yaw, case.arc)
+    self.preview = case.speed * (delay + 0.2 + 0.075)
+
+  def update(self, pose, step):
+    if step % 5 == 0:
+      lo = max(0, self.nearest - 8)
+      hi = min(len(self.case.reference), self.nearest + 120)
+      self.nearest = lo + int(np.argmin(np.sum((self.case.reference[lo:hi] - pose[:2])**2, axis=1)))
+      heading = self.case.yaw[self.nearest]
+      normal = np.array([-math.sin(heading), math.cos(heading)])
+      lateral = float((pose[:2] - self.case.reference[self.nearest]) @ normal)
+      error = math.atan2(math.sin(pose[2] - heading), math.cos(pose[2] - heading))
+      self.target = float(np.interp(self.case.arc[self.nearest] + self.preview, self.case.arc, self.curvature)) - 0.08 * lateral - 0.5 * error
+    return self.target
+
+
+def track_live(case, trajectory, delay):
+  reflected = plant_case(case)
+  plant = Plant(dict(actual_ratio_scale=1., delay=delay, initial_heading_deg=-math.degrees(case.initial_pose[2])), case.speed)
+  baseline = ReferenceBaseline(reflected, delay)
+  tracker = TrajectoryTracker()
+  plan = make_plan(case, trajectory)
+  poses, commands, active_commands, transitions = [], [], [], []
+  reasons = Counter()
+  completed = False
+  was_active = False
+  active_steps = 0
+  max_lateral_error = max_heading_error = 0.
+  tangent_end = np.array([math.cos(reflected.yaw[-1]), math.sin(reflected.yaw[-1])])
+  # Known aggregate delay is a fixture assumption only; runtime liveDelay already
+  # contains aggregate delay and must not receive this extra filter compensation.
+  aggregate_delay = delay + 0.2 + 0.075
+  for step in range(int((max(case.arc[-1], trajectory.distance[-1]) + 20) / case.speed / DT)):
+    now = step * DT
+    baseline_command = baseline.update(plant.pose, step)
+    decision = tracker.update(execution_state(plant, now, aggregate_delay), baseline_command, mode=TrajectoryMode.ACTIVE,
+                              proposal=plan if step == 0 else None, corridor_revision=1, corridor_valid_until=now + .2)
+    reasons[decision.reason] += 1
+    if decision.active != was_active:
+      transitions.append(dict(time=now, event='adopt' if decision.active else 'release', reason=decision.reason,
+                              baseline_curvature=baseline_command, selected_curvature=decision.curvature))
+    was_active = decision.active
+    if decision.active:
+      active_steps += 1
+      active_commands.append(decision.curvature)
+      max_lateral_error = max(max_lateral_error, abs(decision.lateral_error))
+      max_heading_error = max(max_heading_error, abs(math.degrees(decision.heading_error)))
+    commands.append(decision.curvature)
+    plant.step(decision.curvature)
+    if step % 10 == 0:
+      poses.append(plant.pose.copy())
+    if (plant.pose[:2] - reflected.reference[-1]) @ tangent_end >= 0 and baseline.nearest > len(case.reference) * .8:
+      completed = True
+      break
+  poses = np.array(poses)
+  local = np.array([(a, b) for a in np.linspace(-REAR, FRONT, 12) for b in np.linspace(-HALF_WIDTH, HALF_WIDTH, 7)])
+  c, s = np.cos(poses[:, 2, None]), np.sin(poses[:, 2, None])
+  body = np.stack((poses[:, 0, None] + c * local[:, 0] - s * local[:, 1],
+                   poses[:, 1, None] + s * local[:, 0] + c * local[:, 1]), axis=-1)
+  inside = inside_polygon(body.reshape(-1, 2), reflected.polygon).reshape(len(poses), -1)
+  terminal = float(np.linalg.norm(plant.pose[:2] - reflected.reference[-1]))
+  heading = abs(math.degrees(plant.pose[2] - reflected.yaw[-1]))
+  def max_angle(values):
+    return max((abs(math.degrees(plant.learned.get_steer_from_curvature(-k, case.speed, 0.))) for k in values), default=0.)
+  return dict(completed=completed, terminal_position_error_m=terminal, terminal_heading_error_deg=heading,
+              sampled_body_violation_poses=int(np.count_nonzero(~inside.all(axis=1))), sampled_poses=len(poses),
+              max_wheel_angle_deg=plant.maxangle, max_requested_angle_deg=max_angle(commands),
+              max_active_requested_angle_deg=max_angle(active_commands), max_active_lateral_error_m=max_lateral_error,
+              max_active_heading_error_deg=max_heading_error, active_steps=active_steps, total_steps=step + 1,
+              active_fraction=active_steps / (step + 1), reason_counts=dict(reasons), transitions=transitions,
+              adoptions=sum(t['event'] == 'adopt' for t in transitions), releases=sum(t['event'] == 'release' for t in transitions),
+              tracker_completed=reasons['complete'] > 0,
+              success=bool(completed and terminal <= .2 and heading <= 1 and inside.all()))
+
+
+def benchmark():
+  started = time.perf_counter()
+  rows = []
+  for demand in (145., 160.):
+    for sign in (-1, 1):
+      for heading in (-2., 0., 2.):
+        case = fixture(demand, 7., sign, heading)
+        limit = abs(VM.calc_curvature(math.radians(140), case.speed, 0.))
+        rate = abs(VM.calc_curvature(math.radians(100), case.speed, 0.))
+        trajectory = solve_trajectory(case.reference, case.left, case.right, case.speed, case.initial_pose, 0., limit, rate)
+        reflected = plant_case(case)
+        for delay in (.05, .3):
+          original = track(reflected, reflected.reference, reflected.yaw, reflected.arc,
+                           np.gradient(reflected.yaw, reflected.arc), 1., delay)
+          candidate = track(reflected, mirror_xy(trajectory.xy), -trajectory.yaw, trajectory.distance,
+                            -trajectory.curvature, 1., delay) if trajectory.feasible else None
+          live = track_live(case, trajectory, delay) if trajectory.feasible else None
+          rows.append(dict(case=case.name, hardware_delay_s=delay, feasible=trajectory.feasible, reason=trajectory.reason,
+                           baseline_reference=original, baseline_planned=candidate, live_tracker=live))
+  available = [row for row in rows if row['live_tracker'] is not None]
+  release_reasons = Counter(t['reason'] for row in available for t in row['live_tracker']['transitions'] if t['event'] == 'release')
+  summary = dict(pairs=len(rows), feasible_pairs=len(available), baseline_reference_success=sum(r['baseline_reference']['success'] for r in rows),
+                 baseline_planned_success=sum(r['baseline_planned']['success'] for r in available),
+                 live_success=sum(r['live_tracker']['success'] for r in available),
+                 live_tracker_completed=sum(r['live_tracker']['tracker_completed'] for r in available),
+                 new_success=sum(r['live_tracker']['success'] and not r['baseline_reference']['success'] for r in available),
+                 lost_success=sum(r['baseline_reference']['success'] and not r['live_tracker']['success'] for r in available),
+                 live_body_violations=sum(r['live_tracker']['sampled_body_violation_poses'] > 0 for r in available),
+                 live_adoptions=sum(r['live_tracker']['adoptions'] for r in available),
+                 live_releases=sum(r['live_tracker']['releases'] for r in available), release_reasons=dict(release_reasons),
+                 wall_s=time.perf_counter() - started)
+  return dict(summary=summary, conventions=dict(geometry='rear axle x forward, y/yaw/curvature positive left',
+              plant='rear axle x forward, y/yaw/command curvature positive right',
+              state_transform='(plant.x, -plant.y, -plant.yaw); physical curvature=VM.calc_curvature(wheel angle)',
+              command_transform='TrajectoryTracker returns positive-right command: passed directly to Plant',
+              baseline_transform='reflect path, yaw, curvature, corridor and initial heading into Plant frame'),
+              assumptions=['Nominal steering ratio, 2 m/s, full nominal +/-140 degree planning authority; no uncertainty derating.',
+              'Synthetic permitted corridor and execution_validated=True are oracle inputs, renewed every 10 ms with 200 ms lease.',
+              'Known aggregate delay=hardware+.2+.075 is a simulation assumption, not runtime liveDelay handling.',
+              '100 Hz actual tracker versus existing 20 Hz reference tracker; identical Plant shaping and physical limits.',
+              'A single plan is offered at time zero; on release the original reference feedback regains control, with no replanning.',
+              'Success is common exit <=.2 m/1 degree and sampled full-body clearance; report tracker completion separately.',
+              'Body grid12x7 sampled every .1 s matches existing benchmark; no swept-volume or real-vehicle validation.',
+              'Solver runs offline without runtime deadline; this isolates tracking and does not establish live planner feasibility.'], cases=rows)
+
+
+def main():
+  parser = argparse.ArgumentParser(description=__doc__)
+  parser.add_argument('--output', type=Path, required=True)
+  args = parser.parse_args()
+  result = benchmark()
+  args.output.write_text(json.dumps(result, indent=2) + '\n')
+  print(json.dumps(result['summary'], indent=2))
+
+
+if __name__ == '__main__':
+  main()
