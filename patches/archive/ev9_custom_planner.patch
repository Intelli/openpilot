+"""Exact acceptance comparisons with the archived, unbatched predicates."""
+import math
+
+import numpy as np
+import pytest
+
+from openpilot.tools.ev9_trajectory.optimizer import inside_polygon, polygon_is_simple
+
+
+def reference_inside_polygon(points, polygon):
+  """Ray crossing, conservatively excluding points on ambiguous boundaries."""
+  x, y = np.asarray(points).T
+  inside = np.zeros(len(points), dtype=bool)
+  for a, b in zip(polygon, np.roll(polygon, -1, axis=0), strict=True):
+    if a[1] != b[1]:
+      inside ^= ((a[1] > y) != (b[1] > y)) & (x < (b[0] - a[0]) * (y - a[1]) / (b[1] - a[1]) + a[0])
+  return inside
+
+
+def reference_polygon_is_simple(polygon):
+  """Reject crossings/touches between nonadjacent corridor edges."""
+  starts, ends = polygon, np.roll(polygon, -1, axis=0)
+  delta = ends - starts
+  if np.any(np.linalg.norm(delta, axis=1) < 1e-6):
+    return False
+  def cross(a, b):
+    return a[..., 0] * b[..., 1] - a[..., 1] * b[..., 0]
+  for i in range(len(polygon) - 2):
+    stop = len(polygon) - 1 if i == 0 else len(polygon)
+    a, b = starts[i + 2:stop], ends[i + 2:stop]
+    overlapping_boxes = np.all(np.maximum(np.minimum(starts[i], ends[i]), np.minimum(a, b)) <=
+                               np.minimum(np.maximum(starts[i], ends[i]), np.maximum(a, b)) + 1e-9, axis=1)
+    side_a = cross(delta[i], a - starts[i])
+    side_b = cross(delta[i], b - starts[i])
+    other_a = cross(b - a, starts[i] - a)
+    other_b = cross(b - a, ends[i] - a)
+    if np.any(overlapping_boxes & (side_a * side_b <= 1e-12) & (other_a * other_b <= 1e-12)):
+      return False
+  return True
+
+
+@pytest.mark.parametrize('seed', range(40))
+def test_batched_predicates_match_random_and_boundary_cases(seed):
+  rng = np.random.default_rng(seed)
+  count = int(rng.integers(5, 200))
+  angles = np.sort(rng.uniform(0., 2 * math.pi, count))
+  for scale in (1e-4, 1., 1e4):
+    radius = rng.uniform(.2, 1., count)
+    polygon = scale * radius[:, None] * np.column_stack((np.cos(angles), np.sin(angles)))
+    if seed % 2:
+      rng.shuffle(polygon)
+    points = np.vstack((rng.uniform(-scale, scale, (513, 2)), polygon,
+                        (polygon + np.roll(polygon, -1, axis=0)) / 2,
+                        np.nextafter(polygon, np.inf), np.nextafter(polygon, -np.inf)))
+    assert np.array_equal(inside_polygon(points, polygon), reference_inside_polygon(points, polygon))
+    assert polygon_is_simple(polygon) == reference_polygon_is_simple(polygon)
+
+
+@pytest.mark.parametrize('gap', [-1e-8, -1e-9, -1e-12, 0., 1e-12, 1e-9, 1e-8])
+@pytest.mark.parametrize('offset', [0., 1e8])
+def test_touching_collinear_crossing_and_duplicate_edges(gap, offset):
+  shapes = [
+    [[0., 0.], [2., 2.], [0., 2.], [2., 0.]],
+    [[0., 0.], [2., 0.], [2., 2.], [1., gap], [0., 2.]],
+    [[0., 0.], [2., 0.], [1., gap], [3., 0.], [3., 2.], [0., 2.]],
+    [[0., 0.], [2., 0.], [2., gap], [2., 2.], [0., 2.]],
+  ]
+  for shape in shapes:
+    polygon = np.array(shape) + offset
+    points = np.vstack((polygon, np.nextafter(polygon, np.inf), np.nextafter(polygon, -np.inf)))
+    assert np.array_equal(inside_polygon(points, polygon), reference_inside_polygon(points, polygon))
+    assert polygon_is_simple(polygon) == reference_polygon_is_simple(polygon)
+
+
+def test_empty_points_and_horizontal_edges():
+  polygon = np.array([[0., 0.], [3., 0.], [3., 1.], [0., 1.]])
+  points = np.empty((0, 2))
+  assert np.array_equal(inside_polygon(points, polygon), reference_inside_polygon(points, polygon))
+  assert np.array_equal(inside_polygon(np.zeros((1, 2)), []), reference_inside_polygon(np.zeros((1, 2)), []))
+  assert polygon_is_simple(polygon) == reference_polygon_is_simple(polygon)
+  points = np.array([[1., 0.], [1., 1.], [3., .5], [0., .5], [1., np.nan], [np.inf, .5], [1., np.inf]])
+  with np.errstate(invalid='ignore'):
+    assert np.array_equal(inside_polygon(points, polygon), reference_inside_polygon(points, polygon))
