+from dataclasses import replace
+import math
+
+import numpy as np
+import pytest
+
+from openpilot.selfdrive.controls.lib.ev9_trajectory import EgoMotion, ExecutionState, TrajectoryMode, TrajectoryPlan, TrajectoryTracker
+
+
+def state(now=1., **kwargs):
+  return replace(ExecutionState(now, (0., 0., 0.), 2., 0., 0., 0., 0.3), **kwargs)
+
+
+def plan(now=1., **kwargs):
+  distance = np.linspace(0, 20, 401)
+  return replace(TrajectoryPlan(1, 0, now, now + 11., (0., 0., 0.), 2., 0., 0., -.05, .05,
+                                distance, np.column_stack((distance, np.zeros(len(distance)))),
+                                np.zeros(len(distance)), np.zeros(len(distance)), 1, True), **kwargs)
+
+
+def tick(tracker, current=None, proposal=None, **kwargs):
+  current = current or state()
+  return tracker.update(current, .031, mode=TrajectoryMode.ACTIVE, proposal=proposal, corridor_revision=1,
+                        corridor_valid_until=current.time + .2, **kwargs)
+
+
+@pytest.mark.parametrize('mode', [TrajectoryMode.OFF, TrajectoryMode.SHADOW])
+def test_observation_modes_return_exact_baseline(mode):
+  tracker = TrajectoryTracker()
+  decision = tracker.update(state(), -.123456789, mode=mode, proposal=plan(), corridor_revision=1, corridor_valid_until=1.2)
+  assert decision.curvature == -.123456789
+  assert not decision.active
+
+
+def test_adoption_and_fresh_corridor_lease_allow_complete_path():
+  tracker = TrajectoryTracker()
+  assert tick(tracker, proposal=plan()).active
+  # The original source can age while its remaining corridor is freshly checked.
+  decision = tick(tracker, state(4., pose=(6., 0., 0.)))
+  assert decision.active
+  assert decision.curvature == 0.
+  assert tick(tracker, state(11., pose=(20., 0., 0.))).reason == 'complete'
+
+
+@pytest.mark.parametrize('change,reason', [
+  ({'manual': True}, 'driver_or_baseline_ownership'),
+  ({'enabled': False}, 'driver_or_baseline_ownership'),
+  ({'lane_change': True}, 'driver_or_baseline_ownership'),
+  ({'drive': False}, 'driver_or_baseline_ownership'),
+  ({'healthy': False}, 'driver_or_baseline_ownership'),
+  ({'wheel_angle_deg': 200.}, 'unsupported_state'),
+  ({'speed': 0.}, 'standstill'),
+  ({'speed': 40 / 3.6 + 1e-6}, 'unsupported_state'),
+  ({'speed': 2.3}, 'speed_mismatch'),
+  ({'generation': 1}, 'state_or_frame_mismatch'),
+  ({'speed': float('nan')}, 'invalid_state'),
+])
+def test_cancel_reverts_to_baseline_and_cannot_resume_cached_plan(change, reason):
+  tracker = TrajectoryTracker()
+  original = plan()
+  assert tick(tracker, proposal=original).active
+  decision = tick(tracker, state(1.01, **change))
+  assert not decision.active and decision.reason == reason and decision.curvature == .031
+  assert not tick(tracker, state(1.02), proposal=original).active
+
+
+@pytest.mark.parametrize('change,reason', [
+  ({'execution_validated': False}, 'execution_not_validated'),
+  ({'frame': 'model_ego'}, 'state_or_frame_mismatch'),
+  ({'source_time': .5}, 'expired_plan'),
+  ({'source_time': 1.1}, 'expired_plan'),
+  ({'valid_until': .9}, 'expired_plan'),
+  ({'curvature': np.full(401, .06)}, 'invalid_capability'),
+  ({'yaw': np.zeros(2)}, 'invalid_plan'),
+  ({'xy': np.full((401, 2), np.nan)}, 'invalid_plan'),
+  ({'distance': np.zeros(401)}, 'invalid_plan'),
+  ({'origin': (1., 0., 0.)}, 'initial_state_mismatch'),
+  ({'initial_command_curvature': .02}, 'initial_state_mismatch'),
