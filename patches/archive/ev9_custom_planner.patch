+"""Independent sampled full-body and geometric trajectory checks."""
+
+import math
+import numpy as np
+from openpilot.tools.ev9_trajectory.fixtures import VM, FRONT, REAR, HALF_WIDTH
+
+
+def inside_polygon(points, polygon):
+  x, y = points.T
+  inside = np.zeros(len(points), dtype=bool)
+  for a, b in zip(polygon, np.roll(polygon, -1, axis=0), strict=True):
+    crossing = (a[1] > y) != (b[1] > y)
+    if a[1] != b[1]:
+      inside ^= crossing & (x < (b[0] - a[0]) * (y - a[1]) / (b[1] - a[1]) + a[0])
+  return inside
+
+
+def evaluate(case, xy, yaw):
+  xy = np.asarray(xy)
+  yaw = np.unwrap(np.asarray(yaw))
+  if len(xy) < 3 or xy.shape != (len(yaw), 2) or not np.isfinite(np.r_[xy.ravel(), yaw]).all():
+    return {'accepted': False, 'reason': 'invalid_trajectory'}
+  ds = np.linalg.norm(np.diff(xy, axis=0), axis=1)
+  if np.any(ds < 1e-6):
+    return {'accepted': False, 'reason': 'degenerate_trajectory'}
+  arc = np.r_[0, np.cumsum(ds)]
+  dense = np.linspace(0, arc[-1], int(arc[-1] / 0.05) + 2)
+  p = np.column_stack([np.interp(dense, arc, xy[:, i]) for i in (0, 1)])
+  h = np.interp(dense, arc, yaw)
+  # Uniform body grid includes all corners, edge points and interior; finite spatial sampling is explicit.
+  local = np.array([(x, y) for x in np.linspace(-REAR, FRONT, 12) for y in np.linspace(-HALF_WIDTH, HALF_WIDTH, 7)])
+  body = np.stack(
+    (
+      p[:, 0, None] + np.cos(h)[:, None] * local[:, 0] - np.sin(h)[:, None] * local[:, 1],
+      p[:, 1, None] + np.sin(h)[:, None] * local[:, 0] + np.cos(h)[:, None] * local[:, 1],
+    ),
+    axis=-1,
+  )
+  good = inside_polygon(body.reshape(-1, 2), case.polygon).reshape(len(dense), -1)
+  curvature = np.gradient(yaw, arc)
+  wheel = np.degrees([VM.get_steer_from_curvature(k, case.speed, 0.0) for k in curvature])
+  rate = np.abs(np.gradient(wheel, arc)) * case.speed
+  terminal_error = float(np.linalg.norm(xy[-1] - case.reference[-1]))
+  heading_error = abs(math.degrees(yaw[-1] - case.yaw[-1]))
+  initial_error = abs(math.degrees(yaw[0] - case.initial_pose[2]))
+  out = dict(
+    max_angle_deg=float(np.max(np.abs(wheel))),
+    max_angle_rate_deg_s=float(rate.max()),
+    terminal_position_error_m=terminal_error,
+    terminal_heading_error_deg=heading_error,
+    initial_heading_error_deg=initial_error,
+    body_violation_fraction=float(1 - good.mean()),
+    body_violation_station_count=int(np.count_nonzero(~good.all(axis=1))),
+    sample_spacing_m=float(np.max(np.diff(dense))),
+    full_heading_change_deg=float(math.degrees(yaw[-1] - yaw[0])),
+  )
+  tangent = np.unwrap(np.arctan2(np.gradient(xy[:, 1], arc), np.gradient(xy[:, 0], arc)))
+  out['max_tangent_error_deg'] = float(np.max(np.abs(np.degrees(tangent - yaw))))
+  out['terminal_curvature'] = float(curvature[-1])
+  out['initial_position_error_m'] = float(np.linalg.norm(xy[0] - case.initial_pose[:2]))
+  out['accepted'] = bool(
+    out['max_tangent_error_deg'] <= 1.0
+    and abs(curvature[-1]) <= 1e-3
+    and out['initial_position_error_m'] <= 0.02
+    and out['max_angle_deg'] <= 140.1
+    and out['max_angle_rate_deg_s'] <= 500.1
+    and terminal_error <= 0.2
+    and heading_error <= 1
+    and initial_error <= 0.1
+    and good.all()
+  )
+  return out
