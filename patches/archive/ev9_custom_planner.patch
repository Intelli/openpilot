+def test_model_opposing_bends_are_not_forced_into_one_steering_direction(native, sign):
+  arc = np.linspace(0., 80., 801)
+
+  def bend(start, end, angle):
+    phase = np.clip((arc - start) / (end - start), 0., 1.)
+    return VM.calc_curvature(math.radians(angle), 2., 0.) * np.sin(np.pi * phase)**2
+
+  xy, yaw = integrate(arc, sign * (bend(10., 35., 160.) - bend(42., 67., 100.)))
+  mount = MODEL_GEOMETRY.mount.vector()
+  rotated = np.column_stack((np.cos(yaw)*mount[0] - np.sin(yaw)*mount[1], np.sin(yaw)*mount[0] + np.cos(yaw)*mount[1]))
+  camera = xy + rotated - mount
+  model = dict(position=dict(x=camera[:, 0], y=-camera[:, 1], t=arc/2), orientation=dict(z=-yaw, t=arc/2))
+  result = run(native, model)
+  assert result.plan is not None, result.reason
+  angles = np.degrees([VM.get_steer_from_curvature(k, 2., 0.) for k in result.plan.curvature])
+  assert np.max(abs(angles)) <= 140.001
+  assert np.min(sign * angles) < -50.  # The model's second bend is still followed.
+  assert sign * (result.plan.yaw[-1] - result.plan.yaw[0]) > 0.
+  assert abs(result.plan.yaw[-1] - yaw[-1]) < math.radians(1.)
+
+
+def test_displacement_budget_uses_nearest_station_and_side():
+  from openpilot.selfdrive.controls.lib.ev9_path_planner import within_path_budget
+  reference = np.array([[0., 0.], [5., 0.], [10., 0.], [15., 0.]])
+  distance = reference[:, 0]
+  lower, upper = np.full(4, -1.), np.array([1., 2., 1., 1.])
+  assert within_path_budget(np.array([[5., 1.8]]), reference, distance, lower, upper)
+  assert not within_path_budget(np.array([[10., 1.8]]), reference, distance, lower, upper)
+  assert not within_path_budget(np.array([[5., -1.8]]), reference, distance, lower, upper)
+  assert within_path_budget(np.array([[10., .9]]), reference, distance, lower, upper)
+
+
+@pytest.mark.parametrize('speed', [0., .1, .4])
+def test_crawl_planning_uses_finite_conservative_slew(native, speed):
+  decision = run(native, visible_turn(20, 144), state(speed=speed))
+  assert decision.plan is not None, decision.reason
+  plan = decision.plan
+  assert plan.speed == speed
+  angles = np.array([math.degrees(VM.get_steer_from_curvature(k, speed, 0.)) for k in plan.curvature])
+  assert np.max(abs(angles)) <= 140.001
+  assert np.max(abs(np.diff(angles)/np.diff(plan.distance))) * speed <= 100.001
+
+
+@pytest.mark.parametrize('sign', [-1, 1])
+@pytest.mark.parametrize('demand', [170, 180])
+def test_observed_lane_room_recovers_turn_rejected_by_fixed_budget(native, sign, demand):
+  from openpilot.selfdrive.controls.lib.ev9_path_input import build_path_input
+  from openpilot.selfdrive.controls.lib.ev9_path_geometry import body_respects_observed
+  from openpilot.tools.ev9_trajectory.tests.test_rolling_model_path import distances
+  model = visible_turn(90, demand, sign)
+  result = run(native, model)
+  assert result.plan is not None, result.reason
+  geometry = build_path_input(model, MODEL_GEOMETRY, source_time=10., now=10., model_valid=True)
+  assert np.max(distances(result.plan.xy, geometry.xy)) > 1.
+  inflated = replace(MODEL_GEOMETRY, front=MODEL_GEOMETRY.front+.3, rear=MODEL_GEOMETRY.rear+.3, half_width=MODEL_GEOMETRY.half_width+.1)
+  assert body_respects_observed(result.plan.xy, result.plan.yaw, geometry, reference_distance=np.linspace(0., geometry.distance[-1], len(result.plan.xy)),
+                                front=inflated.front, rear=inflated.rear, half_width=inflated.half_width)
+  # Same apparent road width without reliable lane permission cannot enlarge
+  # the fallback budget. No edge-based permission to cross into another lane.
+  road_only = visible_turn(90, demand, sign, lane=False)
+  assert run(native, road_only).plan is None
+
+
+@pytest.mark.parametrize('sign', [-1, 1])
+def test_short_crawl_forecast_can_continue_full_authority(native, sign):
+  speed = .4
+  limit = VM.calc_curvature(math.radians(sign*140), speed, 0.)
+  curvature = VM.calc_curvature(math.radians(sign*160), speed, 0.)
+  distance = np.linspace(0., 3., 33)
+  xy, yaw = integrate(distance, np.full(len(distance), curvature))
+  camera = xy + np.column_stack((2*np.cos(yaw), 2*np.sin(yaw))) - [2., 0.]
+  model = dict(position=dict(x=camera[:, 0], y=-camera[:, 1], t=distance/speed), orientation=dict(z=-yaw, t=distance/speed))
+  current = state(speed=speed, wheel_angle_deg=sign*140., curvature=limit, command_curvature=limit, tracking_active=True)
+  result = run(native, model, current)
+  assert result.plan is not None, result.reason
+  assert 1. <= result.plan.distance[-1] < 10.
+  assert result.plan.rejection(current, 10.) == ''
