@@ -0,0 +1,68 @@
+"""Differential checks against the original unpruned edge-intersection test."""
+import math
+
+import numpy as np
+import pytest
+
+from openpilot.tools.ev9_trajectory.optimizer import VehicleFootprint, body_inside_corridor, inside_polygon
+
+
+def unpruned_body_inside(xy, yaw, footprint, polygon):
+  front, rear, width = footprint.front + footprint.margin, footprint.rear + footprint.margin, footprint.half_width + footprint.margin
+  local = np.array([[-rear, -width], [front, -width], [front, width], [-rear, width]])
+  c, s = np.cos(yaw)[:, None], np.sin(yaw)[:, None]
+  corners = np.stack((xy[:, 0, None] + c * local[:, 0] - s * local[:, 1],
+                      xy[:, 1, None] + s * local[:, 0] + c * local[:, 1]), axis=-1)
+  if not inside_polygon(corners.reshape(-1, 2), polygon).all():
+    return False
+  p, q = polygon, np.roll(polygon, -1, axis=0)
+
+  def cross(a, b):
+    return a[..., 0] * b[..., 1] - a[..., 1] * b[..., 0]
+
+  for start in range(0, len(corners), 64):
+    for edge in range(4):
+      a, b = corners[start:start + 64, edge, None, :], corners[start:start + 64, (edge + 1) % 4, None, :]
+      boxes = np.all(np.maximum(np.minimum(a, b), np.minimum(p, q)) <=
+                     np.minimum(np.maximum(a, b), np.maximum(p, q)) + 1e-9, axis=2)
+      if np.any(boxes & (cross(b - a, p - a) * cross(b - a, q - a) <= 1e-12) &
+                (cross(q - p, a - p) * cross(q - p, b - p) <= 1e-12)):
+        return False
+  return True
+
+
+@pytest.mark.parametrize('seed', range(20))
+def test_pruning_matches_unpruned_random_convex_and_concave_polygons(seed):
+  rng = np.random.default_rng(seed)
+  for concave in (False, True):
+    angles = np.sort(rng.uniform(0, 2 * math.pi, 100))
+    radius = rng.uniform(3, 10, len(angles)) if concave else np.full(len(angles), 10.)
+    polygon = radius[:, None] * np.column_stack((np.cos(angles), np.sin(angles)))
+    for offset in (0., 1., 4., 10.):
+      xy = rng.uniform(-offset, offset, (129, 2))
+      yaw = rng.uniform(-math.pi, math.pi, len(xy))
+      footprint = VehicleFootprint(front=rng.uniform(0.1, 3), rear=rng.uniform(0.1, 3), half_width=rng.uniform(0.1, 2), margin=0.08)
+      assert body_inside_corridor(xy, yaw, footprint, polygon) == unpruned_body_inside(xy, yaw, footprint, polygon)
+
+
+@pytest.mark.parametrize('gap', [-1e-8, -1e-9, -1e-12, 0., 1e-12, 1e-9, 1e-8])
+@pytest.mark.parametrize('rotation', [0., 0.3, math.pi / 2])
+def test_concave_notch_touching_and_tolerance_match(gap, rotation):
+  # All four corners are inside. The notch can touch/cross the top body edge.
+  polygon = np.array([[-3., -3.], [3., -3.], [3., 3.], [.2, 3.], [.2, 1. + gap], [-.2, 1. + gap], [-.2, 3.], [-3., 3.]])
+  transform = np.array([[math.cos(rotation), -math.sin(rotation)], [math.sin(rotation), math.cos(rotation)]])
+  polygon = polygon @ transform.T
+  xy, yaw = np.zeros((1, 2)), np.array([rotation])
+  footprint = VehicleFootprint(front=1., rear=1., half_width=1., margin=0.)
+  assert body_inside_corridor(xy, yaw, footprint, polygon) == unpruned_body_inside(xy, yaw, footprint, polygon)
+
+
+def test_final_partial_block_and_far_polygon_edges():
+  polygon = np.array([[-5., -5.], [5., -5.], [5., 5.], [.2, 5.], [.2, .9], [-.2, .9], [-.2, 5.], [-5., 5.]])
+  footprint = VehicleFootprint(front=1., rear=1., half_width=1., margin=0.)
+  xy = np.tile([0., -2.], (129, 1))
+  yaw = np.zeros(len(xy))
+  assert body_inside_corridor(xy, yaw, footprint, polygon)
+  xy[-1] = [0., 0.]
+  assert not body_inside_corridor(xy, yaw, footprint, polygon)
+  assert not unpruned_body_inside(xy, yaw, footprint, polygon)
