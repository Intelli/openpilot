diff --git a/tools/ev9_trajectory/tests/test_rolling_model_path.py b/tools/ev9_trajectory/tests/test_rolling_model_path.py
new file mode 100644
index 0000000000000000000000000000000000000000..5b99d9e95f7e1ecf61685e290d061daf7e1f51fb
--- /dev/null
+++ b/tools/ev9_trajectory/tests/test_rolling_model_path.py
@@ -0,0 +1,178 @@
+"""Finite-horizon replanning must remain useful through a complete physical turn."""
+import math
+import os
+from dataclasses import replace
+
+import numpy as np
+import pytest
+
+from openpilot.selfdrive.controls.lib.ev9_path_input import build_path_input
+from openpilot.selfdrive.controls.lib.ev9_path_mpc import Ev9PathMpc
+from openpilot.selfdrive.controls.lib.ev9_path_planner import MODEL_GEOMETRY, ModelPathPlanner
+from openpilot.selfdrive.controls.lib.ev9_trajectory import TrajectoryTracker, path_turn_direction
+from openpilot.tools.ev9_trajectory.benchmark import Plant
+from openpilot.tools.ev9_trajectory.fixtures import Case, VM
+from openpilot.tools.ev9_trajectory.live_benchmark import ReferenceBaseline, execution_state, plant_case
+from openpilot.tools.ev9_trajectory.optimizer import VehicleFootprint, body_inside_corridor
+from openpilot.tools.ev9_trajectory.tests.test_model_path_planner import visible_turn
+
+
+EXIT_HEADING_TOLERANCE = math.radians(3.)  # Exit scoring; runtime steering/boundary limits are unchanged.
+
+
+@pytest.fixture(scope='module')
+def library(tmp_path_factory):
+  path = os.environ.get('EV9_PATH_MPC_LIBRARY')
+  if path is None:
+    from openpilot.selfdrive.controls.lib.ev9_path_mpc_lib.generate import build
+    path = build(tmp_path_factory.mktemp('rolling-model-mpc'))
+  return path
+
+
+def distances(points, reference):
+  segment = np.diff(reference, axis=0)
+  relative = points[:, None, :] - reference[None, :-1, :]
+  fraction = np.clip(np.sum(relative * segment, axis=2) / np.sum(segment**2, axis=1), 0., 1.)
+  return np.linalg.norm(relative - fraction[:, :, None] * segment, axis=2).min(axis=1)
+
+
+def recapture(case, pose, speed):
+  # Project the actual vehicle onto the reference, then expose only ten seconds
+  # at 33 model-like time stations. The unseen exit is never passed to planning.
+  segment = np.diff(case.reference, axis=0)
+  fraction = np.clip(np.sum((pose[:2] - case.reference[:-1]) * segment, axis=1) / np.sum(segment**2, axis=1), 0., 1.)
+  nearest = np.argmin(np.linalg.norm(case.reference[:-1] + fraction[:, None] * segment - pose[:2], axis=1))
+  start = case.arc[nearest] + fraction[nearest] * (case.arc[nearest+1] - case.arc[nearest])
+  station = start + (min(start + 10 * speed, case.arc[-1]) - start) * np.linspace(0., 1., 33)**2
+  c, s = np.cos(pose[2]), np.sin(pose[2])
+  xy = (np.column_stack([np.interp(station, case.arc, v) for v in case.reference.T]) - pose[:2]) @ [[c, -s], [s, c]]
+  yaw = np.interp(station, case.arc, case.yaw) - pose[2]
+  mount = MODEL_GEOMETRY.mount.vector()
+  camera = xy + np.column_stack((np.cos(yaw)*mount[0]-np.sin(yaw)*mount[1], np.sin(yaw)*mount[0]+np.cos(yaw)*mount[1])) - mount
+  t = (station-start) / speed
+  return dict(position=dict(x=camera[:, 0], y=-camera[:, 1], t=t), orientation=dict(z=-yaw, t=t)), xy, yaw
+
+
+def observed_boundaries(case, pose):
+  c, s = np.cos(pose[2]), np.sin(pose[2])
+  mount = MODEL_GEOMETRY.mount.vector()
+  def line(points):
+    local = (points - pose[:2]) @ [[c, -s], [s, c]]
+    visible = np.flatnonzero(local[:, 0] >= mount[0])
+    if len(visible) < 2:
+      return dict(x=[], y=[])
+    local = local[visible[0]:visible[-1]+1]
+    arc = np.r_[0., np.cumsum(np.linalg.norm(np.diff(local, axis=0), axis=1))]
+    sample = np.linspace(0., arc[-1], 33)
+    camera = np.column_stack([np.interp(sample, arc, v) for v in local.T]) - mount
+    return dict(x=camera[:, 0], y=-camera[:, 1])
+  left, right = line(case.left), line(case.right)
+  return dict(laneLines=[left, left, right, right], laneLineProbs=[.9] * 4, laneLineStds=[.01] * 4,
+              roadEdges=[left, right], roadEdgeStds=[.01] * 2)
+
+
+def execute(case, library, enabled, observed=False):
+  reflected = plant_case(case)
+  plant = Plant(dict(delay=.1, limit_speed_mps=40/3.6), case.speed)
+  baseline, tracker = ReferenceBaseline(reflected, .1), TrajectoryTracker()
+  # Deterministic one-cycle delivery isolates the rolling geometry/ownership
+  # regression. Wall-clock solve deadlines have separate integration tests.
+  planner = ModelPathPlanner(solver=Ev9PathMpc(library), clock=lambda: 0.)
+  active, pending, lease, direction = False, None, None, 0
+  poses, owned, progress = [], [], []
+  proposal_deviation, adoptions, plan_id = 0., 0, -1
+  try:
+    for step in range(math.ceil((case.arc[-1]+20) / case.speed / .01)):
+      now = step * .01
+      state = replace(execution_state(plant, now, .375), tracking_active=active)
+      command = baseline.update(plant.pose, step)
+      proposal, revoke = None, False
+      if pending is not None:
+        decision, pending = pending, None
+        proposal = lease = decision.plan
+        # Numerical/bounds failures cannot renew or cancel an incumbent lease.
+        # This fixture has no boundary/state changes; only completion revokes.
+        revoke = decision.reason == 'tracking_complete'
+      if enabled and step % 5 == 0:
+        model, reference, yaw = recapture(case, np.asarray(state.pose), case.speed)
+        model['action'] = dict(desiredCurvature=command)
+        if observed:
+          model.update(observed_boundaries(case, np.asarray(state.pose)))
+        direction = path_turn_direction(yaw)
+        pending = planner.update(model, state, VM, model_time=now, model_pose=state.pose, now=now,
+                                 mode=2, model_valid=True, roll=0., angle_offset_deg=0.)
+        if pending.plan is not None:
+          proposal_deviation = max(proposal_deviation, float(distances(pending.plan.xy, reference).max()))
+      if enabled:
+        selected = tracker.update(state, command, mode=2, proposal=proposal, revoke=revoke, model_turn_direction=direction,
+                                  corridor_revision=lease.corridor_revision if lease else 0,
+                                  corridor_valid_until=lease.valid_until if lease else 0.)
+        command, active = selected.curvature, selected.active
+        if active and selected.plan_id != plan_id:
+          adoptions += 1
+          plan_id = selected.plan_id
+      plant.step(command)
+      poses.append(plant.pose.copy() * [1., -1., -1.])
+      owned.append(active)
+      progress.append(baseline.nearest)
+      tangent = [np.cos(reflected.yaw[-1]), np.sin(reflected.yaw[-1])]
+      if (plant.pose[:2] - reflected.reference[-1]) @ tangent >= 0 and baseline.nearest > len(case.reference)*.8:
+        break
+    else:
+      pytest.fail('did not complete the full turn and exit')
+  finally:
+    planner.close()
+  poses = np.asarray(poses)
+  footprint = VehicleFootprint(MODEL_GEOMETRY.front, MODEL_GEOMETRY.rear, MODEL_GEOMETRY.half_width, MODEL_GEOMETRY.margin)
+  return dict(peak=float(distances(poses[:, :2], case.reference).max()), body=body_inside_corridor(poses[:, :2], poses[:, 2], footprint, case.polygon),
+              exit=float(np.linalg.norm(poses[-1, :2]-case.reference[-1])), heading=abs(poses[-1, 2]-case.yaw[-1]), wheel=plant.maxangle,
+              proposal_deviation=proposal_deviation, adoptions=adoptions, owned=np.asarray(owned), progress=np.asarray(progress))
+
+
+@pytest.mark.parametrize('sign', [-1, 1])
+@pytest.mark.parametrize('speed_kph', [10, 20])
+def test_finite_horizon_continues_140_degree_turn(library, sign, speed_kph):
+  geometry = build_path_input(visible_turn(90, 160, sign), MODEL_GEOMETRY, source_time=0., now=0., model_valid=True)
+  left, right = np.vstack(([-6., 3.5], geometry.left)), np.vstack(([-6., -3.5], geometry.right))
+  case = Case('finite160', geometry.xy, geometry.yaw, geometry.distance, left, right, np.vstack((left, right[::-1])),
+              speed_kph/3.6, np.zeros(3), 'synthetic')
+  baseline, candidate = execute(case, library, False), execute(case, library, True)
+  assert candidate['peak'] < 1. and candidate['peak'] < baseline['peak'] - .5
+  assert candidate['body'] and candidate['exit'] < .2 and candidate['heading'] < EXIT_HEADING_TOLERANCE
+  assert candidate['proposal_deviation'] <= 1.00001 and candidate['wheel'] <= 140.00001
+  assert candidate['adoptions'] > 1
+  # Geometric bend interval, not a fitted time/index window: no ownership loss
+  # while traversing the central turn, including iteration-limited refreshes.
+  heading = abs(case.yaw[candidate['progress']])
+  bend = (heading > math.radians(10)) & (heading < math.radians(80))
+  assert bend.any() and candidate['owned'][bend].all()
+
+
+@pytest.mark.parametrize('demand', [144, 160])
+def test_high_speed_unachievable_turn_does_not_worsen_baseline(library, demand):
+  geometry = build_path_input(visible_turn(90, demand), MODEL_GEOMETRY, source_time=0., now=0., model_valid=True)
+  left, right = np.vstack(([-6., 3.5], geometry.left)), np.vstack(([-6., -3.5], geometry.right))
+  case = Case('high-speed-sharp-turn', geometry.xy, geometry.yaw, geometry.distance, left, right, np.vstack((left, right[::-1])),
+              40/3.6, np.zeros(3), 'synthetic')
+  baseline, candidate = execute(case, library, False), execute(case, library, True)
+  # Existing lateral-acceleration limits make these deliberately sharp turns
+  # unachievable at this speed. A 140-degree-only plan must not take ownership.
+  assert candidate['adoptions'] == 0
+  assert candidate['peak'] == pytest.approx(baseline['peak'], abs=1e-8)
+  assert candidate['wheel'] <= 140.00001
+
+
+@pytest.mark.parametrize('sign', [-1, 1])
+@pytest.mark.parametrize('demand', [170, 180])
+def test_observed_lane_budget_completes_wider_turn(library, sign, demand):
+  geometry = build_path_input(visible_turn(90, demand, sign), MODEL_GEOMETRY, source_time=0., now=0., model_valid=True)
+  left, right = np.vstack(([-6., 3.5], geometry.left)), np.vstack(([-6., -3.5], geometry.right))
+  case = Case('observed-wider-turn', geometry.xy, geometry.yaw, geometry.distance, left, right, np.vstack((left, right[::-1])),
+              10/3.6, np.zeros(3), 'synthetic')
+  candidate = execute(case, library, True, observed=True)
+  assert candidate['body'] and candidate['exit'] < .2 and candidate['heading'] < EXIT_HEADING_TOLERANCE
+  assert candidate['wheel'] <= 140.00001 and candidate['adoptions'] > 1
+  assert candidate['proposal_deviation'] > 1.0  # Requires the observed lane's additional room.
+  # Executed error must stay within the plan's adjustment plus the tracker's
+  # existing position-error limit, not wander across the available lane.
+  assert candidate['peak'] <= candidate['proposal_deviation'] + .30
