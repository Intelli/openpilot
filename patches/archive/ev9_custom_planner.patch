+def test_coordinate_transform_and_feedback_sign():
+  current = state(pose=(10., 5.1, math.pi / 2))
+  p = plan(origin=(10., 5., math.pi / 2))
+  decision = tick(TrajectoryTracker(), current, p)
+  assert decision.active and abs(decision.curvature) < 1e-12
+  # Left of a left-positive reference calls for a right-positive control correction.
+  current = state(pose=(0., .1, 0.))
+  decision = tick(TrajectoryTracker(), current, plan())
+  assert decision.active and decision.curvature == pytest.approx(.008)
