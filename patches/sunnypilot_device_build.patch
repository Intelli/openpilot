+lenv = env.Clone()
+bundled_ffmpeg = []
+if arch == 'comma_arm64' and os.environ.get('SP_TICI_SYSROOT'):
+  # Frozen FFmpeg wheels use $ORIGIN for their own shared-library dependencies.
