+  @staticmethod
+  def _paced_wall_target(sign: int, measured_offset_m: float) -> float:
+    wall_mag = abs(measured_offset_m) * CENTERING_PACE_WALL_SCALE
+    wall_mag = max(CENTERING_PACE_WALL_MIN_M, min(CENTERING_PACE_WALL_MAX_M, wall_mag))
