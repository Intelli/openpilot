+  @staticmethod
+  def _edge_std_average(stds) -> float | None:
+    if len(stds) == 0:
+      return None
+    total = 0.0
+    count = 0
+    for value in stds:
+      if not isinstance(value, (int, float)):
+        continue
+      total += float(value)
+      count += 1
+      if count >= CENTERING_EDGE_STD_SAMPLES:
+        break
+    if count == 0:
+      return None
+    return total / count
