+def setup_lfs(cwd: str) -> bool:
+  """Configure Git LFS for the repository.
+
+  Returns True if LFS commands should be attempted later.
+  """
+  try:
+    run(["git", "lfs", "install", "--local"], cwd)
+    run(["git", "config", "lfs.url", "https://gitlab.com/sunnypilot/public/sunnypilot-new-lfs.git/info/lfs"], cwd)
+    run(["git", "config", "lfs.https://gitlab.com/sunnypilot/public/sunnypilot-new-lfs.git.locksverify", "false"], cwd)
+    run(["git", "config", "lfs.fetchrecentrefsdays", "3650"], cwd)
+    run(["git", "config", "lfs.fetchrecentcommitsdays", "3650"], cwd)
+    cloudlog.info("LFS configured successfully")
+    return True
+  except subprocess.CalledProcessError as e:
+    cloudlog.warning("LFS setup failed, continuing without LFS: %s", e.output)
+  except Exception as e:
+    cloudlog.warning("LFS setup failed with unexpected error: %s", str(e))
+  return False
+
+def pull_lfs_with_override(cwd: str, url: str, ref: str) -> bool:
+  try:
+    run(["git", "-c", f"lfs.url={url}", "-c", "lfs.locksverify=false", "lfs", "pull", "origin", ref], cwd, timeout=300)
+    return True
+  except subprocess.CalledProcessError as err:
+    cloudlog.warning("LFS pull failed for %s: %s", url, err.output)
+  except subprocess.TimeoutExpired as err:
+    cloudlog.warning("LFS pull timed out for %s: %s", url, str(err))
+  return False
+
+def robust_git_fetch(cwd: str, branch: str) -> str:
+  """Perform a git fetch with optional LFS support"""
+
+  lfs_ready = setup_lfs(cwd)
+
+  # Perform git fetch with timeout
+  try:
+    output = run(["git", "fetch", "--progress", "origin", branch], cwd, timeout=600)  # 10 minute timeout
+    cloudlog.info("Git fetch successful: %s", output)
+
+    # Try to pull LFS objects after successful fetch
+    if lfs_ready:
+      fallback_needed = False
+      try:
+        run(["git", "lfs", "pull"], cwd, timeout=300)  # 5 minute timeout for LFS
+        cloudlog.info("LFS pull successful")
+      except subprocess.CalledProcessError as lfs_error:
+        cloudlog.warning("LFS pull failed, continuing without LFS objects: %s", lfs_error.output)
+        fallback_needed = True
+      except subprocess.TimeoutExpired:
+        cloudlog.warning("LFS pull timed out, continuing without LFS objects")
+        fallback_needed = True
+
+      if fallback_needed:
+        if pull_lfs_with_override(cwd, GITHUB_LFS_URL, GITHUB_LFS_BRANCH):
+          cloudlog.info("GitHub LFS fallback pull successful")
+        else:
+          cloudlog.warning("GitHub LFS fallback pull failed")
+
+    return output
+
+  except subprocess.TimeoutExpired:
+    cloudlog.error("Git fetch timed out after 10 minutes")
+    raise
+  except subprocess.CalledProcessError as e:
+    cloudlog.error("Git fetch failed: %s", e.output)
+    raise
+
